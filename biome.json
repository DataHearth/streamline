{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": [
			"web/app/**/*.ts",
			"web/app/**/*.svelte",
			"web/static/js/**/*.js",
			"web/static/css/**/*.css",
			"!web/static/js/bundle.min.js",
			"!web/static/js/docs.min.js",
			"!web/static/css/style.css",
			"!web/static/css/docs.min.css",
			"package.json",
			"biome.json"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": {
				"noImportantStyles": "off"
			},
			"a11y": {
				"noLabelWithoutControl": {
					"level": "error",
					"options": { "inputComponents": ["ScoreInput", "Select"] }
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"css": {
		"parser": { "tailwindDirectives": true },
		"formatter": { "enabled": true },
		"linter": { "enabled": true }
	},
	"html": {
		"experimentalFullSupportEnabled": true
	},
	"overrides": [
		{
			"includes": ["web/app/**"],
			"formatter": { "enabled": false }
		}
	]
}
