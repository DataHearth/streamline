  "settings": [
    {
      "name": "username",
      "label": "Username",
      "type": "text"
    },
    {
      "name": "password",
      "label": "Password",
      "type": "password",
      "secret": true
    },
    {
      "name": "freeleech",
      "label": "Search freeleech only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "sort",
      "label": "Sort requested from site",
      "type": "select",
      "default": "4",
      "options": {
        "4": "created",
        "7": "seeders",
        "5": "size",
        "1": "title"
      }
    },
    {
      "name": "type",
      "label": "Order requested from site",
      "type": "select",
      "default": "desc",
      "options": {
        "desc": "desc",
        "asc": "asc"
      }
    },
    {
      "name": "info_tpp",
      "label": "Results Per Page",
      "type": "info",
      "default": "For best results, change the <b>每页种子数:每页显示</b><i>(Torrents per page:)</i> setting to <b>100</b> on your account profile."
    },
    {
      "name": "info_activity",
      "label": "Account Inactivity",
      "type": "info",
      "default": "Account retention rules:<ol><li>Veteran User and above will be retained forever</li><li>Elite User and above will not have their account deleted after parking (in the control panel)</li><li>Users with a parked account will be deleted if they do not log in for 240 consecutive days</li><li>Users with a non-parked account will be deleted if they do not log in for 120 consecutive days</li><li>Users who have no traffic (i.e. upload/download data are both 0) will be deleted if they do not log in for 30 consecutive days.</li></ol>"
    }
  ],
  "login": {
    "method": "form",
    "path": "login.php",
    "form": "form[action=\"takelogin.php\"]",
    "inputs": {
      "username": "{{ .Config.username }}",
      "password": "{{ .Config.password }}",
      "checkcode": "XxXx",
      "logout": ""
    },
    "error": [
      {
        "selector": "td.embedded:has(h2:contains(\"失败\"))"
      }
    ],
    "test": {
      "path": "index.php",
      "selector": "a[href^=\"logout.php?hash=\"]"
    }
  },
  "search": {
    "paths": [
      {
        "path": "torrents.php"
      }
    ],
    "inputs": {
      "$raw": "{{ range .Categories }}cat{{.}}=1&{{end}}",
      "search": "{{ if .Query.IMDBID }}{{ .Query.IMDBID }}{{ else }}{{ end }}{{ if and .Query.DoubanID (eq .Query.IMDBID .False) }}{{ .Query.DoubanID }}{{ else }}{{ end }}{{ if and (eq .Query.IMDBID .False) (eq .Query.DoubanID .False) }}{{ .Keywords }}{{ else }}{{ end }}",
      "incldead": "0",
      "spstate": "{{ if .Config.freeleech }}2{{ else }}0{{ end }}",
      "picktype": "0",
      "search_area": "{{ if .Query.IMDBID }}4{{ else }}{{ end }}{{ if and .Query.DoubanID (eq .Query.IMDBID .False) }}1{{ else }}{{ end }}{{ if and (eq .Query.IMDBID .False) (eq .Query.DoubanID .False) }}0{{ else }}{{ end }}",
      "search_mode": "0",
      "sort": "{{ .Config.sort }}",
      "type": "{{ .Config.type }}",
      "notnewword": "1"
    },
    "rows": {
      "selector": "table.torrents > tbody > tr:has(table.torrentname)"
    },
    "fields": {
      "category": {
        "selector": "a[href^=\"?cat=\"]",
        "attribute": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "cat"
            ]
          }
        ]
      },
      "title_default": {
        "selector": "a[href^=\"details.php?id=\"]"
      },
      "title": {
        "selector": "a[title][href^=\"details.php?id=\"]",
        "attribute": "title",
        "optional": true,
        "default": "{{ .Result.title_default }}"
      },
      "details": {
        "selector": "a[href^=\"details.php?id=\"]",
        "attribute": "href"
      },
      "download": {
        "selector": "a[href^=\"download.php?id=\"]",
        "attribute": "href"
      },
      "date_elapsed": {
        "selector": "td:nth-child(4):not(:contains(\"-\"))",
        "optional": true,
        "filters": [
          {
            "name": "replace",
            "args": [
              "年",
              "years"
            ]
          },
          {
            "name": "replace",
            "args": [
              "月",
              "months"
            ]
          },
          {
            "name": "replace",
            "args": [
              "天",
              "days"
            ]
          },
          {
            "name": "replace",
            "args": [
              "时",
              " hours"
            ]
          },
          {
            "name": "replace",
            "args": [
              "分",
              "minutes"
            ]
          },
          {
            "name": "append",
            "args": [
              " ago"
            ]
          },
          {
            "name": "timeago"
          }
        ]
      },
      "date_added": {
        "selector": "td:nth-child(4):contains(\"-\")",
        "optional": true,
        "filters": [
          {
            "name": "append",
            "args": [
              " +08:00"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "2006-01-0215:04:05 -07:00"
            ]
          }
        ]
      },
      "date": {
        "text": "{{ if or .Result.date_elapsed .Result.date_added }}{{ or .Result.date_elapsed .Result.date_added }}{{ else }}now{{ end }}"
      },
      "size": {
        "selector": "td:nth-child(5)"
      },
      "seeders": {
        "selector": "td:nth-child(6)"
      },
      "leechers": {
        "selector": "td:nth-child(7)"
      },
      "grabs": {
        "selector": "td:nth-child(8)"
      },
      "downloadvolumefactor": {
        "case": {
          "img.pro_free": "0",
          "img.pro_2up": "0",
          "img.pro_free2up": "0",
          "img.pro_50pctdown": "0.5",
          "img.pro_30pctdown": "0.3",
          "img.pro_70pctdown": "0.7",
          "*": "1"
        }
      },
      "uploadvolumefactor": {
        "case": {
          "img.pro_2up": "2",
          "img.pro_free2up": "2",
          "*": "1"
        }
      },
      "minimumratio": {
        "text": "0.7"
      },
      "description": {
        "selector": "td:nth-child(2)",
        "remove": "a, b, font, img, span"
      }
    }
  },
  "source": {
