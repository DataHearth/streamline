  },
  "settings": [
    {
      "name": "apikey",
      "label": "API Key",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_key",
      "label": "About your API Key",
      "type": "info",
      "default": "You can find your API Key by accessing your <a href=\"https://stellarwinds.me/profile.php#security\" target=\"_blank\">Stellarwinds account profile</a> page and scrolling down to the <b>Auth Key</b> section."
    },
    {
      "name": "info_activity",
      "label": "Account Inactivity",
      "type": "info",
      "default": "Account retention:<ol><li>6 months since your last login → your account is automatically disabled (contact staff to reactivate).</li><li>12 months since your last login → your account is automatically banned.</li></ol>"
    }
  ],
  "login": {
    "method": "get",
    "path": "torznab.php",
    "inputs": {
      "apikey": "{{ .Config.apikey }}",
      "t": "search",
      "limit": "1"
    }
  },
  "search": {
    "paths": [
      {
        "path": "torznab.php",
        "response": {
          "type": "xml"
        }
      }
    ],
    "inputs": {
      "apikey": "{{ .Config.apikey }}",
      "t": "{{ .Query.Type }}",
      "q": "{{ .Keywords }}",
      "cat": "{{ join .Categories \",\" }}",
      "limit": "100"
    },
    "keywordsfilters": [
      {
        "name": "re_replace",
        "args": [
          "\\W+",
          "\\."
        ]
      }
    ],
    "rows": {
      "selector": "rss > channel > item"
    },
    "fields": {
      "category": {
        "selector": "[name=category]",
        "attribute": "value"
      },
      "title": {
        "selector": "title",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "^\\[.*\\] ",
              ""
            ]
          }
        ]
      },
      "details": {
        "selector": "comments"
      },
      "download": {
        "selector": "enclosure",
        "attribute": "url"
      },
      "date": {
        "selector": "pubDate",
        "filters": [
          {
            "name": "dateparse",
            "args": [
              "Mon, 02 Jan 2006 15:04:05 -07:00"
            ]
          }
        ]
      },
      "size": {
        "selector": "[name=size]",
        "attribute": "value"
      },
      "infohash": {
        "selector": "[name=infohash]",
        "attribute": "value"
      },
      "seeders": {
        "selector": "[name=seeders]",
        "attribute": "value"
      },
      "leechers": {
        "selector": "[name=peers]",
        "attribute": "value"
      },
      "grabs": {
        "selector": "[name=grabs]",
        "attribute": "value"
      },
      "downloadvolumefactor": {
        "text": "1"
      },
      "uploadvolumefactor": {
        "text": "1"
      }
    }
  },
  "source": {
    "path": "definitions/v11/stellarwinds.yml",
