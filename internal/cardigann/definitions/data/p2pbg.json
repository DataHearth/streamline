  "settings": [
    {
      "name": "username",
      "label": "Username",
      "type": "text"
    },
    {
      "name": "password",
      "label": "Password",
      "type": "password",
      "secret": true
    },
    {
      "name": "info_magnets",
      "label": "About Magnets",
      "type": "info",
      "default": "IF you do not see Magnets in the results then this means that you are not a <b>Super User</b> or <b>VIP</b>.<br />You will need to visit the <a href=\"https://www.p2pbg.com/marketplace\" target=\"_blank\">MarketPlace</a>."
    },
    {
      "name": "info_results",
      "label": "Search results",
      "type": "info",
      "default": "Only the <b>Base</b> style is supported with this indexer.<br />For best results, change the <b>Torrents per page:</b> setting to <b>100</b> on your account profile."
    },
    {
      "name": "sort",
      "label": "Sort requested from site",
      "type": "select",
      "default": "data",
      "options": {
        "data": "created",
        "size": "size"
      }
    },
    {
      "name": "type",
      "label": "Order requested from site",
      "type": "select",
      "default": "DESC",
      "options": {
        "DESC": "desc",
        "ASC": "asc"
      }
    }
  ],
  "login": {
    "method": "form",
    "path": "login",
    "form": "form.auth-form",
    "inputs": {
      "uid": "{{ .Config.username }}",
      "pwd": "{{ .Config.password }}",
      "remember": "1"
    },
    "error": [
      {
        "selector": "div.auth-notice:contains(\"Incorrect\")"
      }
    ],
    "test": {
      "path": "/",
      "selector": "form[action$=\"logout\"]"
    }
  },
  "search": {
    "paths": [
      {
        "path": "torrents"
      }
    ],
    "allowEmptyInputs": true,
    "inputs": {
      "category": "{{ if .Categories }}{{ range .Categories }}{{.}};{{end}}{{ else }}0{{ end }}",
      "fakeusernameremembered": "",
      "fakepasswordremembered": "",
      "search": "{{ if .Keywords }}{{ .Keywords }}{{ else }}{{ end }}",
      "active": "0",
      "order": "{{ .Config.sort }}",
      "by": "{{ .Config.type }}"
    },
    "rows": {
      "selector": "table.torrent-index__table:not(table.torrent-index__table--recommended) > tbody > tr.torrent-index__row"
    },
    "fields": {
      "category": {
        "selector": "a[href*=\"category=\"]",
        "attribute": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "category"
            ]
          }
        ]
      },
      "title": {
        "selector": "td:nth-child(2) a"
      },
      "title_download": {
        "text": "{{ .Result.title }}",
        "filters": [
          {
            "name": "urlencode"
          }
        ]
      },
      "infohash": {
        "selector": "td:nth-child(2) a",
        "attribute": "onclick",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "([A-F|a-f|0-9]{40})"
            ]
          }
        ]
      },
      "details": {
        "text": "torrents/{{ .Result.infohash }}"
      },
      "download": {
        "text": "download.php?id={{ .Result.infohash }}&f={{ .Result.title_download }}.torrent"
      },
      "magnet": {
        "selector": "a[href^=\"magnet:?xt=\"]",
        "attribute": "href",
        "optional": true
      },
      "poster": {
        "selector": "a:has(img[src*=\"/torrentimg/pic\"])",
        "attribute": "data-overlib",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "src=\\\"(.*?)\\\""
            ]
          }
        ]
      },
      "date_day": {
        "selector": "td:nth-last-child(5):not(:contains(\"/\"))",
        "optional": true,
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "(?i)сейчас|Сега",
              "now"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)сегодня|Днес",
              "Today"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)вчера|Вчера",
              "Yesterday"
            ]
          }
        ]
      },
      "date_year": {
        "selector": "td:nth-last-child(5):contains(\"/\")",
        "optional": true,
        "filters": [
          {
            "name": "dateparse",
            "args": [
              "02/01/2006"
            ]
          }
        ]
      },
      "date": {
        "text": "{{ if or .Result.date_day .Result.date_year }}{{ or .Result.date_day .Result.date_year }}{{ else }}now{{ end }}"
      },
      "size": {
        "selector": "td:nth-last-child(4)"
      },
      "seeders": {
        "selector": "td:nth-last-child(3)"
      },
      "leechers": {
        "selector": "td:nth-last-child(2)"
      },
      "grabs": {
        "selector": "td:nth-last-child(1)"
      },
      "downloadvolumefactor": {
        "text": "1"
      },
      "uploadvolumefactor": {
        "text": "1"
      },
      "minimumratio": {
        "text": "1.0"
      },
      "minimumseedtime": {
        "text": "259200"
      }
    }
  },
