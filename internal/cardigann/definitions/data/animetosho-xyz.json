{
  "id": "animetosho-xyz",
  "name": "Anime Tosho",
  "description": "Anime Tosho is a Public Torrent Tracker for ANIME",
  "language": "en-US",
  "type": "public",
  "encoding": "UTF-8",
  "links": [
    "https://animetosho.net/"
  ],
  "legacylinks": [
    "https://animetosho.xyz/"
  ],
  "caps": {
    "categorymappings": [
      {
        "id": "Anime",
        "cat": "TV/Anime",
        "desc": "Anime"
      }
    ],
    "modes": {
      "search": [
        "q"
      ],
      "tv-search": [
        "q",
        "season",
        "ep"
      ],
      "movie-search": [
        "q"
      ]
    }
  },
  "settings": [
    {
      "name": "api-url",
      "label": "API-URL",
      "type": "text",
      "default": "feed.animetosho.net"
    },
    {
      "name": "sonarr_compatibility",
      "label": "Improve Sonarr compatibility by trying to add Season information into Release Titles",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "strip_s01",
      "label": "Remove first season keywords (S1/S01/Season 1), as some results do not include this for first/single season releases",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "radarr_compatibility",
      "label": "Improve Radarr compatibility by removing year information from keywords and adding it to Release Titles",
      "type": "checkbox",
      "default": "false"
    }
  ],
  "search": {
    "paths": [
      {
        "path": "https://{{ (index .Config \"api-url\") }}/api/torznab",
        "response": {
          "type": "xml"
        }
      }
    ],
    "inputs": {
      "t": "{{ if .Keywords }}{{ .Query.Type }}{{ else }}search{{ end }}",
      "q": "{{ .Keywords }}",
      "season": "{{ .Query.Season }}",
      "ep": "{{ .Query.Ep }}",
      "limit": "100"
    },
    "keywordsfilters": [
      {
        "name": "re_replace",
        "args": [
          " *\\b((?:19|20)\\d{2})\\b",
          "{{ if .Config.radarr_compatibility }}{{ else }} $1{{ end }}"
        ],
        "engine": "regexp2"
      },
      {
        "name": "re_replace",
        "args": [
          "(?i) *\\b(S(?:0|eason *)?1)\\b",
          "{{ if .Config.strip_s01 }}{{ else }} $1{{ end }}"
        ],
        "engine": "regexp2"
      }
    ],
    "rows": {
      "selector": "rss > channel > item"
    },
    "fields": {
      "category": {
        "text": "Anime"
      },
      "title_keyword_year": {
        "text": "{{ .Query.Keywords }}",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "\\b((19|20)\\d{2})\\b"
            ],
            "engine": "regexp2"
          }
        ]
      },
      "title_default": {
        "selector": "title",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "^(\\[.+?\\] ?)?(\\[.+?\\] ?)?(.+?)(\\[)",
              "${1}${2}${3}{{ if and (.Config.radarr_compatibility) (.Result.title_keyword_year) }} {{ .Result.title_keyword_year }} ${4}{{ else }}${4}{{ end }}"
            ]
          }
        ]
      },
      "title_has_season": {
        "text": "{{ .Result.title_default }}",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "(?i)(S\\p{Nd}{1,3}([Ev]\\p{Nd}+)?)"
            ]
          },
          {
            "name": "append",
            "args": [
              "NULL"
            ]
          }
        ]
      },
      "title_has_episode": {
        "text": "{{ .Result.title_default }}",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "\\b(.+? - ?)(\\d+([-v]\\d+)?) ([\\[\\(])\\b"
            ],
            "engine": "regexp2"
          },
          {
            "name": "append",
            "args": [
              "NULL"
            ]
          }
        ]
      },
      "title_has_movie_ova": {
        "text": "{{ .Result.title_default }}",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "(?i)(?<![A-Za-z0-9])(Movies?|OVA|OAV)(?![A-Za-z0-9])"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)(Movies?|OVA|OAV)",
              "YES"
            ]
          }
        ]
      },
      "title_optional": {
        "text": "{{ .Result.title_default }}",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "^(\\[.+?].+?)\\s*(?<![\\]\\)])((?:\\[|\\(| - ).+)",
              "{{ if and (ne .Result.title_has_movie_ova \"YES\") (and (eq .Result.title_has_season \"NULL\") (eq .Result.title_has_episode \"NULL\")) }}$1 S01 $2{{ else }}$1 $2{{ end }}"
            ],
            "engine": "regexp2"
          }
        ]
      },
      "title_live_action": {
        "text": "{{ .Result.title_optional }}",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "^(.+?)([\\. ])((?:19|20)\\d{2})([\\. ])(.+)$",
              "{{ if and (eq .Result.title_has_season \"NULL\") (eq .Result.title_has_episode \"NULL\") }}$1$2$3$4S01$4$5{{ else }}$1$2$3$4$5{{ end }}"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "^(?!.*(?:19|20)\\d{2})(.+?)([\\. ])((?:480|720|1080|2160)[pi])(.*)$",
              "{{ if and (eq .Result.title_has_season \"NULL\") (eq .Result.title_has_episode \"NULL\") }}$1$2S01$2$3$4{{ else }}$1$2$3$4{{ end }}"
            ],
            "engine": "regexp2"
          }
        ]
      },
      "title": {
        "text": "{{ if .Config.sonarr_compatibility }}{{ .Result.title_live_action }}{{ else }}{{ .Result.title_default }}{{ end }}"
      },
      "details": {
        "selector": "link"
      },
      "download": {
        "selector": "enclosure",
        "attribute": "url"
      },
      "infohash": {
        "selector": "[name=infohash]",
        "attribute": "value"
      },
      "tmdbid": {
        "selector": "[name=tmdbid]",
        "attribute": "value"
      },
      "tvdbid": {
        "selector": "[name=tvdbid]",
        "attribute": "value"
      },
      "date": {
        "selector": "pubDate",
        "filters": [
          {
            "name": "dateparse",
            "args": [
              "Mon, 02 Jan 2006 15:04:05 -07:00",
              "Mon, 02 Jan 2006 15:04:05 -0700"
            ]
          }
        ]
      },
      "files": {
        "selector": "[name=files]",
        "attribute": "value",
        "optional": true
      },
      "size": {
        "selector": "[name=size]",
        "attribute": "value"
      },
      "seeders": {
        "selector": "[name=seeders]",
        "attribute": "value"
      },
      "leechers": {
        "selector": "[name=leechers]",
        "attribute": "value"
      },
      "downloadvolumefactor": {
        "text": "0"
      },
      "uploadvolumefactor": {
        "text": "1"
      },
      "description": {
        "selector": "title"
      }
    }
  },
  "source": {
    "path": "definitions/v11/animetosho-xyz.yml",
    "sha256": "0e34dedaca3a25ee82d8d4e36aa2349315c0bc21a246bf593d2615a7c9cea638",
    "modified": "converted by streamline's internal/cardigann/convert: YAML to JSON; .NET regexes, substitutions, date layouts and template string literals rewritten for Go"
  },
  "regex_net": true
}
