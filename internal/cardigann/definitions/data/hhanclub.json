{
  "id": "hhanclub",
  "name": "HHanClub",
  "description": "HHanClub is a CHINESE Private Torrent Tracker for HD MOVIES / TV",
  "language": "zh-CN",
  "type": "private",
  "encoding": "UTF-8",
  "followredirect": true,
  "links": [
    "https://hhanclub.net/",
    "https://hhan.club/"
  ],
  "legacylinks": [
    "https://hhanclub.top/"
  ],
  "caps": {
    "categorymappings": [
      {
        "id": "409",
        "cat": "Other",
        "desc": "其他"
      },
      {
        "id": "407",
        "cat": "TV/Sport",
        "desc": "Sports"
      },
      {
        "id": "403",
        "cat": "TV",
        "desc": "综艺"
      },
      {
        "id": "402",
        "cat": "TV",
        "desc": "电视剧"
      },
      {
        "id": "405",
        "cat": "TV/Anime",
        "desc": "动漫"
      },
      {
        "id": "404",
        "cat": "TV/Documentary",
        "desc": "纪录片"
      },
      {
        "id": "401",
        "cat": "Movies",
        "desc": "电影"
      },
      {
        "id": "412",
        "cat": "Audio/Video",
        "desc": "短剧"
      }
    ],
    "modes": {
      "search": [
        "q"
      ],
      "tv-search": [
        "q",
        "season",
        "ep",
        "imdbid",
        "doubanid"
      ],
      "movie-search": [
        "q",
        "imdbid",
        "doubanid"
      ]
    }
  },
  "settings": [
    {
      "name": "username",
      "label": "Username",
      "type": "text"
    },
    {
      "name": "password",
      "label": "Password",
      "type": "password",
      "secret": true
    },
    {
      "name": "2facode",
      "label": "2FA code",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_2fa",
      "label": "About 2FA code",
      "type": "info",
      "default": "Only fill in the <b>2FA code</b> box if you have enabled <b>2FA</b> on the HHanClub Web Site. Otherwise just leave it empty."
    },
    {
      "name": "freeleech",
      "label": "Search freeleech only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "sort",
      "label": "Sort requested from site",
      "type": "select",
      "default": "4",
      "options": {
        "4": "created",
        "7": "seeders",
        "5": "size",
        "1": "title"
      }
    },
    {
      "name": "type",
      "label": "Order requested from site",
      "type": "select",
      "default": "desc",
      "options": {
        "desc": "desc",
        "asc": "asc"
      }
    },
    {
      "name": "info_tpp",
      "label": "Results Per Page",
      "type": "info",
      "default": "For best results, change the <b>Torrents per page:</b> setting to <b>100</b> on your account profile."
    },
    {
      "name": "info_activity",
      "label": "Account Inactivity",
      "type": "info",
      "default": "Account retention rules:<ol><li>Ultimate User and above will be retained forever</li><li>Veteran Users and above will not be deleted after parking (in the control panel)</li><li>Users with a parked account will be banned if they do not log in for 400 consecutive days</li><li>Users who do not log in for 30 consecutive days will be banned</li><li>Newly registered users with no traffic within 7 days, will be banned.</li></ol>"
    }
  ],
  "login": {
    "method": "form",
    "path": "login.php",
    "form": "form[action=\"takelogin.php\"]",
    "captcha": {
      "type": "image",
      "selector": "img[alt=\"CAPTCHA\"]",
      "input": "imagestring"
    },
    "inputs": {
      "secret": "",
      "username": "{{ .Config.username }}",
      "password": "{{ .Config.password }}",
      "two_step_code": "{{ (index .Config \"2facode\") }}",
      "ssl": "yes",
      "trackerssl": "yes",
      "logout": "",
      "securelogin": ""
    },
    "error": [
      {
        "selector": "div#Container > div.flex:has(div:contains(\"失败\"))"
      }
    ],
    "test": {
      "path": "index.php",
      "selector": "a[href=\"logout.php\"]"
    }
  },
  "search": {
    "paths": [
      {
        "path": "torrents.php",
        "followredirect": true
      }
    ],
    "inputs": {
      "$raw": "{{ range .Categories }}cat[]={{.}}&{{end}}",
      "search": "{{ if .Query.IMDBID }}{{ .Query.IMDBID }}{{ else }}{{ end }}{{ if and .Query.DoubanID (eq .Query.IMDBID .False) }}{{ .Query.DoubanID }}{{ else }}{{ end }}{{ if and (eq .Query.IMDBID .False) (eq .Query.DoubanID .False) }}{{ .Keywords }}{{ else }}{{ end }}",
      "incldead": "0",
      "spstate": "{{ if .Config.freeleech }}2{{ else }}0{{ end }}",
      "search_area": "{{ if .Query.IMDBID }}4{{ else }}{{ end }}{{ if and .Query.DoubanID (eq .Query.IMDBID .False) }}1{{ else }}{{ end }}{{ if and (eq .Query.IMDBID .False) (eq .Query.DoubanID .False) }}0{{ else }}{{ end }}",
      "search_mode": "0",
      "sort": "{{ .Config.sort }}",
      "type": "{{ .Config.type }}",
      "notnewword": "1"
    },
    "keywordsfilters": [
      {
        "name": "re_replace",
        "args": [
          "\\b(S\\d{2,})?(?:E\\d{2,})\\b",
          "$1"
        ],
        "engine": "regexp2"
      }
    ],
    "rows": {
      "selector": "div.w-full:has(a[href^=\"details.php?id=\"])"
    },
    "fields": {
      "_episode_number": {
        "selector": "div.torrent-title > div > div",
        "optional": true,
        "filters": [
          {
            "name": "regexp",
            "args": [
              "第(\\p{Nd}+(?:-\\p{Nd}+)?)集"
            ]
          }
        ]
      },
      "category": {
        "selector": "a[href^=\"?cat[]=\"]",
        "attribute": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "cat[]"
            ]
          }
        ]
      },
      "title": {
        "selector": "a[href^=\"details.php?id=\"]",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "\\b(S\\d+)\\b",
              "{{ if .Result._episode_number }}$1E{{ .Result._episode_number }}{{ else }}$1{{ end }}"
            ],
            "engine": "regexp2"
          }
        ]
      },
      "details": {
        "selector": "a[href^=\"details.php?id=\"]",
        "attribute": "href"
      },
      "download": {
        "selector": "a[href^=\"download.php?id=\"]",
        "attribute": "href"
      },
      "doubanid": {
        "selector": "a[href*=\"movie.douban.com/subject/\"]",
        "attribute": "href"
      },
      "date_elapsed": {
        "selector": "div.torrent-info-text:nth-child(2) > span[title]",
        "attribute": "title",
        "optional": true,
        "filters": [
          {
            "name": "append",
            "args": [
              " +08:00"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "2006-01-02 15:04:05 -07:00",
              "2006-01-02 15:04:05 -0700"
            ]
          }
        ]
      },
      "date_added": {
        "selector": "div.torrent-info-text:nth-child(2):not(:has(span))",
        "optional": true,
        "filters": [
          {
            "name": "append",
            "args": [
              " +08:00"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "2006-01-0215:04:05 -07:00",
              "2006-01-0215:04:05 -0700"
            ]
          }
        ]
      },
      "date": {
        "text": "{{ if or .Result.date_elapsed .Result.date_added }}{{ or .Result.date_elapsed .Result.date_added }}{{ else }}now{{ end }}"
      },
      "size": {
        "selector": "div.torrent-info-text:nth-child(1)"
      },
      "seeders": {
        "selector": "div.torrent-info-text:nth-child(3)"
      },
      "leechers": {
        "selector": "div.torrent-info-text:nth-child(4)"
      },
      "grabs": {
        "selector": "div.torrent-info-text:nth-child(5)"
      },
      "downloadvolumefactor": {
        "case": {
          "span.promotion-tag-free": "0",
          "span.promotion-tag-free2up": "0",
          "span.promotion-tag-50pctdown": "0.5",
          "span.promotion-tag-50pctdown2up": "0.5",
          "span.promotion-tag-30pctdown": "0.3",
          "*": "1"
        }
      },
      "uploadvolumefactor": {
        "case": {
          "span.promotion-tag-50pctdown2up": "2",
          "span.promotion-tag-free2up": "2",
          "span.promotion-tag-2up": "2",
          "*": "1"
        }
      },
      "minimumseedtime": {
        "text": "172800"
      },
      "description": {
        "selector": "div.torrent-title > div > div"
      }
    }
  },
  "source": {
    "path": "definitions/v11/hhanclub.yml",
    "sha256": "dfb932bc7f0775f01e7202468caa49e139cb8c66238df89cc8f0ea02a1f79c28",
    "modified": "converted by streamline's internal/cardigann/convert: YAML to JSON; .NET regexes, substitutions, date layouts and template string literals rewritten for Go"
  },
  "regex_net": true
}
