  "settings": [
    {
      "name": "username",
      "label": "Username",
      "type": "text"
    },
    {
      "name": "password",
      "label": "Password",
      "type": "password",
      "secret": true
    },
    {
      "name": "sort",
      "label": "Sort requested from site",
      "type": "select",
      "default": "added",
      "options": {
        "added": "created",
        "seeds": "seeders",
        "size": "size",
        "name": "title"
      }
    },
    {
      "name": "type",
      "label": "Order requested from site",
      "type": "select",
      "default": "desc",
      "options": {
        "desc": "desc",
        "asc": "asc"
      }
    }
  ],
  "login": {
    "method": "form",
    "cookies": [
      "JAVA=OK"
    ],
    "path": "haustuer.php",
    "form": "form[action=\"haustuer.php\"]",
    "inputs": {
      "input[id=\"username\"]": "{{ .Config.username }}",
      "input[id=\"password\"]": "{{ .Config.password }}",
      "input[name=\"loginkeeping\"]": "loginkeeping",
      "input[name=\"loginnow\"]": "yes"
    },
    "selectors": true,
    "selectorinputs": {
      "uufl": {
        "selector": "input[name=\"uufl\"]",
        "attribute": "value"
      },
      "uupf": {
        "selector": "input[name=\"uupf\"]",
        "attribute": "value"
      }
    },
    "error": [
      {
        "selector": "div[style=\"color: #EC0000;\"]"
      }
    ],
    "test": {
      "path": "index.php",
      "selector": "a[href=\"logout.php\"]"
    }
  },
  "search": {
    "paths": [
      {
        "path": "selection.php"
      }
    ],
    "inputs": {
      "$raw": "{{ if .Categories }}{{ range .Categories }}scat[]={{.}}&{{end}}{{ else }}{{ end }}",
      "search": "{{ if .Query.IMDBID }}{{ .Query.IMDBID }}{{ else }}{{ .Keywords }}{{ end }}",
      "blah": "{{ if .Query.IMDBID }}3{{ else }}0{{ end }}",
      "orderby": "{{ .Config.sort }}",
      "sort": "{{ .Config.type }}"
    },
    "rows": {
      "selector": "div.content_wrap > div.selection_wrap:has(a[href^=\"details.php?id=\"])"
    },
    "fields": {
      "category": {
        "selector": "a[href^=\"selection.php?cat=\"]",
        "attribute": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "cat"
            ]
          }
        ]
      },
      "title": {
        "selector": "a[href^=\"details.php?id=\"]"
      },
      "details": {
        "selector": "a[href^=\"details.php?id=\"]",
        "attribute": "href"
      },
      "download": {
        "selector": "a[href^=\"download_ssl.php?torrent=\"]",
        "attribute": "href"
      },
      "imdbid": {
        "selector": "a[href*=\"imdb.com/title/tt\"]",
        "attribute": "href"
      },
      "poster": {
        "selector": "div[id^=\"details-\"] div div img",
        "attribute": "src"
      },
      "description": {
        "selector": "div[class^=\"flag_pic_\"]",
        "attribute": "onmouseover",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "'(.+?)'"
            ]
          }
        ]
      },
      "size": {
        "selector": "div.selection_unter_ad"
      },
      "grabs": {
        "selector": "div.selection_unter_ae"
      },
      "seeders": {
        "selector": "div.selection_unter_aa"
      },
      "leechers": {
        "selector": "div.selection_unter_aaa"
      },
      "date_day": {
        "selector": "div.selection_unter_ab:contains(\"Heute\"), div.selection_unter_ab:contains(\"Gestern\")",
        "optional": true,
        "filters": [
          {
            "name": "replace",
            "args": [
              "Heute ",
              "Today"
            ]
          },
          {
            "name": "replace",
            "args": [
              "Gestern ",
              "Yesterday"
            ]
          },
          {
            "name": "append",
            "args": [
              " +01:00"
            ]
          }
        ]
      },
      "date_year": {
        "selector": "div.selection_unter_ab:not(:contains(\"Heute\")):not(:contains(\"Gestern\"))",
        "optional": true,
        "filters": [
          {
            "name": "append",
            "args": [
              " +01:00"
            ]
          },
          {
            "name": "replace",
            "args": [
              "um ",
              ""
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "02.01.2006 15:04:05 -07:00",
              "02.01.2006 15:04:05 -0700"
            ]
          }
        ]
      },
      "date": {
        "text": "{{ if or .Result.date_year .Result.date_day }}{{ or .Result.date_year .Result.date_day }}{{ else }}now{{ end }}"
      },
      "downloadvolumefactor": {
        "text": "1"
      },
      "uploadvolumefactor": {
        "text": "1"
      },
      "minimumratio": {
        "text": "1.0"
      },
      "minimumseedtime": {
        "text": "172800"
      }
    }
  },
  "source": {
