  "settings": [
    {
      "name": "apikey",
      "label": "API Token",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_apikey",
      "label": "About your API Token",
      "type": "info",
      "default": "Find/Generate an API token from your <a href=\"https://pt.0ff.cc/usercp.php\" target=\"_blank\">Free Farm</a> account control panel."
    },
    {
      "name": "passkey",
      "label": "Passkey",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_passkey",
      "label": "About your Passkey",
      "type": "info",
      "default": "Find the Passkey from your account control panel."
    },
    {
      "name": "freeleech",
      "label": "Filter freeleech only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "sort",
      "label": "Sort requested from site",
      "type": "select",
      "default": "-id",
      "options": {
        "-id": "created",
        "-seeders": "seeders",
        "-size": "size",
        "-times_completed": "grabs"
      }
    },
    {
      "name": "info_activity",
      "label": "Account Inactivity",
      "type": "info",
      "default": "Cherish your user account. Inactive accounts would be deleted based on the following rules:<ol><li>Veteran User or above would never be deleted.</li><li>Elite User or above would never be deleted if parked (at User CP).</li><li>Parked accounts would be deleted if users have not logged in for more than 400 days in a row.</li><li>Unparked accounts would be deleted if users have not logged in for more than 150 days in a row.</li><li>Accounts with both uploaded and downloaded amount being 0 would be deleted if users have not logged in for more than 100 days in a row.</li></ol>"
    }
  ],
  "login": {
    "method": "get",
    "path": "api/v1/torrents",
    "inputs": {
      "per_page": "1"
    },
    "error": [
      {
        "selector": ":root:contains(\"login.php?returnto\")",
        "message": {
          "text": "The API token was not accepted by {{ .Config.sitelink }}."
        }
      },
      {
        "selector": ":root:contains(\"Unauthenticated\")",
        "message": {
          "text": "The API token was not accepted by {{ .Config.sitelink }}."
        }
      }
    ]
  },
  "search": {
    "paths": [
      {
        "path": "api/v1/torrents",
        "response": {
          "type": "json"
        }
      }
    ],
    "inputs": {
      "$raw": "{{ range .Categories }}&filter[category][in][]={{.}}{{end}}",
      "filter[title]": "{{ .Keywords }}",
      "sorts": "{{ .Config.sort }}",
      "per_page": "100"
    },
    "headers": {
      "Authorization": [
        "Bearer {{ .Config.apikey }}"
      ]
    },
    "keywordsfilters": [
      {
        "name": "re_replace",
        "args": [
          "\\.",
          " "
        ]
      }
    ],
    "rows": {
      "selector": "data.data{{ if .Config.freeleech }}:not(promotion_info.down_multiplier:contains(1)):not(promotion_info.down_multiplier:contains(.)){{ else }}{{ end }}"
    },
    "fields": {
      "category": {
        "selector": "category"
      },
      "_id": {
        "selector": "id"
      },
      "title": {
        "selector": "name"
      },
      "details": {
        "text": "{{ .Config.sitelink }}details.php?id={{ .Result._id }}&hit=1"
      },
      "download": {
        "text": "{{ .Config.sitelink }}download.php?id={{ .Result._id }}&passkey={{ .Config.passkey }}"
      },
      "infohash": {
        "selector": "hash"
      },
      "poster": {
        "selector": "cover"
      },
      "description": {
        "selector": "small_descr"
      },
      "size": {
        "selector": "size"
      },
      "files": {
        "selector": "numfiles"
      },
      "seeders": {
        "selector": "seeders"
      },
      "leechers": {
        "selector": "leechers"
      },
      "grabs": {
        "selector": "times_completed"
      },
      "date": {
        "selector": "added",
        "filters": [
          {
            "name": "append",
            "args": [
              " +08:00"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "2006-01-02 15:04 -07:00"
            ]
          }
        ]
      },
      "downloadvolumefactor": {
        "selector": "promotion_info.down_multiplier"
      },
      "uploadvolumefactor": {
        "selector": "promotion_info.up_multiplier"
      },
      "minimumseedtime": {
        "selector": "hr",
        "case": {
          "1": "604800",
          "0": "259200"
        }
      }
    }
  },
  "source": {
