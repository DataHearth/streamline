    "modes": {
      "search": [
        "q"
      ],
      "tv-search": [
        "q",
        "season",
        "ep"
      ],
      "movie-search": [
        "q"
      ],
      "music-search": [
        "q"
      ],
      "book-search": [
        "q"
      ]
    }
  },
  "settings": [
    {
      "name": "cookie",
      "label": "Cookie",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_cookie",
      "type": "info_cookie"
    },
    {
      "name": "stripcyrillic",
      "label": "Strip Cyrillic Letters",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "addrussiantotitle",
      "label": "Add RUS to end of all titles to improve language detection by Sonarr and Radarr. Will cause English-only results to be misidentified.",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "freeleech",
      "label": "Search freeleech only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "sort",
      "label": "Sort requested from site",
      "type": "select",
      "default": "4",
      "options": {
        "4": "created",
        "1": "title",
        "5": "size",
        "7": "seeders"
      }
    },
    {
      "name": "type",
      "label": "Order requested from site",
      "type": "select",
      "default": "desc",
      "options": {
        "desc": "desc",
        "asc": "asc"
      }
    },
    {
      "name": "info_tpp",
      "label": "Results Per Page",
      "type": "info",
      "default": "For best results, change the <b>Torrents per page:</b> setting to <b>100</b> on your account profile."
    }
  ],
  "login": {
    "method": "cookie",
    "inputs": {
      "cookie": "{{ .Config.cookie }}"
    },
    "test": {
      "path": "/",
      "selector": "a[href=\"mybonus.php\"]"
    },
    "headers": {
      "Cookie": [
        "torrentviewblock=1"
      ]
    }
  },
  "search": {
    "paths": [
      {
        "path": "browse.php"
      }
    ],
    "inputs": {
      "incldead": "{{ if .Config.freeleech }}3{{ else }}0{{ end }}",
      "search": "{{ .Keywords }}",
      "sort": "{{ .Config.sort }}",
      "type": "{{ .Config.type }}"
    },
    "headers": {
      "Cookie": [
        "torrentviewblock=1"
      ]
    },
    "keywordsfilters": [
      {
        "name": "re_replace",
        "args": [
          "(?i)\\bS0*(\\d+)\\b",
          "сезон $1"
        ],
        "engine": "regexp2"
      },
      {
        "name": "re_replace",
        "args": [
          "(?i)\\bE0*(\\d+)\\b",
          "сери $1"
        ],
        "engine": "regexp2"
      },
      {
        "name": "re_replace",
        "args": [
          "(?i)\\bS0*(\\d+)E0*(\\d+)\\b",
          "сезон $1 сери $2"
        ],
        "engine": "regexp2"
      }
    ],
    "rows": {
      "dateheaders": {
        "selector": "a[href*=\"date=\"]",
        "attribute": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "date"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "2006-01-02"
            ]
          }
        ]
      },
      "selector": "div.tv-card"
    },
    "fields": {
      "categorydesc": {
        "selector": "span.tv-card-cat"
      },
      "title": {
        "selector": "a.tv-card-title",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "(?i)[CС]езоны?[\\t-\\r\\x{85}\\p{Z}:]*(\\p{Nd}+(?:-\\p{Nd}+)?).+?(?:[\\t-\\r\\x{85}\\p{Z}]*(?:[CС]ери[ияй]|Эпизод|Выпуски?))[\\t-\\r\\x{85}\\p{Z}:]*(\\p{Nd}+(?:-\\p{Nd}+)?)[\\t-\\r\\x{85}\\p{Z}]*из[\\t-\\r\\x{85}\\p{Z}]*([\\p{L}\\p{Mn}\\p{Nd}\\p{Pc}]?)",
              "S${1}E${2} of ${3}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)(\\p{Nd}+(?:-\\p{Nd}+)?)[\\t-\\r\\x{85}\\p{Z}]*[CС]езоны?.+?(\\p{Nd}+(?:-\\p{Nd}+)?)[\\t-\\r\\x{85}\\p{Z}]*из[\\t-\\r\\x{85}\\p{Z}]*([\\p{L}\\p{Mn}\\p{Nd}\\p{Pc}]?)(?:[\\t-\\r\\x{85}\\p{Z}]*(?:[CС]ери[ияй]|Эпизод|Выпуски?))?",
              "S${1}E${2} of ${3}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)(\\p{Nd}+(?:-\\p{Nd}+)?)[\\t-\\r\\x{85}\\p{Z}]*[CС]езоны?.+?(\\p{Nd}+(?:-\\p{Nd}+)?)[\\t-\\r\\x{85}\\p{Z}]*(?:[\\t-\\r\\x{85}\\p{Z}]*(?:[CС]ери[ияй]|Эпизод|Выпуски?))[\\t-\\r\\x{85}\\p{Z}]+из[\\t-\\r\\x{85}\\p{Z}]*([\\p{L}\\p{Mn}\\p{Nd}\\p{Pc}]?)",
              "S${1}E${2} of ${3}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)[CС]езоны?[\\t-\\r\\x{85}\\p{Z}:]*(\\p{Nd}+(?:-\\p{Nd}+)?).+?(\\p{Nd}+(?:-\\p{Nd}+)?)[\\t-\\r\\x{85}\\p{Z}]*из[\\t-\\r\\x{85}\\p{Z}]*([\\p{L}\\p{Mn}\\p{Nd}\\p{Pc}]?)(?:[\\t-\\r\\x{85}\\p{Z}]*(?:[CС]ери[ияй]|Эпизод|Выпуски?))?",
              "S${1}E${2} of ${3}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)[CС]езоны?[\\t-\\r\\x{85}\\p{Z}:]*(\\p{Nd}+(?:-\\p{Nd}+)?).+?(\\p{Nd}+(?:-\\p{Nd}+)?)[\\t-\\r\\x{85}\\p{Z}]*(?:[\\t-\\r\\x{85}\\p{Z}]*(?:[CС]ери[ияй]|Эпизод|Выпуски?))[\\t-\\r\\x{85}\\p{Z}]+из[\\t-\\r\\x{85}\\p{Z}]*([\\p{L}\\p{Mn}\\p{Nd}\\p{Pc}]?)",
              "S${1}E${2} of ${3}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)[CС]езоны?[\\t-\\r\\x{85}\\p{Z}:]*(\\p{Nd}+(?:-\\p{Nd}+)?).+?(?:[\\t-\\r\\x{85}\\p{Z}]*(?:[CС]ери[ияй]|Эпизод|Выпуски?))[\\t-\\r\\x{85}\\p{Z}:]*(\\p{Nd}+(?:-\\p{Nd}+)?)",
              "S${1}E${2}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)(\\p{Nd}+(?:-\\p{Nd}+)?)[\\t-\\r\\x{85}\\p{Z}]*[CС]езоны?.+?(\\p{Nd}+(?:-\\p{Nd}+)?)(?:[\\t-\\r\\x{85}\\p{Z}]*(?:[CС]ери[ияй]|Эпизод|Выпуски?))",
              "S${1}E${2}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)[CС]езоны?[\\t-\\r\\x{85}\\p{Z}:]*(\\p{Nd}+(?:-\\p{Nd}+)?).+?(\\p{Nd}+(?:-\\p{Nd}+)?)(?:[\\t-\\r\\x{85}\\p{Z}]*(?:[CС]ери[ияй]|Эпизод|Выпуски?))",
              "S${1}E${2}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)[CС]езоны?[\\t-\\r\\x{85}\\p{Z}:]*(\\p{Nd}+(?:-\\p{Nd}+)?)",
              "S${1}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)(\\p{Nd}+(?:-\\p{Nd}+)?)[\\t-\\r\\x{85}\\p{Z}]+[CС]езоны?",
              "S${1}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)(?:[\\t-\\r\\x{85}\\p{Z}]*(?:[CС]ери[ияй]|Эпизод|Выпуски?))[\\t-\\r\\x{85}\\p{Z}:]*(\\p{Nd}+(?:-\\p{Nd}+)?)[\\t-\\r\\x{85}\\p{Z}]*из[\\t-\\r\\x{85}\\p{Z}]*([\\p{L}\\p{Mn}\\p{Nd}\\p{Pc}]?)",
              "E${1} of ${2}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)(\\p{Nd}+(?:-\\p{Nd}+)?)[\\t-\\r\\x{85}\\p{Z}]*из[\\t-\\r\\x{85}\\p{Z}]*([\\p{L}\\p{Mn}\\p{Nd}\\p{Pc}]?)(?:[\\t-\\r\\x{85}\\p{Z}]*(?:[CС]ери[ияй]|Эпизод|Выпуски?))",
              "E${1} of ${2}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)(\\p{Nd}+(?:-\\p{Nd}+)?)[\\t-\\r\\x{85}\\p{Z}]+(?:[\\t-\\r\\x{85}\\p{Z}]*(?:[CС]ери[ияй]|Эпизод|Выпуски?))[\\t-\\r\\x{85}\\p{Z}]+из[\\t-\\r\\x{85}\\p{Z}]*([\\p{L}\\p{Mn}\\p{Nd}\\p{Pc}]?)",
              "E${1} of ${2}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)(?:[\\t-\\r\\x{85}\\p{Z}]*(?:[CС]ери[ияй]|Эпизод|Выпуски?))[\\t-\\r\\x{85}\\p{Z}:]*(\\p{Nd}+(?:-\\p{Nd}+)?)",
              "E${1}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)(\\p{Nd}+(?:-\\p{Nd}+)?)[\\t-\\r\\x{85}\\p{Z}]+(?:[\\t-\\r\\x{85}\\p{Z}]*(?:[CС]ери[ияй]|Эпизод|Выпуски?))",
              "E${1}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\bFiles-х\\b",
              "Files-x"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\sот\\s([\\p{L}\\p{Mn}\\p{Nd}\\p{Pc}\\p{P}\\p{S}]+)$",
              "-$1"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "\\s\\|\\s([\\p{L}\\p{Mn}\\p{Nd}\\p{Pc}]{4,})$",
              "-$1"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(\\([\\u0400-\\u04FF\\W\\u200C\\u200D]+\\))|(^[\\u0400-\\u04FF\\W\\u200C\\u200D\\d]+\\/ )|([\\u0400-\\u04FF \\-]+,+)|([\\u0400-\\u04FF]+)",
              "{{ if .Config.stripcyrillic }}{{ else }}$1$2$3$4{{ end }}"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\bHDTV[-\\s]?Rip\\b",
              "HDTV"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\bSAT[-\\s]?Rip\\b",
              "HDTV"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\bWEB[-\\s]?DL[-\\s]?Rip\\b",
              "WEB-DL"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\bWEB\\sRip\\b",
              "WEBRip"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\bWEB\\sDL\\b",
              "WEB-DL"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "[\\[\\(\\{<«][\\s\\W\\u200C\\u200D]*[\\]\\)\\}>»]",
              ""
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "^[\\t-\\r\\x{85}\\p{Z}&,\\.!\\?\\+\\-_\\|\\/':]+",
              ""
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)^\\([\\t-\\r\\x{85}\\p{Z}]*([SE]\\p{Nd}+.*?)[\\t-\\r\\x{85}\\p{Z}]*\\)[\\t-\\r\\x{85}\\p{Z}\\/\\|]*(.+)",
              "${2} ${1}"
            ]
          },
          {
            "name": "append",
            "args": [
              "{{ if .Config.addrussiantotitle }} RUS{{ else }}{{ end }}"
            ]
          }
        ]
      },
      "details": {
        "selector": "a[href^=\"details.php?id=\"]",
        "attribute": "href"
      },
      "download": {
        "selector": "a[href^=\"download.php?id=\"]",
        "attribute": "href",
        "optional": true
      },
      "poster": {
        "selector": "img.tv-avatars",
        "attribute": "src",
        "optional": true
      },
      "size_nodl": {
        "selector": "span.tv-dl-btn",
        "optional": true
      },
      "size": {
        "selector": "a.tv-dl-btn",
        "optional": true,
        "default": "{{ .Result.size_nodl }}"
      },
      "seeders": {
        "selector": "span.up"
      },
      "leechers": {
        "selector": "span.down"
      },
      "downloadvolumefactor": {
        "case": {
          "span.tv-badge-free": "0",
          "*": "1"
        }
      },
      "uploadvolumefactor": {
        "text": "1"
      },
      "minimumratio": {
        "text": "1.0"
      },
      "description": {
        "selector": "div.tv-card-tags",
        "optional": true
      }
    }
  },
