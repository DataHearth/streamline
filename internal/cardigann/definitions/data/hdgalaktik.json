  "type": "semi-private",
  "encoding": "UTF-8",
  "links": [
    "https://www.trackerpmr.com/",
    "https://freetmd.com/",
    "https://kinoradiomagia.tv/"
  ],
  "legacylinks": [
    "https://hdgalaktik.com/"
  ],
  "caps": {
