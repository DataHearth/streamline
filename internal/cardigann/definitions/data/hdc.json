{
  "id": "hdc",
  "name": "HDCiTY",
  "description": "HDCiTY (HDC) is a CHINESE Private Torrent Tracker for HD MOVIES / TV / GENERAL",
  "language": "zh-CN",
  "type": "private",
  "encoding": "UTF-8",
  "links": [
    "https://hdcity.city/",
    "https://hdcity.work/",
    "https://hdcity.leniter.org/"
  ],
  "legacylinks": [
    "https://hdcity4.leniter.org/"
  ],
  "caps": {
    "categorymappings": [
      {
        "id": "401",
        "cat": "Movies",
        "desc": "Movies/电影"
      },
      {
