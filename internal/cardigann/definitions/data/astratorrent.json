{
  "id": "astratorrent",
  "name": "AstraTorrent",
  "description": "AstraTorrent is a FRENCH Private Torrent Tracker for MOVIES / TV / GENERAL",
  "language": "fr-FR",
  "type": "private",
  "encoding": "UTF-8",
  "requestDelay": 2,
  "links": [
    "https://astratorrent.la/"
  ],
  "caps": {
    "categorymappings": [
      {
        "id": "2000",
        "cat": "Movies",
        "desc": "Movies"
      },
      {
        "id": "2040",
        "cat": "Movies/HD",
        "desc": "Movies/HD"
      },
      {
        "id": "2045",
        "cat": "Movies/UHD",
        "desc": "Movies/UHD"
      },
      {
        "id": "5000",
        "cat": "TV",
        "desc": "TV"
      },
      {
        "id": "5040",
        "cat": "TV/HD",
        "desc": "TV/HD"
      },
      {
        "id": "5045",
        "cat": "TV/UHD",
        "desc": "TV/UHD"
      },
      {
        "id": "5070",
        "cat": "TV/Anime",
        "desc": "TV/Anime"
      },
      {
        "id": "1000",
        "cat": "PC/Games",
        "desc": "PC/Games"
      },
      {
        "id": "3000",
        "cat": "Audio",
        "desc": "Audio"
      },
      {
        "id": "3040",
        "cat": "Audio/Lossless",
        "desc": "Audio/Lossless"
      },
      {
        "id": "7000",
        "cat": "Books",
        "desc": "Books"
      },
      {
        "id": "7020",
        "cat": "Books/EBook",
        "desc": "Books/Ebook"
      },
      {
        "id": "4000",
        "cat": "PC",
        "desc": "PC"
      }
    ],
    "modes": {
      "search": [
        "q"
      ],
      "tv-search": [
        "q",
        "season",
        "ep"
      ],
      "movie-search": [
        "q"
      ],
      "music-search": [
        "q"
      ],
      "book-search": [
        "q"
      ]
    },
    "allowrawsearch": true
  },
  "settings": [
    {
      "name": "apikey",
      "label": "API Key",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_key",
      "label": "About your API key",
      "type": "info",
      "default": "Your API key is also your Passkey, which you can find by accessing your <a href=\"https://astratorrent.la/v2/compte.php\" target=\"_blank\">AstraTorrent</a> account settings page."
    },
    {
      "name": "multilang",
      "label": "Replace MULTi by another language in release name",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "multilanguage",
      "label": "Replace MULTi by this language",
      "type": "select",
      "default": "FRENCH",
      "options": {
        "FRENCH": "FRENCH",
        "MULTi.FRENCH": "MULTi.FRENCH",
        "ENGLISH": "ENGLISH",
        "MULTi.ENGLISH": "MULTi.ENGLISH",
        "VOSTFR": "VOSTFR",
        "MULTi.VOSTFR": "MULTi.VOSTFR"
      }
    },
    {
      "name": "vostfr",
      "label": "Replace VOSTFR and SUBFRENCH with ENGLISH",
      "type": "checkbox",
      "default": "false"
    }
  ],
  "login": {
    "method": "get",
    "path": "api/torznab.php",
    "inputs": {
      "apikey": "{{ .Config.apikey }}",
      "t": "search",
      "limit": "1"
    }
  },
  "search": {
    "paths": [
      {
        "path": "api/torznab.php",
        "response": {
          "type": "xml"
        }
      }
    ],
    "inputs": {
      "apikey": "{{ .Config.apikey }}",
      "t": "{{ .Query.Type }}",
      "q": "{{ .Keywords }}",
      "cat": "{{ join .Categories \",\" }}",
      "limit": "100"
    },
    "rows": {
      "selector": "rss > channel > item"
    },
    "fields": {
      "category": {
        "selector": "[name=category]",
        "attribute": "value"
      },
      "title_phase1": {
        "selector": "title"
      },
      "title_vostfr": {
        "text": "{{ .Result.title_phase1 }}",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "(?i)\\b(vostfr|subfrench)\\b",
              "ENGLISH"
            ],
            "engine": "regexp2"
          }
        ]
      },
      "title_phase2": {
        "text": "{{ if .Config.vostfr }}{{ .Result.title_vostfr }}{{ else }}{{ .Result.title_phase1 }}{{ end }}"
      },
      "title_multilang": {
        "text": "{{ .Result.title_phase2 }}",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "(?i)\\b(MULTI(?!.*(?:FRENCH|ENGLISH|VOSTFR|VF2|VFF|VFQ|VOQ|VFI|VOF)))\\b",
              "{{ .Config.multilanguage }}"
            ],
            "engine": "regexp2"
          }
        ]
      },
      "title": {
        "text": "{{ if .Config.multilang }}{{ .Result.title_multilang }}{{ else }}{{ .Result.title_phase2 }}{{ end }}"
      },
      "_id": {
        "selector": "guid",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "id"
            ]
          }
        ]
      },
      "details": {
        "text": "{{ .Config.sitelink }}v2/details.php?id={{ .Result._id }}"
      },
      "download": {
        "selector": "enclosure",
        "attribute": "url"
      },
      "imdbid": {
        "selector": "[name=imdbid]",
        "attribute": "value"
      },
      "tmdbid": {
        "selector": "[name=tmdbid]",
        "attribute": "value"
      },
      "date": {
        "selector": "pubDate",
        "filters": [
          {
            "name": "dateparse",
            "args": [
              "Mon, 02 Jan 2006 15:04:05 -07:00",
              "Mon, 02 Jan 2006 15:04:05 -0700"
            ]
          }
        ]
      },
      "size": {
        "selector": "[name=size]",
        "attribute": "value"
      },
      "grabs": {
        "selector": "[name=grabs]",
        "attribute": "value"
      },
      "seeders": {
        "selector": "[name=seeders]",
        "attribute": "value"
      },
      "leechers": {
        "selector": "[name=peers]",
        "attribute": "value"
      },
      "downloadvolumefactor": {
        "selector": "[name=downloadvolumefactor]",
        "attribute": "value"
      },
      "uploadvolumefactor": {
        "selector": "[name=uploadvolumefactor]",
        "attribute": "value"
      },
      "minimumseedtime": {
        "text": "172800"
      }
    }
  },
  "source": {
    "path": "definitions/v11/astratorrent.yml",
    "sha256": "2cbeb1f3dc7fff8af16a90570095c2a6b1a648aca2342d59f941a778504ca9f8",
    "modified": "converted by streamline's internal/cardigann/convert: YAML to JSON; .NET regexes, substitutions, date layouts and template string literals rewritten for Go"
  },
  "regex_net": true
}
