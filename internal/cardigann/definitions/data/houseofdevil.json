  "settings": [
    {
      "name": "username",
      "label": "Username",
      "type": "text"
    },
    {
      "name": "password",
      "label": "Password",
      "type": "password",
      "secret": true
    },
    {
      "name": "pin",
      "label": "Pin",
      "type": "text",
      "secret": true
    },
    {
      "name": "onlyupload",
      "label": "Filter OnlyUpload only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "info_free",
      "label": "About OnlyUpload at H-O-D",
      "type": "info",
      "default": "<ul><li>OnlyUpload are torrents where download is not counted but upload is. Good for building your Ratio up. (On the Prowlarr search results page these are tagged as Freeleech).</li></ul>"
    },
    {
      "name": "sort",
      "label": "Sort requested from site",
      "type": "select",
      "default": "added",
      "options": {
        "added": "created",
        "seeds": "seeders",
        "size": "size",
        "name": "title"
      }
    },
    {
      "name": "type",
      "label": "Order requested from site",
      "type": "select",
      "default": "desc",
      "options": {
        "desc": "desc",
        "asc": "asc"
      }
    },
    {
      "name": "info_tpp",
      "label": "Results Per Page",
      "type": "info",
      "default": "For best results, change the <b>Torrents pro Seite:</b> setting to <b>100</b> on your <b>UserCP</b> page. The default is <i>15</i>."
    },
    {
      "name": "info_activity",
      "label": "Account Inactivity",
      "type": "info",
      "default": "If you are inactive for longer than 8 weeks, your account will be automatically deactivated."
    },
    {
      "name": "info_seedhours",
      "label": "Seeding Hours",
      "type": "info",
      "default": "Before using this indexer, make sure that you have set <b>Seed-Angaben</b> and <b>DSL Speed</b> on your <b>UserCP</b> page."
    }
  ],
  "login": {
    "method": "post",
    "path": "takelogin.php",
    "inputs": {
      "username": "{{ .Config.username }}",
      "password": "{{ .Config.password }}",
      "pin": "{{ .Config.pin }}"
    },
    "error": [
      {
        "selector": ".tablea:contains(\"Fehler\")"
      }
    ],
    "test": {
      "path": "/",
      "selector": "a[href=\"logout.php\"]"
    }
  },
  "search": {
    "path": "browse.php",
    "inputs": {
      "$raw": "{{ range .Categories }}c{{.}}=1&{{end}}",
      "showsearch": "1",
      "search": "{{ .Keywords }}",
      "incldead": "1",
      "orderby": "{{ .Config.sort }}",
      "sort": "{{ .Config.type }}"
    },
    "rows": {
      "selector": "table.tableinborder[cellspacing=\"1\"][cellpadding=\"0\"]:not(:has(a[href=\"index.php\"])) > tbody > tr:has(a[href^=\"download.php\"]){{ if .Config.onlyupload }}:has(img[src=\"/pic/free.gif\"]){{ else }}{{ end }}"
    },
    "fields": {
      "category": {
        "selector": "a[href^=\"browse.php?cat=\"]",
        "attribute": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "cat"
            ]
          }
        ]
      },
      "title": {
        "selector": "a[href^=\"details.php\"]"
      },
      "details": {
        "selector": "a[href^=\"details.php\"]",
        "attribute": "href"
      },
      "download": {
        "selector": "a[href^=\"download.php\"]",
        "attribute": "href"
      },
      "poster": {
        "selector": "a[href^=\"details.php\"]",
        "attribute": "onMouseOver",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "src=(.*?) width"
            ]
          }
        ]
      },
      "size": {
        "selector": "td.tablea table tbody tr:nth-child(2) td:nth-child(1) b:nth-child(1)"
      },
      "files": {
        "selector": "td.tablea table tbody tr:nth-child(2) td:nth-child(1) b:nth-child(2)"
      },
      "seeders": {
        "selector": "td.tablea table tbody tr:nth-child(2) td:nth-child(2) b:nth-child(1)"
      },
      "leechers": {
        "selector": "td.tablea table tbody tr:nth-child(2) td:nth-child(2) > b:nth-of-type(2)"
      },
      "grabs": {
        "selector": "td.tablea table tbody tr:nth-child(2) td:nth-child(3) b:nth-child(1)"
      },
      "date": {
        "selector": "td.tablea table tbody tr:nth-child(2) td:nth-child(5)",
        "filters": [
          {
            "name": "append",
            "args": [
              " +01:00"
            ]
          },
          {
            "name": "replace",
            "args": [
              " ",
              " "
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "02.01.2006 15:04:05 -07:00",
              "02.01.2006 15:04:05 -0700"
            ]
          }
        ]
      },
      "downloadvolumefactor": {
        "case": {
          "img[src=\"/pic/free.gif\"]": "0",
          "*": "1"
        }
      },
      "uploadvolumefactor": {
        "text": "1"
      },
      "minimumratio": {
        "text": "0.8"
      },
      "minimumseedtime": {
        "text": "432000"
      }
    }
  },
  "source": {
