  "settings": [
    {
      "name": "cookie",
      "label": "Cookie",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_cookie",
      "type": "info_cookie"
    },
    {
      "name": "csrf_token",
      "label": "CSRF Token",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_token",
      "label": "About your CSRF Token",
      "type": "info",
      "default": "<ol><li>From the same place you fetched the cookie,</li><li>Select the <b>Elements</b> tab (Chrome Browser) or <b>Inspector</b> tab (FireFox)</li><li>Press <b>Ctrl+F</b> to search the HTML</li><li>Search for <i>csrf-token</i> and find the first result</li><li><b>Copy</b> the value of the <i>content</i> attribute and <b>Paste</b> here.</li></ol>"
    },
    {
      "name": "freeleech",
      "label": "Search freeleech only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "sort",
      "label": "Sort requested from site",
      "type": "select",
      "default": "added",
      "options": {
        "added": "created",
        "seeders": "seeders",
        "size": "size",
        "name": "title"
      }
    },
    {
      "name": "type",
      "label": "Order requested from site",
      "type": "select",
      "default": "desc",
      "options": {
        "desc": "desc",
        "asc": "asc"
      }
    }
  ],
  "login": {
    "method": "cookie",
    "inputs": {
      "cookie": "{{ .Config.cookie }}"
    },
    "test": {
      "path": "/",
      "selector": "form[action$=\"/logout\"]"
    },
    "headers": {
      "x-csrf-token": [
        "{{ .Config.csrf_token }}"
      ]
    }
  },
  "search": {
    "paths": [
      {
        "path": "torrents"
      }
    ],
    "inputs": {
      "do": "search",
      "keywords": "{{ if .Query.IMDBID }}{{ .Query.IMDBID }}{{ else }}{{ .Keywords }}{{ end }}",
      "cats": "{{ range .Categories }}{{.}},{{end}}",
      "search_type": "{{ if .Query.IMDBID }}t_genre{{ else }}t_name{{ end }}",
      "freeleech": "{{ if .Config.freeleech }}1{{ else }}{{ end }}",
      "f_sort": "{{ .Config.sort }}",
      "f_order": "{{ .Config.type }}"
    },
    "headers": {
      "x-csrf-token": [
        "{{ .Config.csrf_token }}"
      ]
    },
    "rows": {
      "selector": "div#torrent-list > div"
    },
    "fields": {
      "title": {
        "selector": "a[href*=\"/torrents/\"]"
      },
      "details": {
        "selector": "a[href*=\"/torrents/\"]",
        "attribute": "href"
      },
      "category": {
        "selector": "a[href*=\"torrents?category=\"]",
        "attribute": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "category"
            ]
          }
        ]
      },
      "poster": {
        "selector": "span.hidden img",
        "attribute": "src",
        "optional": true
      },
      "imdbid": {
        "selector": "a[href*=\"imdb.com/title/tt\"]",
        "attribute": "href",
        "optional": true
      },
      "date": {
        "selector": "span[title=\"Zaman\"]",
        "filters": [
          {
            "name": "replace",
            "args": [
              "dk",
              "minutes"
            ]
          },
          {
            "name": "replace",
            "args": [
              "h",
              "weeks"
            ]
          },
          {
            "name": "replace",
            "args": [
              "sa",
              "hours"
            ]
          },
          {
            "name": "replace",
            "args": [
              "ay",
              "months"
            ]
          },
          {
            "name": "replace",
            "args": [
              "y",
              "years"
            ]
          },
          {
            "name": "replace",
            "args": [
              "g",
              "days"
            ]
          },
          {
            "name": "append",
            "args": [
              " ago"
            ]
          },
          {
            "name": "timeago"
          }
        ]
      },
      "download": {
        "selector": "a[href*=\"/torrents/\"]",
        "attribute": "href"
      },
      "size": {
        "selector": "span[title=\"Boyut\"]"
      },
      "grabs": {
        "selector": "span[title=\"Tamamlanma (snatch)\"]"
      },
      "seeders": {
        "selector": "span[title=\"Gönderen\"]"
      },
      "leechers": {
        "selector": "span[title=\"İndiren\"]"
      },
      "downloadvolumefactor": {
        "case": {
          "img[src$=\"/freedownload.gif\"]": "0",
          "img[src$=\"/silverdownload.gif\"]": "0.5",
          "*": "1"
        }
      },
      "uploadvolumefactor": {
        "case": {
          "img[src$=\"/x2.gif\"]": "2",
          "*": "1"
        }
      },
      "minimumratio": {
        "text": "1.0"
      },
      "minimumseedtime": {
        "text": "504000"
      }
    }
  },
  "download": {
    "before": {
      "path": "{{ .DownloadUri.AbsoluteUri }}/thanks",
      "method": "post"
    },
    "selectors": [
      {
        "selector": "a[href$=\"/download\"]",
        "attribute": "href"
      }
    ],
    "headers": {
      "x-csrf-token": [
        "{{ .Config.csrf_token }}"
      ]
    }
  },
