    "modes": {
      "search": [
        "q"
      ],
      "music-search": [
        "q"
      ]
    }
  },
  "settings": [
    {
      "name": "username",
      "label": "Username",
      "type": "text"
    },
    {
      "name": "password",
      "label": "Password",
      "type": "password",
      "secret": true
    }
  ],
  "login": {
    "method": "post",
    "path": "take-login.php",
    "inputs": {
      "username": "{{ .Config.username }}",
      "password": "{{ .Config.password }}",
      "returnto": "index.php",
      "logout": ""
    },
    "error": [
      {
        "selector": "table.message:contains(\"Error\")"
      },
      {
        "selector": "body:contains(\"Error 403\")"
      }
    ],
    "test": {
      "path": "index.php",
      "selector": "a[href=\"account-logout.php\"]"
    }
  },
  "search": {
    "paths": [
      {
        "path": "torrents-browse.php"
      }
    ],
    "inputs": {
      "search": "{{ .Keywords }}",
      "incldead": "1",
      "searchscope": "1"
    },
    "keywordsfilters": [
      {
        "name": "re_replace",
        "args": [
          "(\\w+)",
          "+${1}"
        ]
      }
    ],
    "rows": {
      "selector": "table.torrent > tbody > tr:has(a[href^=\"torrents-details.php?id=\"])"
    },
    "fields": {
      "category": {
        "selector": "a[href^=\"torrents-browse.php?cat=\"]",
        "attribute": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "cat"
            ]
          }
        ]
      },
      "title": {
        "selector": "a[href^=\"torrents-details.php?id=\"]"
      },
      "details": {
        "selector": "a[href^=\"torrents-details.php?id=\"]",
        "attribute": "href"
      },
      "download": {
        "selector": "a[href^=\"torrents-details.php?id=\"]",
        "attribute": "href"
      },
      "files": {
        "selector": "td:nth-child(3)"
      },
      "date": {
        "selector": "td:nth-child(5)",
        "filters": [
          {
            "name": "append",
            "args": [
              " -00:00"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "2006-01-0215:04:05 -07:00"
            ]
          }
        ]
      },
      "size": {
        "selector": "td:nth-child(6)"
      },
      "grabs": {
        "selector": "td:nth-child(7)"
      },
      "seeders": {
        "selector": "td:nth-child(8)"
      },
      "leechers": {
        "selector": "td:nth-child(9)"
      },
      "downloadvolumefactor": {
        "text": "1"
      },
      "uploadvolumefactor": {
        "text": "1"
      },
      "minimumratio": {
        "text": "0.25"
      }
    }
  },
  "download": {
    "selectors": [
      {
        "selector": "a[href^=\"download.php/\"]",
        "attribute": "href"
      }
    ]
  },
