{
  "id": "teamhd",
  "name": "TeamHD",
  "description": "TeamHD is a RUSSIAN Private Torrent Tracker for HD MOVIES / TV",
  "language": "ru-RU",
  "type": "private",
  "encoding": "UTF-8",
  "links": [
    "https://teamhd.org/"
  ],
  "caps": {
    "categorymappings": [
      {
        "id": "29",
        "cat": "Movies/HD",
        "desc": "Movies Фильмы"
      },
      {
        "id": "25",
        "cat": "TV/Anime",
        "desc": "Cartoons Мультфильмы"
      },
      {
        "id": "26",
        "cat": "Audio/Lossless",
        "desc": "Hi-Res Audio"
      },
      {
        "id": "27",
        "cat": "Other",
        "desc": "Demo Демо"
      },
      {
        "id": "28",
        "cat": "TV/Documentary",
        "desc": "Documentary Документальное кино"
      },
      {
        "id": "30",
        "cat": "Audio/Video",
        "desc": "Music Video Музыкальное видео"
      },
      {
        "id": "31",
        "cat": "TV/Sport",
        "desc": "Sport Спорт"
      },
      {
        "id": "32",
        "cat": "TV/HD",
        "desc": "TV Show ТВ Шоу"
      },
      {
        "id": "33",
        "cat": "TV/HD",
        "desc": "Soaps Сериалы"
      },
      {
        "id": "34",
        "cat": "TV/HD",
        "desc": "Other"
      },
      {
        "id": "35",
        "cat": "Movies",
        "desc": "Content w/o subs Контент без перевода"
      }
    ],
    "modes": {
      "search": [
        "q"
      ],
      "tv-search": [
        "q",
        "season",
        "ep"
      ],
      "movie-search": [
        "q"
      ],
      "music-search": [
        "q"
      ]
    }
  },
  "settings": [
    {
      "name": "cookie",
      "label": "Cookie",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_cookie",
      "type": "info_cookie"
    },
    {
      "name": "useragent",
      "label": "User-Agent",
      "type": "text"
    },
    {
      "name": "info_useragent",
      "type": "info_useragent"
    },
    {
      "name": "stripcyrillic",
      "label": "Strip Cyrillic Letters",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "freeleech",
      "label": "Search freeleech only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "info_activity",
      "label": "Account Inactivity",
      "type": "info",
      "default": "Inactive users are regularly deleted. If you haven’t downloaded or distributed anything, or haven’t visited the site for 90 days, then you are a random guest on our resource. The tracker needs active users who know exactly why they came here. That’s why we regularly conduct automatic inactivity sweeps. If you need to be away from the tracker for a long time (business trip, personal circumstances, etc.), use 'parking' your account."
    }
  ],
  "login": {
    "method": "cookie",
    "inputs": {
      "cookie": "{{ .Config.cookie }}"
    },
    "test": {
      "path": "index.php",
      "selector": "a[href*=\"/logout.php\"]"
    },
    "headers": {
      "User-Agent": [
        "{{ .Config.useragent }}"
      ]
    }
  },
  "search": {
    "paths": [
      {
        "path": "browse"
      }
    ],
    "inputs": {
      "$raw": "{{ range .Categories }}c{{.}}=1&{{end}}",
      "search": "{{ re_replace .Keywords \"[\\\\t-\\\\r\\\\x{85}\\\\p{Z}]+\" \"%\" }}",
      "incldead": "1",
      "free": "{{ if .Config.freeleech }}1{{ else }}{{ end }}"
    },
    "headers": {
      "User-Agent": [
        "{{ .Config.useragent }}"
      ]
    },
    "keywordsfilters": [
      {
        "name": "re_replace",
        "args": [
          " +(?:19|20)\\d{2} *$",
          ""
        ],
        "engine": "regexp2"
      },
      {
        "name": "re_replace",
        "args": [
          "(?i) S0(\\d{1})$",
          " Season $1"
        ],
        "engine": "regexp2"
      },
      {
        "name": "re_replace",
        "args": [
          "(?i) S(\\d{2})$",
          " Season $1"
        ],
        "engine": "regexp2"
      }
    ],
    "rows": {
      "selector": "table.browse > tbody > tr"
    },
    "fields": {
      "download": {
        "selector": "a[href^=\"download.php?id=\"]",
        "attribute": "href"
      },
      "title": {
        "selector": "a[href^=\"/details/id\"]",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "(\\([\\u0400-\\u04FF\\W\\u200C\\u200D]+\\))|(^[\\u0400-\\u04FF\\W\\u200C\\u200D\\d]+\\/ )|([\\u0400-\\u04FF \\-]+,+)|([\\u0400-\\u04FF]+)",
              "{{ if .Config.stripcyrillic }}{{ else }}$1$2$3$4{{ end }}"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)Season (\\p{Nd}{2})",
              "S${1}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)Season (\\p{Nd}{1})",
              "S0${1}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "[\\[|\\]]",
              ""
            ]
          }
        ]
      },
      "details": {
        "selector": "a[href^=\"/details/id\"]",
        "attribute": "href"
      },
      "category": {
        "selector": "a[href*=\"/browse/cat\"]",
        "attribute": "href",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "(\\p{Nd}+)"
            ]
          }
        ]
      },
      "date": {
        "selector": "td > div > small",
        "filters": [
          {
            "name": "dateparse",
            "args": [
              "02-01-2006 15:04"
            ]
          }
        ]
      },
      "seeders": {
        "selector": "td:nth-child(4)",
        "filters": [
          {
            "name": "split",
            "args": [
              "|",
              "0"
            ]
          }
        ]
      },
      "leechers": {
        "selector": "td:nth-child(4)",
        "filters": [
          {
            "name": "split",
            "args": [
              "|",
              "1"
            ]
          }
        ]
      },
      "grabs": {
        "selector": "td:nth-child(5) strong"
      },
      "size": {
        "selector": "td:nth-child(5)",
        "remove": "strong"
      },
      "downloadvolumefactor": {
        "case": {
          ":root:has(div.justify-content-center:contains(\"Включен фрилич до\"))": "0",
          "a[href^=\"/details/id\"][style=\"color:#f2b101\"]": "0",
          "a[href^=\"/details/id\"][style=\"color:#828b8b\"]": "0.5",
          "*": "1"
        }
      },
      "uploadvolumefactor": {
        "text": "1"
      },
      "minimumratio": {
        "text": "1.0"
      },
      "description": {
        "selector": "a[href^=\"/details/id\"]",
        "optional": true
      }
    }
  },
  "source": {
    "path": "definitions/v11/teamhd.yml",
    "sha256": "cf9ddd16a4dbbe8e37185fdc4d18559e5f53cf8f7ad4a5246395f1c259fad0fb",
    "modified": "converted by streamline's internal/cardigann/convert: YAML to JSON; .NET regexes, substitutions, date layouts and template string literals rewritten for Go"
  },
  "regex_net": true
}
