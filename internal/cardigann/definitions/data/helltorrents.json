  "settings": [
    {
      "name": "username",
      "label": "Username",
      "type": "text"
    },
    {
      "name": "password",
      "label": "Password",
      "type": "password",
      "secret": true
    },
    {
      "name": "multilang",
      "label": "Replace MULTi by another language in release name",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "multilanguage",
      "label": "Replace MULTi by this language",
      "type": "select",
      "default": "POLISH",
      "options": {
        "POLISH": "POLISH",
        "MULTi POLISH": "MULTi POLISH"
      }
    },
    {
      "name": "info_tpp",
      "label": "Results Per Page",
      "type": "info",
      "default": "For best results, change the <b>Torrentów na stronę:</b> (Torrents per page) setting to <b>100</b> on your account profile."
    },
    {
      "name": "info_flaresolverr",
      "type": "info_flaresolverr"
    }
  ],
  "login": {
    "method": "form",
    "path": "login.php",
    "form": "form[name=\"login\"]",
    "inputs": {
      "uid": "{{ .Config.username }}",
      "pwd": "{{ .Config.password }}",
      "keeplogged": "1"
    },
    "error": [
      {
        "selector": "font[color=\"#FF0000\"]"
      }
    ],
    "test": {
      "path": "index.php",
      "selector": "a[href=\"logout.php\"]"
    }
  },
  "search": {
    "paths": [
      {
        "path": "torrents.php"
      }
    ],
    "inputs": {
      "$raw": "{{ range .Categories }}c{{.}}=1&{{end}}",
      "search": "{{ .Keywords }}",
      "page": "0"
    },
    "error": [
      {
        "selector": "img[src=\"../images/bladpobierania.png\"]",
        "message": {
          "text": "you do not have permission to download!"
        }
      }
    ],
    "rows": {
      "selector": "table.header:has(a[href*=\"download.php?id=\"]), table.header:has(a[href*=\"piekielny.php\"])"
    },
    "fields": {
      "categorydesc": {
        "selector": "td.pole1",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "Kategoria: (.+)"
            ]
          }
        ]
      },
      "title_phase1": {
        "selector": "a[href^=\"details.php?id=\"]"
      },
      "title_multilang": {
        "selector": "a[href^=\"details.php?id=\"]",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "(?i)\\b(MULTI(?!.*(?:POLISH|ENGLISH|\\bPL\\b)))\\b",
              "{{ .Config.multilanguage }}"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\b(pl)\\b",
              "POLISH"
            ]
          }
        ]
      },
      "title": {
        "text": "{{ if .Config.multilang }}{{ .Result.title_multilang }}{{ else }}{{ .Result.title_phase1 }}{{ end }}"
      },
      "details": {
        "selector": "a[href^=\"details.php?id=\"]",
        "attribute": "href"
      },
      "download": {
        "selector": "a[href*=\"download.php?id=\"], a[href*=\"piekielny.php\"]",
        "attribute": "href"
      },
      "poster": {
        "selector": "img",
        "attribute": "src"
      },
      "date": {
        "selector": "td.pole1",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "Dodano: (\\d{2}/\\d{2}/\\d{4})"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "02/01/2006"
            ]
          }
        ]
      },
      "size": {
        "selector": "td.pole1",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "Rozmiar: (\\d+\\.\\d+ [T|G|M|K|k]B)"
            ]
          }
        ]
      },
      "seeders": {
        "selector": "td.pole1",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "Seedów: (\\d+)"
            ]
          }
        ]
      },
      "leechers": {
        "selector": "td.pole1",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "Leecherów: (\\d+)"
            ]
          }
        ]
      },
      "grabs": {
        "selector": "td.pole1",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "Ukończone: (\\d+)"
            ]
          }
        ]
      },
      "downloadvolumefactor": {
        "text": "0"
      },
      "uploadvolumefactor": {
        "text": "1"
      }
    }
  },
  "source": {
    "path": "definitions/v11/helltorrents.yml",
