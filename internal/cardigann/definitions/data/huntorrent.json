  "settings": [
    {
      "name": "cookie",
      "label": "Cookie",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_cookie",
      "type": "info_cookie"
    },
    {
      "name": "useragent",
      "label": "User-Agent",
      "type": "text"
    },
    {
      "name": "info_useragent",
      "type": "info_useragent"
    },
    {
      "name": "sort",
      "label": "Sort requested from site",
      "type": "select",
      "default": "4",
      "options": {
        "4": "created",
        "7": "seeders",
        "5": "size",
        "1": "title"
      }
    },
    {
      "name": "type",
      "label": "Order requested from site",
      "type": "select",
      "default": "desc",
      "options": {
        "desc": "desc",
        "asc": "asc"
      }
    },
    {
      "name": "info_tpp",
      "label": "Results Per Page",
      "type": "info",
      "default": "For best results, change the <b>Torrents per page:</b> setting to <b>100</b> on your account profile."
    }
  ],
  "login": {
    "method": "cookie",
    "inputs": {
      "cookie": "{{ .Config.cookie }}"
    },
    "test": {
      "path": "browse/",
      "selector": "a[href*=\"logout.php?k=\"]"
    },
    "headers": {
      "User-Agent": [
        "{{ .Config.useragent }}"
      ]
    }
  },
  "search": {
    "paths": [
      {
        "path": "browse/",
        "categories": [
          "28",
          "27",
          "4",
          "3",
          "6",
          "5",
          "2",
          "1",
          "17",
          "18",
          "19",
          "25",
          "24",
          "23",
          "38",
          "26",
          "20",
          "21",
          "31",
          "9",
          "8",
          "7",
          "13",
          "12",
          "11",
          "10"
        ],
        "inputs": {
          "search": "{{ if .Query.IMDBID }}{{ .Query.IMDBID }}{{ else }}{{ .Keywords }}{{ end }}"
        }
      },
      {
        "path": "browse/xxx",
        "categories": [
          "16",
          "32",
          "14",
          "15"
        ],
        "inputs": {
          "search": "{{ .Keywords }}"
        }
      }
    ],
    "inputs": {
      "$raw": "{{ range .Categories }}c{{.}}=1&{{end}}",
      "xyz": "yes",
      "korhatar": "0",
      "incldead": "1",
      "sort": "{{ .Config.sort }}",
      "type": "{{ .Config.type }}"
    },
    "headers": {
      "User-Agent": [
        "{{ .Config.useragent }}"
      ]
    },
    "rows": {
      "selector": "table.torrent-table > tbody > tr.torrent-row"
    },
    "fields": {
      "category": {
        "selector": "a[href*=\"/?cat=\"]",
        "attribute": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "cat"
            ]
          }
        ]
      },
      "title": {
        "selector": "a.torrent-title-link",
        "attribute": "data-name"
      },
      "details": {
        "selector": "a.torrent-title-link",
        "attribute": "data-detail-url"
      },
      "download": {
        "selector": "a[href^=\"/download/\"]",
        "attribute": "href"
      },
      "genre": {
        "selector": "a[data-mufaj]",
        "attribute": "data-mufaj",
        "optional": true
      },
      "description": {
        "selector": "div.torrent-subtitle",
        "optional": true,
        "filters": [
          {
            "name": "append",
            "args": [
              "{{ if .Result.genre }}</br>{{ .Result.genre }}{{ else }}{{ end }}"
            ]
          }
        ]
      },
      "imdbid": {
        "selector": "a[href*=\"imdb.com/title/tt\"]",
        "attribute": "href",
        "optional": true
      },
      "poster": {
        "selector": "a[data-poster]",
        "attribute": "data-poster",
        "optional": true,
        "filters": [
          {
            "name": "prepend",
            "args": [
              "/"
            ]
          }
        ]
      },
      "date": {
        "selector": "a[data-added]",
        "attribute": "data-added",
        "filters": [
          {
            "name": "append",
            "args": [
              " +01:00"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "2006-01-02 15:04 -07:00",
              "2006-01-02 15:04 -0700"
            ]
          }
        ]
      },
      "size": {
        "selector": "a[data-size]",
        "attribute": "data-size"
      },
      "grabs": {
        "selector": "td:nth-last-child(3)"
      },
      "seeders": {
        "selector": "td:nth-last-child(2)"
      },
      "leechers": {
        "selector": "td:nth-last-child(1)"
      },
      "downloadvolumefactor": {
        "text": "1"
      },
      "uploadvolumefactor": {
        "text": "2"
      },
      "minimumratio": {
        "text": "1.0"
      },
      "minimumseedtime": {
        "text": "115200"
      }
    }
  },
  "source": {
    "path": "definitions/v11/huntorrent.yml",
