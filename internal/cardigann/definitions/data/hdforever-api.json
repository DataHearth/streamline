{
  "id": "hdforever-api",
  "name": "HD-Forever (API)",
  "description": "HD-Forever (HD-F) is a French private tracker dedicated to movies, TV shows, animation, documentaries, concerts, and live shows.",
  "language": "fr-FR",
  "type": "private",
  "encoding": "UTF-8",
  "followredirect": true,
  "testlinktorrent": false,
  "requestDelay": 10,
  "links": [
    "https://hdf.world/"
  ],
  "caps": {
    "categorymappings": [
      {
        "id": "1",
        "cat": "Movies",
        "desc": "Film"
      },
      {
        "id": "2",
        "cat": "Movies",
        "desc": "Film d'animation"
      },
      {
        "id": "3",
        "cat": "Movies",
        "desc": "Spectacle"
      },
      {
        "id": "4",
        "cat": "Movies",
        "desc": "Concert"
      },
      {
        "id": "5",
        "cat": "TV",
        "desc": "Série"
      },
      {
        "id": "6",
        "cat": "TV/Anime",
        "desc": "Série d'animation"
      },
      {
        "id": "7",
        "cat": "Movies",
        "desc": "Documentaire"
      }
    ],
    "modes": {
      "search": [
        "q"
      ],
      "tv-search": [
        "q",
        "season",
        "imdbid",
        "tmdbid",
        "year"
      ],
      "movie-search": [
        "q",
        "imdbid",
        "tmdbid",
        "year"
      ]
    },
    "allowtvsearchimdb": true
  },
  "settings": [
    {
      "name": "apikey",
      "label": "API key",
      "type": "password",
      "secret": true
    },
    {
      "name": "info_key",
      "label": "About your API key",
      "type": "info",
      "default": "Generate or view your API key in HD-Forever under Integrations &gt; API. Keep it private."
    },
    {
      "name": "freeleech",
      "label": "Search Freeleech torrents only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "usetoken",
      "label": "Use a Freeleech token when available",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "info_token",
      "label": "About Freeleech tokens",
      "type": "info",
      "default": "When enabled, a Freeleech token is used whenever the API reports that one can be used. Otherwise, the regular download link is kept."
    },
    {
      "name": "multilang",
      "label": "Replace MULTi in release names",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "multilanguage",
      "label": "Replace MULTi with",
      "type": "select",
      "default": "FRENCH",
      "options": {
        "FRENCH": "FRENCH",
        "MULTi.FRENCH": "MULTi.FRENCH",
        "ENGLISH": "ENGLISH",
        "MULTi.ENGLISH": "MULTi.ENGLISH",
        "VOSTFR": "VOSTFR",
        "MULTi.VOSTFR": "MULTi.VOSTFR"
      }
    },
    {
      "name": "vostfr",
      "label": "Replace VOSTFR and SUBFRENCH with ENGLISH",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "sort",
      "label": "Sort requested from HD-Forever",
      "type": "select",
      "default": "time",
      "options": {
        "time": "created",
        "seeders": "seeders",
        "size": "size"
      }
    },
    {
      "name": "order",
      "label": "Sort direction",
      "type": "select",
      "default": "desc",
      "options": {
        "desc": "descending",
        "asc": "ascending"
      }
    }
  ],
  "login": {
    "method": "get",
    "path": "api.php",
    "inputs": {
      "endpoint": "self"
    },
    "headers": {
      "X-Api-Key": [
        "{{ .Config.apikey }}"
      ]
    }
  },
  "search": {
    "paths": [
      {
        "path": "api.php",
        "response": {
          "type": "json"
        }
      }
    ],
    "inputs": {
      "endpoint": "browse",
      "searchstr": "{{ if or (.Query.IMDBID) (.Query.TMDBID) }}{{ or (.Query.IMDBID) (.Query.TMDBID) }}{{ else }}{{ .Keywords }}{{ end }}",
      "group_results": "0",
      "filter_cat": "{{ join .Categories \",\" }}",
      "order_by": "{{ .Config.sort }}",
      "order_way": "{{ .Config.order }}",
      "freetorrent": "{{ if .Config.freeleech }}1{{ else }}{{ end }}",
      "page": "1",
      "limit": "50"
    },
    "headers": {
      "X-Api-Key": [
        "{{ .Config.apikey }}"
      ]
    },
    "keywordsfilters": [
      {
        "name": "re_replace",
        "args": [
          "(?i)\\b(S\\d{2,})(?:E\\d{2,})+\\b",
          "$1"
        ],
        "engine": "regexp2"
      }
    ],
    "rows": {
      "selector": "response.results",
      "missingAttributeEqualsNoResults": true
    },
    "fields": {
      "category": {
        "selector": "categoryId"
      },
      "title_original": {
        "selector": "fileName"
      },
      "title_vostfr": {
        "selector": "fileName",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "(?i)\\b(vostfr|subfrench)\\b",
              "ENGLISH"
            ],
            "engine": "regexp2"
          }
        ]
      },
      "title_language": {
        "text": "{{ if .Config.vostfr }}{{ .Result.title_vostfr }}{{ else }}{{ .Result.title_original }}{{ end }}"
      },
      "title_multi": {
        "text": "{{ .Result.title_language }}",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "(?i)\\bMULTI(?:\\.(?:TRUEFRENCH|FRENCH|ENGLISH|VOSTFR|VF2|VFF|VFQ|VOQ|VFI|VOF))?\\b",
              "{{ .Config.multilanguage }}"
            ],
            "engine": "regexp2"
          }
        ]
      },
      "title": {
        "text": "{{ if .Config.multilang }}{{ .Result.title_multi }}{{ else }}{{ .Result.title_language }}{{ end }}"
      },
      "_groupid": {
        "selector": "groupId"
      },
      "_torrentid": {
        "selector": "torrentId"
      },
      "details": {
        "selector": "detailsUrl"
      },
      "download_regular": {
        "selector": "downloadUrl"
      },
      "download_token": {
        "selector": "downloadUrl",
        "filters": [
          {
            "name": "append",
            "args": [
              "&usetoken=1"
            ]
          }
        ]
      },
      "_canUseToken": {
        "selector": "canUseToken",
        "case": {
          "True": "{{ .True }}",
          "False": "{{ .False }}"
        }
      },
      "download": {
        "text": "{{ if and (.Config.usetoken) (.Result._canUseToken) }}{{ .Result.download_token }}{{ else }}{{ .Result.download_regular }}{{ end }}"
      },
      "imdbid": {
        "selector": "imdbId",
        "optional": true
      },
      "tmdbid": {
        "selector": "tmdbId",
        "optional": true
      },
      "date": {
        "selector": "time",
        "filters": [
          {
            "name": "dateparse",
            "args": [
              "2006-01-02 15:04:05"
            ]
          }
        ]
      },
      "files": {
        "selector": "fileCount"
      },
      "size": {
        "selector": "size"
      },
      "grabs": {
        "selector": "snatches"
      },
      "seeders": {
        "selector": "seeders"
      },
      "leechers": {
        "selector": "leechers"
      },
      "_validation": {
        "selector": "isStaffValidated",
        "case": {
          "True": "Staff validated",
          "False": "Not staff validated"
        }
      },
      "description": {
        "optional": true,
        "text": "{{ .Result._validation }}"
      },
      "downloadvolumefactor": {
        "selector": "leechType",
        "case": {
          "Freeleech": "0",
          "-75%": "0.25",
          "-50%": "0.50",
          "-25%": "0.75",
          "*": "1"
        }
      },
      "uploadvolumefactor": {
        "text": "1"
      },
      "minimumseedtime": {
        "text": "259200"
      }
    }
  },
  "source": {
    "path": "definitions/v11/hdforever-api.yml",
    "sha256": "51e64b7ffd3385689ea04ee07b32c82eae4838b0be62dd093091b143de0d81e5",
    "modified": "converted by streamline's internal/cardigann/convert: YAML to JSON; .NET regexes, substitutions, date layouts and template string literals rewritten for Go"
  },
  "regex_net": true
}
