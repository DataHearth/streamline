  "settings": [
    {
      "name": "apikey",
      "label": "API Token",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_apikey",
      "label": "About your API Token",
      "type": "info",
      "default": "Find/Generate an API key from your <a href=\"https://dirtybytes.net/\" target=\"_blank\">DirtyBytes</a> account settings page, at the <b>Security</b> tab, in the <b>API Key</b> section."
    },
    {
      "name": "passkey",
      "label": "Passkey",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_passkey",
      "label": "About your Passkey",
      "type": "info",
      "default": "Find the <b>Passkey</b> just above the <i>API key</i> section."
    },
    {
      "name": "freeleech",
      "label": "Search freeleech only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "sort",
      "label": "Sort requested from site",
      "type": "select",
      "default": "d",
      "options": {
        "d": "created",
        "up": "seeders",
        "s": "size",
        "n": "title"
      }
    },
    {
      "name": "type",
      "label": "Order requested from site",
      "type": "select",
      "default": "desc",
      "options": {
        "desc": "desc",
        "asc": "asc"
      }
    }
  ],
  "login": {
    "method": "get",
    "path": "api/v1/torrents",
    "inputs": {
      "limit": "1"
    }
  },
  "search": {
    "paths": [
      {
        "path": "api/v1/torrents",
        "response": {
          "type": "json"
        }
      }
    ],
    "inputs": {
      "$raw": "{{ range .Categories }}categories[]={{.}}&{{end}}",
      "index": "0",
      "limit": "100",
      "page": "search",
      "searchText": "{{ .Keywords }}",
      "section": "all",
      "sort": "{{ .Config.sort }}",
      "order": "{{ .Config.type }}",
      "freeleech": "{{ if .Config.freeleech }}true{{ else }}{{ end }}",
      "dead": "true"
    },
    "headers": {
      "Authorization": [
        "Bearer {{ .Config.apikey }}"
      ]
    },
    "rows": {
      "selector": "$"
    },
    "fields": {
      "category": {
        "selector": "category"
      },
      "_id": {
        "selector": "id"
      },
      "title": {
        "selector": "name"
      },
      "details": {
        "text": "{{ .Config.sitelink }}torrent/{{ .Result._id }}"
      },
      "download": {
        "text": "{{ .Config.sitelink }}api/v1/torrents/download/{{ .Result._id }}/{{ .Config.passkey }}"
      },
      "poster": {
        "selector": "firstpic"
      },
      "size": {
        "selector": "size"
      },
      "files": {
        "selector": "numfiles"
      },
      "seeders": {
        "selector": "seeders"
      },
      "leechers": {
        "selector": "leechers"
      },
      "grabs": {
        "selector": "times_completed"
      },
      "date": {
        "selector": "added",
        "filters": [
          {
            "name": "append",
            "args": [
              " +02:00"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "2006-01-02 15:04:05 -07:00",
              "2006-01-02 15:04:05 -0700"
            ]
          }
        ]
      },
      "downloadvolumefactor": {
        "selector": "frileech"
      },
      "uploadvolumefactor": {
        "text": "1"
      },
      "minimumratio": {
        "text": "1.0"
      },
      "minimumseedtime": {
        "text": "432000"
      }
    }
  },
  "source": {
    "path": "definitions/v11/dirtybytes-api.yml",
