  "settings": [
    {
      "name": "username",
      "label": "Username",
      "type": "text"
    },
    {
      "name": "password",
      "label": "Password",
      "type": "password",
      "secret": true
    },
    {
      "name": "info_tpp",
      "label": "Results Per Page",
      "type": "info",
      "default": "For best results, change the <b>Torrents per page:</b> setting to <b>100</b> on your account profile."
    }
  ],
  "login": {
    "method": "form",
    "path": "login.php",
    "form": "form[action=\"takelogin.php\"]",
    "captcha": {
      "type": "image",
      "selector": "img.cimage",
      "input": "captcha"
    },
    "inputs": {
      "username": "{{ .Config.username }}",
      "password": "{{ .Config.password }}"
    },
    "test": {
      "path": "index.php",
      "selector": "a[href=\"logout.php\"]"
    }
  },
  "search": {
    "paths": [
      {
        "path": "browse.php"
      }
    ],
    "inputs": {
      "f": "1",
      "search": "{{ .Keywords }}",
      "cat": "0",
      "intitle": "1"
    },
    "rows": {
      "selector": "div.bv-switch ~ div.torrenttable-scroll > table > tbody > tr:has(td.tt-name)"
    },
    "fields": {
      "category": {
        "selector": "a[href^=\"browse.php?cat=\"]",
        "attribute": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "cat"
            ]
          }
        ]
      },
      "_bg": {
        "selector": "img[alt=\"BG audio\"]",
        "attribute": "alt",
        "optional": true
      },
      "title": {
        "selector": "a[href^=\"details.php?id=\"]",
        "filters": [
          {
            "name": "append",
            "args": [
              "{{ if .Result._bg }} (BG audio){{ else }}{{ end }}"
            ]
          }
        ]
      },
      "details": {
        "selector": "a[href^=\"details.php?id=\"]",
        "attribute": "href"
      },
      "_id": {
        "selector": "a[href^=\"details.php?id=\"]",
        "attribute": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "id"
            ]
          }
        ]
      },
      "download": {
        "attribute": "href",
        "text": "download.php?torrent={{ .Result._id }}"
      },
      "poster": {
        "selector": "span.tb-pv-img img",
        "attribute": "src"
      },
      "date_day": {
        "selector": "td[data-l=\"Added\"]:contains(\"day\"), td[data-l=\"Added\"]:contains(\"Днес\"), td[data-l=\"Added\"]:contains(\"Вчера\"), td[data-l=\"Добавен\"]:contains(\"day\"), td[data-l=\"Добавен\"]:contains(\"Днес\"), td[data-l=\"Добавен\"]:contains(\"Вчера\")",
        "optional": true,
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "(?i)Днес",
              "Today"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)Вчера",
              "Yesterday"
            ]
          }
        ]
      },
      "date_year": {
        "selector": "td[data-l=\"Added\"]:not(:contains(\"day\")):not(:contains(\"Днес\")):not(:contains(\"Вчера\")), td[data-l=\"Добавен\"]:not(:contains(\"day\")):not(:contains(\"Днес\")):not(:contains(\"Вчера\"))",
        "optional": true,
        "filters": [
          {
            "name": "dateparse",
            "args": [
              "Jan 02 2006 03:04 PM",
              "Jan 02 2006 03:04 pm"
            ]
          }
        ]
      },
      "date": {
        "text": "{{ if or .Result.date_day .Result.date_year }}{{ or .Result.date_day .Result.date_year }}{{ else }}now{{ end }}"
      },
      "files": {
        "selector": "td[data-l=\"Files\"], td[data-l=\"Файлове\"]"
      },
      "size": {
        "selector": "td[data-l=\"Size\"], td[data-l=\"Размер\"]"
      },
      "seeders": {
        "selector": "td[data-l=\"Seeders\"], td[data-l=\"Сийдъри\"]"
      },
      "leechers": {
        "selector": "td[data-l=\"Leechers\"], td[data-l=\"Лийчъри\"]"
      },
      "grabs": {
        "selector": "td[data-l=\"Snatched\"], td[data-l=\"Изтеглен\"]"
      },
      "downloadvolumefactor": {
        "case": {
          "span:contains(\"FREE\")": "0",
          "*": "1"
        }
      },
      "uploadvolumefactor": {
        "text": "1"
      },
      "minimumseedtime": {
        "text": "259200"
      }
    }
  },
  "source": {
    "path": "definitions/v11/alabala.yml",
