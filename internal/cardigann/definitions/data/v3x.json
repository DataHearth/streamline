      ],
      "book-search": [
        "q"
      ]
    },
    "allowrawsearch": true
  },
  "settings": [
    {
      "name": "apikey",
      "label": "API Key",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_key",
      "label": "About your API key",
      "type": "info",
      "default": "Create your API key on V3X in <b>Réglages -> Intégrations</b> (needs the torznab scope)."
    },
    {
      "name": "apiurl",
      "label": "API URL",
      "type": "text",
      "default": "api.v3x.club"
    },
    {
      "name": "multilang",
      "label": "Replace MULTi by another language in release name",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "multilanguage",
      "label": "Replace MULTi by this language",
      "type": "select",
      "default": "FRENCH",
      "options": {
        "FRENCH": "FRENCH",
        "MULTi.FRENCH": "MULTi.FRENCH",
        "ENGLISH": "ENGLISH",
        "MULTi.ENGLISH": "MULTi.ENGLISH",
        "VOSTFR": "VOSTFR",
        "MULTi.VOSTFR": "MULTi.VOSTFR"
      }
    },
    {
      "name": "vostfr",
      "label": "Replace VOSTFR and SUBFRENCH with ENGLISH",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "freeleech",
      "label": "Search freeleech only",
      "type": "checkbox",
      "default": "false"
    }
  ],
  "login": {
    "method": "get",
    "path": "https://{{ .Config.apiurl }}/indexer/search",
    "inputs": {
      "apikey": "{{ .Config.apikey }}",
      "limit": "1"
    }
  },
  "search": {
    "paths": [
      {
        "path": "https://{{ .Config.apiurl }}/indexer/search",
        "response": {
          "type": "json"
        }
      }
    ],
    "inputs": {
      "apikey": "{{ .Config.apikey }}",
      "q": "{{ .Keywords }}",
      "cat": "{{ join .Categories \",\" }}",
      "tmdbid": "{{ .Query.TMDBID }}",
      "season": "{{ .Query.Season }}",
      "ep": "{{ .Query.Ep }}",
      "freeleech": "{{ if .Config.freeleech }}1{{ else }}0{{ end }}",
      "limit": "100"
    },
    "rows": {
      "selector": "results"
    },
    "fields": {
      "category_main": {
        "selector": "category"
      },
      "category_sub": {
        "selector": "subcategory",
        "optional": true
      },
      "category": {
        "text": "{{ if .Result.category_sub }}{{ .Result.category_sub }}{{ else }}{{ .Result.category_main }}{{ end }}"
      },
      "title_phase1": {
        "selector": "title"
      },
      "title_vostfr": {
        "text": "{{ .Result.title_phase1 }}",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "(?i)\\b(vostfr|subfrench)\\b",
              "ENGLISH"
            ],
            "engine": "regexp2"
          }
        ]
      },
      "title_phase2": {
        "text": "{{ if .Config.vostfr }}{{ .Result.title_vostfr }}{{ else }}{{ .Result.title_phase1 }}{{ end }}"
      },
      "title_multilang": {
        "text": "{{ .Result.title_phase2 }}",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "(?i)\\b(MULTI(?!.*(?:FRENCH|ENGLISH|VOSTFR|VF2|VFF|VFQ|VOQ|VFI|VOF)))\\b",
              "{{ .Config.multilanguage }}"
            ],
            "engine": "regexp2"
          }
        ]
      },
      "title": {
        "text": "{{ if .Config.multilang }}{{ .Result.title_multilang }}{{ else }}{{ .Result.title_phase2 }}{{ end }}"
      },
      "details": {
        "selector": "details"
      },
      "download": {
        "selector": "download"
      },
      "infohash": {
        "selector": "infohash"
      },
      "tmdbid": {
        "selector": "tmdbid",
        "optional": true
      },
      "date": {
        "selector": "pubdate",
        "filters": [
          {
            "name": "append",
            "args": [
              " +00:00"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "01/02/2006 15:04:05 -07:00",
              "01/02/2006 15:04:05 -0700"
            ]
          }
        ]
      },
      "size": {
        "selector": "size"
      },
      "seeders": {
        "selector": "seeders"
      },
      "leechers": {
        "selector": "leechers"
      },
      "grabs": {
        "selector": "grabs"
      },
      "downloadvolumefactor": {
        "selector": "downloadvolumefactor"
      },
      "uploadvolumefactor": {
        "selector": "uploadvolumefactor"
      },
      "minimumratio": {
        "text": "0.8"
      }
    }
  },
  "source": {
    "path": "definitions/v11/v3x.yml",
