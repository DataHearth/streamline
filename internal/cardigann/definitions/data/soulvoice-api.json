{
  "id": "soulvoice-api",
  "name": "SoulVoice (聆音Club) (API)",
  "description": "SoulVoice (聆音Club) is a CHINESE Private Torrent Tracker for MOVIES / TV / GENERAL",
  "language": "zh-CN",
  "type": "private",
  "encoding": "UTF-8",
  "links": [
    "https://pt.soulvoice.club/"
  ],
  "caps": {
    "categorymappings": [
      {
        "id": "401",
        "cat": "Movies",
        "desc": "Movies/电影"
      },
      {
        "id": "402",
        "cat": "TV",
        "desc": "TV Series/电视剧"
      },
      {
        "id": "403",
        "cat": "TV",
        "desc": "TV Show/综艺"
      },
      {
        "id": "404",
        "cat": "TV/Documentary",
        "desc": "Documentaries/纪录片"
      },
      {
        "id": "405",
        "cat": "TV/Anime",
        "desc": "Animations/动漫"
      },
      {
        "id": "406",
        "cat": "Audio/Video",
        "desc": "MusicVideo/音乐视频"
      },
      {
        "id": "407",
        "cat": "Other",
        "desc": "Study/教学"
      },
      {
        "id": "408",
        "cat": "Audio",
        "desc": "HQ Audio/音乐"
      },
      {
        "id": "409",
        "cat": "Other",
        "desc": "其它 (Other)"
      }
    ],
    "modes": {
      "search": [
        "q"
      ],
      "tv-search": [
        "q",
        "season",
        "ep"
      ],
      "movie-search": [
        "q"
      ],
      "music-search": [
        "q"
      ]
    }
  },
  "settings": [
    {
      "name": "apikey",
      "label": "API Token",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_apikey",
      "label": "About your API Token",
      "type": "info",
      "default": "Find/Generate an API token from your <a href=\"https://pt.soulvoice.club/usercp.php\" target=\"_blank\">SoulVoice</a> account control panel."
    },
    {
      "name": "passkey",
      "label": "Passkey",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_passkey",
      "label": "About your Passkey",
      "type": "info",
      "default": "Find the Passkey from your account control panel."
    },
    {
      "name": "freeleech",
      "label": "Filter freeleech only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "sort",
      "label": "Sort requested from site",
      "type": "select",
      "default": "-id",
      "options": {
        "-id": "created",
        "-seeders": "seeders",
        "-size": "size",
        "-times_completed": "grabs"
      }
    },
    {
      "name": "info_activity",
      "label": "Account Inactivity",
      "type": "info",
      "default": "Account retention rules:<ol><li>Veteran Users users and above will be retained forever</li><li>Elite Users and above will not have their account deleted after parking (in the Control Panel)</li><li>Users with a parked account will be deleted if they do not log in for 180 consecutive days</li><li>Users with a non-parked account will be banned if they do not log in for 60 consecutive days</li><li>Users with no traffic (ie, upload/download data are both 0) will be banned if they do not log in for 7 consecutive days.</li></ol>"
    }
  ],
  "login": {
    "method": "get",
    "path": "api/v1/torrents",
    "inputs": {
      "per_page": "1"
    },
    "error": [
      {
        "selector": ":root:contains(\"login.php?returnto\")",
        "message": {
          "text": "The API token was not accepted by {{ .Config.sitelink }}."
        }
      },
      {
        "selector": ":root:contains(\"Unauthenticated\")",
        "message": {
          "text": "The API token was not accepted by {{ .Config.sitelink }}."
        }
      }
    ]
  },
  "search": {
    "paths": [
      {
        "path": "api/v1/torrents",
        "response": {
          "type": "json"
        }
      }
    ],
    "inputs": {
      "$raw": "{{ range .Categories }}&filter[category][in][]={{.}}{{end}}",
      "filter[title]": "{{ .Keywords }}",
      "sorts": "{{ .Config.sort }}",
      "per_page": "100"
    },
    "headers": {
      "Authorization": [
        "Bearer {{ .Config.apikey }}"
      ]
    },
    "keywordsfilters": [
      {
        "name": "re_replace",
        "args": [
          "\\.",
          " "
        ]
      }
    ],
    "rows": {
      "selector": "data.data{{ if .Config.freeleech }}:not(promotion_info.down_multiplier:contains(1)):not(promotion_info.down_multiplier:contains(.)){{ else }}{{ end }}"
    },
    "fields": {
      "category": {
        "selector": "category"
      },
      "_id": {
        "selector": "id"
      },
      "title": {
        "selector": "name"
      },
      "details": {
        "text": "{{ .Config.sitelink }}details.php?id={{ .Result._id }}&hit=1"
      },
      "download": {
        "text": "{{ .Config.sitelink }}download.php?id={{ .Result._id }}&passkey={{ .Config.passkey }}"
      },
      "infohash": {
        "selector": "hash"
      },
      "poster": {
        "selector": "cover"
      },
      "description": {
        "selector": "small_descr"
      },
      "size": {
        "selector": "size"
      },
      "files": {
        "selector": "numfiles"
      },
      "seeders": {
        "selector": "seeders"
      },
      "leechers": {
        "selector": "leechers"
      },
      "grabs": {
        "selector": "times_completed"
      },
      "date": {
        "selector": "added",
        "filters": [
          {
            "name": "append",
            "args": [
              " +08:00"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "2006-01-02 15:04 -07:00",
              "2006-01-02 15:04 -0700"
            ]
          }
        ]
      },
      "downloadvolumefactor": {
        "selector": "promotion_info.down_multiplier"
      },
      "uploadvolumefactor": {
        "selector": "promotion_info.up_multiplier"
      },
      "minimumratio": {
        "text": "2.0"
      },
      "minimumseedtime": {
        "text": "259200"
      }
    }
  },
  "source": {
    "path": "definitions/v11/soulvoice-api.yml",
    "sha256": "e4bd976d321821c908348967415b9f3d7eb79858c65dcc5559cba4db2e9f84e4",
    "modified": "converted by streamline's internal/cardigann/convert: YAML to JSON; .NET regexes, substitutions, date layouts and template string literals rewritten for Go"
  }
}
