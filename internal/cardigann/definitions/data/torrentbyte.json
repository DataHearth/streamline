{
  "id": "torrentbyte",
  "name": "TorrentByte",
  "description": "TorrentByte is a Public DHT Crawler",
  "language": "en-US",
  "type": "public",
  "encoding": "UTF-8",
  "links": [
    "https://torrentbyte.cc/"
  ],
  "caps": {
    "categorymappings": [
      {
        "id": "Movies",
        "cat": "Movies",
        "desc": "Movies"
      },
      {
        "id": "TV",
        "cat": "TV",
        "desc": "TV"
      },
      {
        "id": "Games",
        "cat": "PC/Games",
        "desc": "Games"
      },
      {
        "id": "Anime",
        "cat": "TV/Anime",
        "desc": "Anime"
      },
      {
        "id": "Music",
        "cat": "Audio",
        "desc": "Music"
      },
      {
        "id": "Software",
        "cat": "PC/0day",
        "desc": "Software"
      },
      {
        "id": "XXX",
        "cat": "XXX",
        "desc": "XXX"
      },
      {
        "id": "Other",
        "cat": "Other",
        "desc": "Other"
      }
    ],
    "modes": {
      "search": [
        "q"
      ],
      "tv-search": [
        "q",
        "season",
        "ep"
      ],
      "movie-search": [
        "q"
      ],
      "music-search": [
        "q"
      ]
    }
  },
  "settings": [
    {
      "name": "info_flaresolverr",
      "type": "info_flaresolverr"
    }
  ],
  "search": {
    "paths": [
      {
        "path": "/"
      }
    ],
    "inputs": {
      "q": "{{ .Keywords }}"
    },
    "rows": {
      "selector": "table > tbody > tr:not(:contains(\"No matching torrent records found.\"))"
    },
    "fields": {
      "category": {
        "selector": "td:nth-child(2)"
      },
      "title": {
        "selector": "td:nth-child(1)",
        "attribute": "title"
      },
      "details": {
        "selector": "a[href^=\"?view=\"]",
        "attribute": "href"
      },
      "infohash": {
        "selector": "a[href^=\"magnet:?xt=\"]",
        "attribute": "href",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "btih:([A-F|a-f|0-9]{40})"
            ]
          }
        ]
      },
      "size": {
        "selector": "td:nth-child(3)"
      },
      "files": {
        "selector": "td:nth-child(4)"
      },
      "date": {
        "selector": "td:nth-child(5)",
        "filters": [
          {
            "name": "append",
            "args": [
              " +02:00"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "2006-01-02 15:04:05 -07:00",
              "2006-01-02 15:04:05 -0700"
            ]
          }
        ]
      },
      "seeders": {
        "text": "1"
      },
      "leechers": {
        "text": "1"
      },
      "downloadvolumefactor": {
        "text": "0"
      },
      "uploadvolumefactor": {
        "text": "1"
      },
      "description": {
        "selector": "td:nth-child(6)",
        "optional": true,
        "remove": "a"
      }
    }
  },
  "source": {
    "path": "definitions/v11/torrentbyte.yml",
    "sha256": "1f17aa80631d538077575099392821fb854aad2b22f68137e12048edc1315ce3",
    "modified": "converted by streamline's internal/cardigann/convert: YAML to JSON; .NET regexes, substitutions, date layouts and template string literals rewritten for Go"
  }
}
