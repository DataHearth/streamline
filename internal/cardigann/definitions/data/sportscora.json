{
  "id": "sportscora",
  "name": "SportsCora (API)",
  "description": "SportsCora is a Private Torrent Tracker for SPORTS",
  "language": "en-US",
  "type": "private",
  "encoding": "UTF-8",
  "links": [
    "https://sportscora.com/"
  ],
  "caps": {
    "categorymappings": [
      {
        "id": "1",
        "cat": "Movies",
        "desc": "Movie"
      },
      {
        "id": "2",
        "cat": "TV",
        "desc": "TV"
      },
      {
        "id": "3",
        "cat": "Audio",
        "desc": "Music"
      },
      {
        "id": "4",
        "cat": "Console",
        "desc": "Game"
      },
      {
        "id": "5",
        "cat": "PC",
        "desc": "Application"
      }
    ],
    "modes": {
      "search": [
        "q"
      ],
      "tv-search": [
        "q",
        "season",
        "ep",
        "imdbid",
        "tvdbid",
        "tmdbid"
      ],
      "movie-search": [
        "q",
        "imdbid",
        "tmdbid"
      ],
      "music-search": [
        "q"
      ]
    }
  },
  "settings": [
    {
      "name": "apikey",
      "label": "APIKey",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_key",
      "label": "About your API key",
      "type": "info",
      "default": "Find or Generate a new API Token by accessing your <a href=\"https://sportscora.com/\" target=\"_blank\">SportsCora</a> account <i>My Security</i> page and clicking on the <b>API Token</b> tab."
    },
    {
      "name": "freeleech",
      "label": "Search freeleech only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "sort",
      "label": "Sort requested from site",
      "type": "select",
      "default": "created_at",
      "options": {
        "created_at": "created",
        "seeders": "seeders",
        "size": "size",
        "name": "title"
      }
    },
    {
      "name": "type",
      "label": "Order requested from site",
      "type": "select",
      "default": "desc",
      "options": {
        "desc": "desc",
        "asc": "asc"
      }
    }
  ],
  "login": {
    "method": "get",
    "path": "api/torrents",
    "error": [
      {
        "selector": "a[href*=\"/login\"]",
        "message": {
          "text": "The API key was not accepted by {{ .Config.sitelink }}."
        }
      },
      {
        "selector": ":root:contains(\"Account is Banned\")"
      }
    ],
    "headers": {
      "Authorization": [
        "Bearer {{ .Config.apikey }}"
      ]
    }
  },
  "search": {
    "paths": [
      {
        "path": "api/torrents/filter",
        "response": {
          "type": "json"
        }
      }
    ],
    "inputs": {
      "$raw": "{{ range .Categories }}&categories[]={{.}}{{end}}",
      "name": "{{ .Keywords }}",
      "imdbId": "{{ .Query.IMDBIDShort }}",
      "tmdbId": "{{ .Query.TMDBID }}",
      "tvdbId": "{{ .Query.TVDBID }}",
      "free": "{{ if .Config.freeleech }}1{{ else }}{{ end }}",
      "sortField": "{{ .Config.sort }}",
      "sortDirection": "{{ .Config.type }}",
      "perPage": "100"
    },
    "headers": {
      "Authorization": [
        "Bearer {{ .Config.apikey }}"
      ]
    },
    "keywordsfilters": [
      {
        "name": "re_replace",
        "args": [
          "\\.",
          " "
        ]
      }
    ],
    "rows": {
      "selector": "data",
      "attribute": "attributes"
    },
    "fields": {
      "_id": {
        "selector": "..id"
      },
      "categorydesc": {
        "selector": "category"
      },
      "title": {
        "selector": "name"
      },
      "details": {
        "text": "{{ .Config.sitelink }}torrents/{{ .Result._id }}"
      },
      "download": {
        "selector": "download_link"
      },
      "imdbid": {
        "selector": "imdb_id",
        "optional": true
      },
      "tmdbid": {
        "selector": "tmdb_id",
        "optional": true
      },
      "tvdbid": {
        "selector": "tvdb_id",
        "optional": true
      },
      "files": {
        "selector": "num_file"
      },
      "seeders": {
        "selector": "seeders"
      },
      "leechers": {
        "selector": "leechers"
      },
      "grabs": {
        "selector": "times_completed"
      },
      "date": {
        "selector": "created_at",
        "filters": [
          {
            "name": "append",
            "args": [
              " +00:00"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "01/02/2006 15:04:05 -07:00",
              "01/02/2006 15:04:05 -0700"
            ]
          }
        ]
      },
      "size": {
        "selector": "size"
      },
      "downloadvolumefactor": {
        "selector": "freeleech",
        "case": {
          "No": "1",
          "Yes": "0"
        }
      },
      "uploadvolumefactor": {
        "selector": "double_upload",
        "case": {
          "No": "1",
          "Yes": "2"
        }
      },
      "minimumseedtime": {
        "text": "86400"
      }
    }
  },
  "source": {
    "path": "definitions/v11/sportscora.yml",
    "sha256": "2a765143623d3758733a24daee59dabde8d9599068da14d1e08ead6331b045a4",
    "modified": "converted by streamline's internal/cardigann/convert: YAML to JSON; .NET regexes, substitutions, date layouts and template string literals rewritten for Go"
  }
}
