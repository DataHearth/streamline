  "name": "Boxing Torrents",
  "description": "Boxing Torrents is a Private Torrent Tracker for BOXING",
  "language": "en-US",
  "type": "private",
  "encoding": "UTF-8",
  "links": [
    "https://tc-boxing.com/"
  ],
  "caps": {
    "categorymappings": [
