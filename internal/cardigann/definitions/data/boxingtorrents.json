      }
    ],
    "modes": {
      "search": [
        "q"
      ],
      "tv-search": [
        "q",
        "season",
        "ep"
      ]
    }
  },
  "settings": [
    {
      "name": "cookie",
      "label": "Cookie",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_cookie",
      "type": "info_cookie"
    },
    {
      "name": "freeleech",
      "label": "Search freeleech only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "info_download",
      "label": "Download Restrictions",
      "type": "info",
      "default": "You must have uploaded at least 10GB before you are able to access all torrent sizes. Until then, you are restricted to torrents no larger than 2.5GB."
    }
  ],
  "login": {
    "method": "cookie",
    "inputs": {
      "cookie": "{{ .Config.cookie }}"
    },
    "test": {
      "path": "browse.php",
      "selector": "a[href=\"logout.php\"]"
    }
  },
  "search": {
    "paths": [
      {
        "path": "browse.php"
      }
    ],
    "inputs": {
      "$raw": "{{ if .Categories }}{{ range .Categories }}c{{.}}=1&{{end}}{{ else }}cat=0{{ end }}",
      "incldead": "1",
      "free": "{{ if .Config.freeleech }}1{{ else }}{{ end }}",
      "search": "{{ .Keywords }}"
    },
    "rows": {
      "dateheaders": {
        "selector": "td[colspan] > b",
        "filters": [
          {
            "name": "append",
            "args": [
              " -07:00"
            ]
          },
          {
            "name": "replace",
            "args": [
              "Torrents added ",
              ""
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "Monday, 2. Jan, 2006 -07:00",
              "Monday, 2. Jan, 2006 -0700"
            ]
          }
        ]
      },
      "selector": "table.torrenttable > tbody > tr:has(a[href^=\"details.php?id=\"])",
      "filters": [
        {
          "name": "andmatch"
        }
      ]
    },
    "fields": {
      "category": {
        "selector": "a[href^=\"browse.php?cat=\"]",
        "attribute": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "cat"
            ]
          }
        ]
      },
      "title": {
        "selector": "a[href^=\"details.php?id=\"]"
      },
      "details": {
        "selector": "a[href^=\"details.php?id=\"]",
        "attribute": "href"
      },
      "download": {
        "selector": "a[href^=\"details.php?id=\"]",
        "attribute": "href"
      },
      "files": {
        "selector": "td:nth-last-child(7)"
      },
      "size": {
        "selector": "td:nth-last-child(5)"
      },
      "grabs": {
        "selector": "td:nth-last-child(4)"
      },
      "seeders": {
        "selector": "td:nth-last-child(3)"
      },
      "leechers": {
        "selector": "td:nth-last-child(2)"
      },
      "downloadvolumefactor": {
        "case": {
          "b:contains(\"FreeLeech\")": "0",
          "*": "1"
        }
      },
      "uploadvolumefactor": {
        "text": "1"
      },
      "minimumratio": {
        "text": "1.0"
      },
      "minimumseedtime": {
        "text": "259200"
      }
    }
  },
  "download": {
    "selectors": [
      {
        "selector": "a[href^=\"download.php\"]",
        "attribute": "href"
      }
    ]
  },
  "source": {
    "path": "definitions/v11/boxingtorrents.yml",
