  "id": "postman",
  "name": "Postman",
  "description": "Postman is a Public I2P Torrent Tracker for MOVIES / TV / GENERAL",
  "language": "en-US",
  "type": "public",
  "encoding": "UTF-8",
  "requestDelay": 4,
  "links": [
    "http://tracker2.postman.i2p/"
  ],
  "caps": {
