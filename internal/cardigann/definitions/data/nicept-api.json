{
  "id": "nicept-api",
  "name": "NicePT (API)",
  "description": "NicePT is a CHINESE Private Torrent Tracker for 3X",
  "language": "zh-CN",
  "type": "private",
  "encoding": "UTF-8",
  "links": [
    "https://www.nicept.net/"
  ],
  "caps": {
    "categorymappings": [
      {
        "id": "500",
        "cat": "XXX",
        "desc": "日本有码"
      },
      {
        "id": "401",
        "cat": "XXX",
        "desc": "日本无码"
      },
      {
        "id": "402",
        "cat": "XXX",
        "desc": "欧美"
      },
      {
        "id": "501",
        "cat": "XXX",
        "desc": "其他（限制级）"
      },
      {
        "id": "403",
        "cat": "XXX/Other",
        "desc": "动漫（限制级）"
      },
      {
        "id": "503",
        "cat": "XXX",
        "desc": "真人秀，自拍（限制级）"
      },
      {
        "id": "404",
        "cat": "XXX/ImageSet",
        "desc": "写真、套图"
      },
      {
        "id": "504",
        "cat": "XXX",
        "desc": "SM调教（限制级）"
      }
    ],
    "modes": {
      "search": [
        "q"
      ]
    }
  },
  "settings": [
    {
      "name": "apikey",
      "label": "API Token",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_apikey",
      "label": "About your API Token",
      "type": "info",
      "default": "Find/Generate an API token from your <a href=\"https://www.nicept.net/usercp.php\" target=\"_blank\">NicePT</a> account control panel."
    },
    {
      "name": "passkey",
      "label": "Passkey",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_passkey",
      "label": "About your Passkey",
      "type": "info",
      "default": "Find the Passkey from your account control panel."
    },
    {
      "name": "freeleech",
      "label": "Filter freeleech only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "sort",
      "label": "Sort requested from site",
      "type": "select",
      "default": "-id",
      "options": {
        "-id": "created",
        "-seeders": "seeders",
        "-size": "size",
        "-times_completed": "grabs"
      }
    },
    {
      "name": "info_activity",
      "label": "Account Inactivity",
      "type": "info",
      "default": "Account retention rules:<ol><li>Veteran Users users and above will be retained forever</li><li>Elite Users and above will not have their account deleted after parking (in the Control Panel)</li><li>Users with a parked account will be deleted if they do not log in for 400 consecutive days</li><li>Users with a non-parked account will be banned if they do not log in for 40 consecutive days</li><li>Users with no traffic (ie, upload/download data are both 0) will be banned if they do not log in for 7 consecutive days.</li></ol>"
    }
  ],
  "login": {
    "method": "get",
    "path": "api/v1/torrents",
    "inputs": {
      "per_page": "1"
    },
    "error": [
      {
        "selector": ":root:contains(\"login.php?returnto\")",
        "message": {
          "text": "The API token was not accepted by {{ .Config.sitelink }}."
        }
      },
      {
        "selector": ":root:contains(\"Unauthenticated\")",
        "message": {
          "text": "The API token was not accepted by {{ .Config.sitelink }}."
        }
      }
    ]
  },
  "search": {
    "paths": [
      {
        "path": "api/v1/torrents",
        "response": {
          "type": "json"
        }
      }
    ],
    "inputs": {
      "$raw": "{{ range .Categories }}&filter[category][in][]={{.}}{{end}}",
      "filter[title]": "{{ .Keywords }}",
      "sorts": "{{ .Config.sort }}",
      "per_page": "100"
    },
    "headers": {
      "Authorization": [
        "Bearer {{ .Config.apikey }}"
      ]
    },
    "keywordsfilters": [
      {
        "name": "re_replace",
        "args": [
          "\\.",
          " "
        ]
      }
    ],
    "rows": {
      "selector": "data.data{{ if .Config.freeleech }}:not(promotion_info.down_multiplier:contains(1)):not(promotion_info.down_multiplier:contains(.)){{ else }}{{ end }}"
    },
    "fields": {
      "category": {
        "selector": "category"
      },
      "_id": {
        "selector": "id"
      },
      "title": {
        "selector": "name"
      },
      "details": {
        "text": "{{ .Config.sitelink }}details.php?id={{ .Result._id }}&hit=1"
      },
      "download": {
        "text": "{{ .Config.sitelink }}download.php?id={{ .Result._id }}&passkey={{ .Config.passkey }}"
      },
      "infohash": {
        "selector": "hash"
      },
      "poster": {
        "selector": "cover"
      },
      "description": {
        "selector": "small_descr"
      },
      "size": {
        "selector": "size"
      },
      "files": {
        "selector": "numfiles"
      },
      "seeders": {
        "selector": "seeders"
      },
      "leechers": {
        "selector": "leechers"
      },
      "grabs": {
        "selector": "times_completed"
      },
      "date": {
        "selector": "added",
        "filters": [
          {
            "name": "append",
            "args": [
              " +08:00"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "2006-01-02 15:04 -07:00"
            ]
          }
        ]
      },
      "downloadvolumefactor": {
        "selector": "promotion_info.down_multiplier"
      },
      "uploadvolumefactor": {
        "selector": "promotion_info.up_multiplier"
      },
      "minimumratio": {
        "text": "1.0"
      },
      "minimumseedtime": {
        "text": "259200"
      }
    }
  },
  "source": {
    "path": "definitions/v11/nicept-api.yml",
    "sha256": "ddeefce8c253b1a001ded6ecc688c68608dda4a03b8b0b862c2b798cd1382319",
    "modified": "converted by streamline's internal/cardigann/convert: YAML to JSON; .NET regexes, substitutions, date layouts and template string literals rewritten for Go"
  }
}
