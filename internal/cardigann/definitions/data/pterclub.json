{
  "id": "pterclub",
  "name": "PTerClub (PT之友俱乐部)",
  "description": "PTerClub (PT之友俱乐部) is a CHINESE Private Torrent Tracker for HD MUSIC VIDEOS / MOVIES / TV / ANIME",
  "language": "zh-CN",
  "type": "private",
  "encoding": "UTF-8",
  "links": [
    "https://pterclub.net/"
  ],
  "legacylinks": [
    "https://pterclub.com/"
  ],
  "caps": {
