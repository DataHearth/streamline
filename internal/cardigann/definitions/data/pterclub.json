        "desc": "学习 (Study)"
      },
      {
        "id": "412",
        "cat": "Other",
        "desc": "其它 (Other)"
      }
    ],
    "modes": {
      "search": [
        "q"
      ],
      "tv-search": [
        "q",
        "season",
        "ep",
        "imdbid",
        "doubanid"
      ],
      "movie-search": [
        "q",
        "imdbid",
        "doubanid"
      ],
      "music-search": [
        "q"
      ],
      "book-search": [
        "q"
      ]
    }
  },
  "settings": [
    {
      "name": "cookie",
      "label": "Cookie",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_cookie",
      "type": "info_cookie"
    },
    {
      "name": "useragent",
      "label": "User-Agent",
      "type": "text"
    },
    {
      "name": "info_useragent",
      "type": "info_useragent"
    },
    {
      "name": "freeleech",
      "label": "Search freeleech only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "sort",
      "label": "Sort requested from site",
      "type": "select",
      "default": "4",
      "options": {
        "4": "created",
        "7": "seeders",
        "5": "size",
        "1": "title"
      }
    },
    {
      "name": "type",
      "label": "Order requested from site",
      "type": "select",
      "default": "desc",
      "options": {
        "desc": "desc",
        "asc": "asc"
      }
    },
    {
      "name": "info_tpp",
      "label": "Results Per Page",
      "type": "info",
      "default": "For best results, change the <b>Torrents per page:</b> setting to <b>100</b> on your account profile."
    },
    {
      "name": "info_activity",
      "label": "Account Inactivity",
      "type": "info",
      "default": "Account retention rules:<ol><li>All accounts will be permanently protected and will not be deleted; however, due to site security, some users will be temporarily banned due to activity rules</li><li>New users with no traffic changes will be disabled after 7 days of registration (not the actual download volume)</li><li>Those who download free torrents without generating any upload volume, or simply auxiliary torrents that generate magic power without any uploads will still be banned</li><li>Users with a non-parked account will be disabled if they do not log in for 60 consecutive days</li><li>Users with a parked account will be disabled if they do not log in for 180 consecutive days</li><li>Angora/Veteran User and above will not be disabled after parking</li><li>Sichuan Jianzhou Cat/Nexus Master users and above will be retained forever.</li></ol>"
    }
  ],
  "login": {
    "method": "cookie",
    "inputs": {
      "cookie": "{{ .Config.cookie }}"
    },
    "test": {
      "path": "index.php?&noredir=1",
      "selector": "a[data-url=\"logout.php\"]"
    },
    "headers": {
      "User-Agent": [
        "{{ .Config.useragent }}"
      ]
    }
  },
  "search": {
    "paths": [
      {
        "path": "torrents.php"
      }
    ],
    "inputs": {
      "$raw": "{{ range .Categories }}cat{{.}}=1&{{end}}",
      "search": "{{ if .Query.IMDBID }}{{ .Query.IMDBID }}{{ else }}{{ end }}{{ if and .Query.DoubanID (eq .Query.IMDBID .False) }}{{ .Query.DoubanID }}{{ else }}{{ end }}{{ if and (eq .Query.IMDBID .False) (eq .Query.DoubanID .False) }}{{ .Keywords }}{{ else }}{{ end }}",
      "incldead": "0",
      "spstate": "{{ if .Config.freeleech }}2{{ else }}0{{ end }}",
      "search_area": "{{ if .Query.IMDBID }}4{{ else }}{{ end }}{{ if and .Query.DoubanID (eq .Query.IMDBID .False) }}5{{ else }}{{ end }}{{ if and (eq .Query.IMDBID .False) (eq .Query.DoubanID .False) }}0{{ else }}{{ end }}",
      "search_mode": "0",
      "sort": "{{ .Config.sort }}",
      "type": "{{ .Config.type }}",
      "notnewword": "1"
    },
    "headers": {
      "User-Agent": [
        "{{ .Config.useragent }}"
      ]
    },
    "rows": {
      "selector": "table.torrents > tbody > tr:has(table.torrentname)"
    },
    "fields": {
      "category": {
        "selector": "a[href^=\"?cat=\"]",
        "attribute": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "cat"
            ]
          }
        ]
      },
      "title_default": {
        "selector": "a[href^=\"details.php?id=\"], a[href^=\"detailsgame.php?\"]"
      },
      "title": {
        "selector": "a[title][href^=\"details.php?id=\"], a[title][href^=\"detailsgame.php?id=\"]",
        "attribute": "title",
        "optional": true,
        "default": "{{ .Result.title_default }}"
      },
      "details": {
        "selector": "a[href^=\"details.php?id=\"], a[href^=\"detailsgame.php?\"]",
        "attribute": "href"
      },
      "download": {
        "selector": "a[href^=\"download.php?id=\"]",
        "attribute": "href"
      },
      "poster": {
        "selector": "img[data-orig]",
        "attribute": "data-orig",
        "optional": true
      },
      "imdbid": {
        "selector": "a[href$=\"&search_area=4\"]",
        "attribute": "href",
        "optional": true
      },
      "doubanid": {
        "selector": "a[href$=\"&search_area=5\"]",
        "attribute": "href",
        "optional": true
      },
      "_anchor1": {
        "selector": "td:has(a[href^=\"comment.php?\"])",
        "optional": true
      },
      "date_elapsed": {
        "selector": "td:has(a[{{ if .Result._anchor1 }}href^=\"comment.php\"{{ else }}href$=\"startcomments\"{{ end }}]) ~ td > span[title]",
        "attribute": "title",
        "optional": true,
        "filters": [
          {
            "name": "append",
            "args": [
              " +08:00"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "2006-01-02 15:04:05 -07:00",
              "2006-01-02 15:04:05 -0700"
            ]
          }
        ]
      },
      "date_added": {
        "selector": "td:has(a[{{ if .Result._anchor1 }}href^=\"comment.php\"{{ else }}href$=\"startcomments\"{{ end }}]) ~ td:not(:has(span[title]))",
        "optional": true,
        "filters": [
          {
            "name": "append",
            "args": [
              " +08:00"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "2006-01-0215:04:05 -07:00",
              "2006-01-0215:04:05 -0700"
            ]
          }
        ]
      },
      "date": {
        "text": "{{ if or .Result.date_elapsed .Result.date_added }}{{ or .Result.date_elapsed .Result.date_added }}{{ else }}now{{ end }}"
      },
      "size": {
        "selector": "td:has(a[{{ if .Result._anchor1 }}href^=\"comment.php\"{{ else }}href$=\"startcomments\"{{ end }}]) ~ td ~ td"
      },
      "seeders": {
        "selector": "td:has(a[{{ if .Result._anchor1 }}href^=\"comment.php\"{{ else }}href$=\"startcomments\"{{ end }}]) ~ td ~ td ~ td"
      },
      "leechers": {
        "selector": "td:has(a[{{ if .Result._anchor1 }}href^=\"comment.php\"{{ else }}href$=\"startcomments\"{{ end }}]) ~ td ~ td ~ td ~ td"
      },
      "grabs": {
        "selector": "td:has(a[{{ if .Result._anchor1 }}href^=\"comment.php\"{{ else }}href$=\"startcomments\"{{ end }}]) ~ td ~ td ~ td ~ td ~ td"
      },
      "downloadvolumefactor": {
        "case": {
          "img.pro_free": "0",
          "img.pro_free2up": "0",
          "img.pro_50pctdown": "0.5",
          "img.pro_50pctdown2up": "0.5",
          "img.pro_30pctdown": "0.3",
          "*": "1"
        }
      },
      "uploadvolumefactor": {
        "case": {
          "img.pro_50pctdown2up": "2",
          "img.pro_free2up": "2",
          "img.pro_2up": "2",
          "*": "1"
        }
      },
      "minimumratio": {
        "text": "0.9"
      },
      "description": {
        "selector": "td.embedded > div > div:nth-child(2) > span",
        "optional": true
      }
    }
  },
  "source": {
    "path": "definitions/v11/pterclub.yml",
    "sha256": "a510e7cbafb25669a6d0daa661365ecbfea3fe189e6915b1b83eb2a712c468d9",
