      },
      "details": {
        "selector": "a[href^=\"/hash/\"]",
        "attribute": "href"
      },
      "infohash": {
        "selector": "a[href^=\"/hash/\"]",
        "attribute": "href",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "([A-F|a-f|0-9]{40})"
            ]
          }
        ]
      },
      "date": {
        "selector": "div.meta span:nth-child(1)",
        "filters": [
          {
            "name": "replace",
            "args": [
              "Added：",
              ""
            ]
          },
          {
            "name": "append",
            "args": [
              " +08:00"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "2006-01-02 -07:00"
            ]
          }
        ]
      },
      "size": {
        "selector": "div.meta span:nth-child(2)",
        "filters": [
          {
