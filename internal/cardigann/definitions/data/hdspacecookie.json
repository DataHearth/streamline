    ],
    "modes": {
      "search": [
        "q"
      ],
      "tv-search": [
        "q",
        "season",
        "ep",
        "imdbid"
      ],
      "movie-search": [
        "q",
        "imdbid"
      ],
      "music-search": [
        "q"
      ]
    }
  },
  "settings": [
    {
      "name": "cookie",
      "label": "Cookie",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_cookie",
      "type": "info_cookie"
    },
    {
      "name": "freeleech",
      "label": "Filter freeleech only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "sort",
      "label": "Sort requested from site",
      "type": "select",
      "default": "3",
      "options": {
        "3": "created",
        "5": "seeders",
        "4": "size",
        "2": "title"
      }
    },
    {
      "name": "type",
      "label": "Order requested from site",
      "type": "select",
      "default": "2",
      "options": {
        "2": "desc",
        "1": "asc"
      }
    }
  ],
  "login": {
    "method": "cookie",
    "inputs": {
      "cookie": "{{ .Config.cookie }}"
    },
    "test": {
      "path": "index.php",
      "selector": "a[href=\"logout.php\"]"
    }
  },
  "search": {
    "paths": [
      {
        "path": "index.php"
      }
    ],
    "inputs": {
      "page": "torrents",
      "search": "{{ if .Query.IMDBID }}{{ .Query.IMDBIDShort }}{{ else }}{{ .Keywords }}{{ end }}",
      "category": "{{ if .Categories }}{{ range .Categories }}{{.}};{{end}}{{ else }}0{{ end }}",
      "options": "{{ if .Query.IMDBID }}2{{ else }}0{{ end }}",
      "active": "0",
      "order": "{{ .Config.sort }}",
      "by": "{{ .Config.type }}"
    },
    "rows": {
      "selector": "table.lista[width=\"100%\"] > tbody > style ~ tr{{ if .Config.freeleech }}:has(img[src=\"gold/gold.png\"]){{ else }}{{ end }}, table.lista[width=\"100%\"] > tbody > style ~ tr{{ if .Config.freeleech }}:has(img[src=\"images/sf.png\"]){{ else }}{{ end }}"
    },
    "fields": {
      "category": {
        "selector": "td a[href^=\"index.php?page=torrents&category=\"]",
        "attribute": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "category"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "\\b0\\b",
              "38"
            ],
            "engine": "regexp2"
          }
        ]
      },
      "title_default": {
        "selector": "td a[href^=\"index.php?page=torrent-details\"]",
        "filters": [
          {
            "name": "htmldecode"
          }
        ]
      },
      "title": {
        "selector": "a[href^=\"download.php?id=\"]",
        "attribute": "href",
        "optional": true,
        "default": "{{ .Result.title_default }}",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "f"
            ]
          },
          {
            "name": "htmldecode"
          },
          {
            "name": "htmldecode"
          },
          {
            "name": "replace",
            "args": [
              ".torrent",
              ""
            ]
          },
          {
            "name": "trim"
          }
        ]
      },
      "details": {
        "selector": "td a[href^=\"index.php?page=torrent-details\"]",
        "attribute": "href"
      },
      "download": {
        "selector": "a[href^=\"download.php?id=\"]",
        "attribute": "href"
      },
      "poster": {
        "selector": "td a[href^=\"index.php?page=torrent-details\"]",
        "attribute": "onmouseover",
        "optional": true,
        "filters": [
          {
            "name": "regexp",
            "args": [
              "src=\\./(.+?)[\\t-\\r\\x{85}\\p{Z}]"
            ]
          }
        ]
      },
      "imdbid": {
        "selector": "td a[href^=\"index.php?page=torrent-details\"]",
        "attribute": "onmouseover",
        "optional": true,
        "filters": [
          {
            "name": "regexp",
            "args": [
              "/(\\p{Nd}{8}).jpg"
            ]
          }
        ]
      },
      "date_day": {
        "selector": "td:nth-child(5):contains(\"day\")",
        "optional": true,
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "[ ]at|[// \\t-\\r\\x{85}\\p{Z},]+",
              " "
            ]
          }
        ]
      },
      "date_year": {
        "selector": "td:nth-child(5):not(:contains(\"day\"))",
        "optional": true,
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "[// \\t-\\r\\x{85}\\p{Z},]+",
              " "
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "January 02 2006 15:04:05"
            ]
          }
        ]
      },
      "date": {
        "text": "{{ if or .Result.date_day .Result.date_year }}{{ or .Result.date_day .Result.date_year }}{{ else }}now{{ end }}"
      },
      "size": {
        "selector": "td:nth-child(6)"
      },
      "seeders": {
        "selector": "td:nth-child(8)"
      },
      "leechers": {
        "selector": "td:nth-child(9)"
      },
      "grabs": {
        "selector": "td:nth-child(10)"
      },
      "genre": {
        "selector": "td:nth-child(2)",
        "optional": true,
        "remove": "a"
      },
      "description": {
        "optional": true,
        "text": "{{ .Result.genre }}"
      },
      "downloadvolumefactor": {
        "case": {
          "img[src=\"images/sf.png\"]": "0",
          "img[src=\"gold/gold.png\"]": "0",
          "img[src=\"gold/silver.png\"]": "0.5",
          "*": "1"
        }
      },
      "uploadvolumefactor": {
        "text": "1"
      },
      "minimumratio": {
        "text": "1.0"
      },
      "minimumseedtime": {
        "text": "86400"
      }
    }
  },
  "source": {
    "path": "definitions/v11/hdspacecookie.yml",
