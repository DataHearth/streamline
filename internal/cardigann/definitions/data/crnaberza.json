  "settings": [
    {
      "name": "username",
      "label": "Username",
      "type": "text"
    },
    {
      "name": "password",
      "label": "Password",
      "type": "password",
      "secret": true
    },
    {
      "name": "info",
      "label": "Results Per Page",
      "type": "info",
      "default": "For best results, change the 'Torrenata po stranici' setting to 50 on your 'Torrenti' from the 'Podešavanja naloga' menu on the CrnaBerza webpage."
    },
    {
      "name": "freeleech",
      "label": "Filter freeleech only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "sort2",
      "label": "Sort requested from site",
      "type": "select",
      "default": "added",
      "options": {
        "added": "created",
        "seeders": "seeders",
        "size": "size",
        "name": "title"
      }
    },
    {
      "name": "type",
      "label": "Order requested from site",
      "type": "select",
      "default": "desc",
      "options": {
        "desc": "desc",
        "asc": "asc"
      }
    }
  ],
  "login": {
    "method": "form",
    "path": "prijava/",
    "form": "form#crna-login-form",
    "inputs": {
      "_wp_http_referer": "/prijava/",
      "redirect_to": "{{ .Config.sitelink }}",
      "username": "{{ .Config.username }}",
      "password": "{{ .Config.password }}",
      "rememberme": "on"
    },
    "error": [
      {
        "selector": "p.text-red-300"
      }
    ],
    "test": {
      "path": "/",
      "selector": "a[href*=\"wp-login.php?action=logout\"]"
    }
  },
  "search": {
    "paths": [
      {
        "path": "t/"
      }
    ],
    "inputs": {
      "$raw": "{{ range .Categories }}category[]={{.}}&{{end}}",
      "search": "{{ .Keywords }}",
      "sort": "{{ .Config.sort2 }}",
      "dir": "{{ .Config.type }}"
    },
    "rows": {
      "selector": "table.min-w-full > tbody > tr:has(a[href*=\"/download/\"]){{ if .Config.freeleech }}:has(span.text-green-300:contains(\"Free Leech\")){{ else }}{{ end }}"
    },
    "fields": {
      "category": {
        "selector": "a[href*=\"/t/?category\"]",
        "attribute": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "category[0]"
            ]
          }
        ]
      },
      "title": {
        "selector": "a[href*=\"/td/\"]",
        "attribute": "title"
      },
      "details": {
        "selector": "a[href*=\"/td/\"]",
        "attribute": "href"
      },
      "download": {
        "selector": "a[href*=\"/download/\"]",
        "attribute": "href"
      },
      "date": {
        "selector": "td:nth-of-type(4)",
        "filters": [
          {
            "name": "dateparse",
            "args": [
              "Jan 2 2006 03:04 PM",
              "Jan 2 2006 03:04 pm"
            ]
          }
        ]
      },
      "size": {
        "selector": "td:nth-of-type(6)"
      },
      "seeders": {
        "selector": "td:nth-of-type(7)"
      },
      "leechers": {
        "selector": "td:nth-of-type(8)"
      },
      "downloadvolumefactor": {
        "case": {
          "span.text-green-300:contains(\"Free Leech\")": "0",
          "span.text-blue-300:contains(\"½ Download\")": "0.5",
          "*": "1"
        }
      },
      "uploadvolumefactor": {
        "case": {
          "span.text-purple-300:contains(\"x5 Upload\")": "5",
          "span.text-purple-300:contains(\"x4 Upload\")": "4",
          "span.text-purple-300:contains(\"x3 Upload\")": "3",
          "span.text-purple-300:contains(\"x2 Upload\")": "2",
          "*": "1"
        }
      },
      "minimumratio": {
        "text": "1.0"
      },
      "minimumseedtime": {
        "text": "604800"
      }
    }
  },
  "source": {
    "path": "definitions/v11/crnaberza.yml",
