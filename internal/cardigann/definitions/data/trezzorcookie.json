  "settings": [
    {
      "name": "cookie",
      "label": "Cookie",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_cookie",
      "type": "info_cookie"
    },
    {
      "name": "freeleech",
      "label": "Filter FreeLeech only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "sort",
      "label": "Sort requested from site",
      "type": "select",
      "default": "data",
      "options": {
        "data": "created",
        "seeds": "seeders",
        "size": "size",
        "filename": "title"
      }
    },
    {
      "name": "type",
      "label": "Order requested from site",
      "type": "select",
      "default": "DESC",
      "options": {
        "DESC": "desc",
        "ASC": "asc"
      }
    },
    {
      "name": "info_tpp",
      "label": "Results Per Page",
      "type": "info",
      "default": "For best results, change the <b>Torrentu na strance:</b> setting to <b>100</b> on your account profile."
    },
    {
      "name": "info_xxx",
      "label": "XXX Results",
      "type": "info",
      "default": "To include XXX in results, click <b>Kategoria XXX sa nezobrazuje!!!. povolit zobrazenie</b> on the tracker search page."
    },
    {
      "name": "info_activity",
      "label": "Account Inactivity",
      "type": "info",
      "default": "Park your account to protect it against deletion due to the fact that you have not logged in at least once every 3 months."
    }
  ],
  "login": {
    "method": "cookie",
    "inputs": {
      "cookie": "{{ .Config.cookie }}"
    },
    "test": {
      "path": "index.php",
      "selector": "a[href=\"logout.php\"]"
    }
  },
  "search": {
    "paths": [
      {
        "path": "torrents.php"
      }
    ],
    "inputs": {
      "search": "{{ .Keywords }}",
      "category": "0",
      "active": "0",
      "rok": "{{ .Query.Year }}"
    },
    "keywordsfilters": [
      {
        "name": "re_replace",
        "args": [
          "(?i)S(\\p{Nd}{2})E(\\p{Nd}{2})",
          "${1} ${2}"
        ]
      }
    ],
    "rows": {
      "selector": "tr.torrenty_lista{{ if .Config.freeleech }}:has(a[href^=\"details.php?slug=\"] b span[style=\"color:darkmagenta\"]){{ else }}{{ end }}"
    },
    "fields": {
      "category": {
        "selector": "a[href^=\"torrents.php?onlycat=\"]",
        "attribute": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "onlycat"
            ]
          }
        ]
      },
      "title": {
        "selector": "a[href^=\"details.php?slug=\"]",
        "attribute": "title",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "(?i)^(Zobrazit detaily|View details|Detaily): ",
              ""
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)[\\t-\\r\\x{85}\\p{Z}\\->]*FREELEECH.*",
              ""
            ]
          },
          {
            "name": "re_replace",
            "args": [
              ".*?/ ",
              ""
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\b(\\d{1,3})x(\\d{1,3})\\b",
              "S$1E$2"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\b(?:Sezona|Series?|Seria|Season)[\\s\\.]*(\\d{1,3}(?:-\\d+)?)[\\.,\\s]*Epizoda[\\s\\.]*(\\d+(?:-\\d+)?)\\b",
              "S$1E$2"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\b(\\d{1,3}(?:-\\d+)?)[\\s\\.]*(?:Sezona|Series?|Seria|Season)[\\.,\\s]*(\\d+(?:-\\d+)?)[\\s\\.]*Epizoda\\b",
              "S$1E$2"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\b(?:Sezona|Series?|Seria|Season)[\\s\\.]*(\\d{1,3}(?:-\\d+)?)[\\.,\\s]+(\\d+(?:-\\d+)?)[\\s\\.]*Epizoda\\b",
              "S$1E$2"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\b(?:Sezona|Series?|Seria|Season)[\\s\\.]*(\\d{1,3})[-\\+\\.,\\s]+(\\d+)\\b",
              "S$1-$2"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\b(\\d{1,3})[-\\+\\.\\s]+(\\d+)[\\s\\.]*(?:Sezona|Series?|Seria|Season)\\b",
              "S$1-$2"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\b(?:Sezona|Series?|Seria|Season)[\\s\\.]*(\\d{1,3}(?:-\\d+)?)\\b",
              "S$1"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\b(\\d{1,3}(?:-\\d+)?)[\\s\\.]*(?:Sezona|Series?|Seria|Season)\\b",
              "S$1"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\bEpizoda[\\s\\.]*(\\d+)[-\\+\\.,\\s]+(\\d+)\\b",
              "E$1-$2"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\b(\\d+)[-\\+\\.,\\s]+(\\d+)[\\s\\.]*Epizoda\\b",
              "E$1-$2"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\bEpizoda[\\s\\.]*(\\d+(?:-\\d+)?)\\b",
              "E$1"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\b(\\d+(?:-\\d+)?)[\\s\\.]*Epizoda\\b",
              "E$1"
            ],
            "engine": "regexp2"
          }
        ]
      },
      "details": {
        "selector": "a[href^=\"details.php?slug=\"]",
        "attribute": "href"
      },
      "download": {
        "selector": "a[href^=\"download.php?slug=\"]",
        "attribute": "href"
      },
      "date": {
        "selector": "td:nth-child(6)",
        "filters": [
          {
            "name": "append",
            "args": [
              " +02:00"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "2/1/2006 15:04 -07:00",
              "2/1/2006 15:04 -0700"
            ]
          }
        ]
      },
      "size": {
        "selector": "td:nth-child(7)"
      },
      "seeders": {
        "selector": "td:nth-child(8) a"
      },
      "leechers": {
        "selector": "td:nth-child(9) a"
      },
      "grabs": {
        "selector": "td:nth-child(10)"
      },
      "downloadvolumefactor": {
        "case": {
          "a[href^=\"details.php?slug=\"] b span[style=\"color:darkmagenta\"]": "0",
          "*": "1"
        }
      },
      "uploadvolumefactor": {
        "text": "1"
      },
      "description": {
        "selector": "a[href^=\"details.php?slug=\"]",
        "attribute": "title",
        "optional": true,
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "(?i)^(Zobrazit detaily|View details|Detaily): ",
              ""
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)[\\t-\\r\\x{85}\\p{Z}\\->]*FREELEECH.*",
              ""
            ]
          }
        ]
      }
    }
  },
