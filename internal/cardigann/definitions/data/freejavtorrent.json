{
  "id": "freejavtorrent",
  "name": "Free JAV Torrent",
  "description": "Free JAV Torrent is a Public tracker for Asian 3X (JAV)",
  "language": "en-US",
  "type": "public",
  "encoding": "UTF-8",
  "links": [
    "https://www.freejavtorrent.com/"
  ],
  "caps": {
    "categories": {
      "Japanese Movies": "XXX",
      "Japanese Movies Packs": "XXX/Pack",
      "Chinese Movies": "XXX",
      "Japanese Movies SiteRip 1991-2014": "XXX/Pack",
      "Japanese Movies SiteRip 2015-2024": "XXX/Pack"
    },
    "modes": {
      "search": [
        "q"
      ]
    }
  },
  "settings": [],
  "search": {
    "paths": [
      {
        "path": "{{ if .Keywords }}s.php?search={{ .Keywords }}{{ else }}{{ end }}"
      }
    ],
    "rows": {
      "selector": "div.image-wrapper"
    },
    "fields": {
      "category": {
        "selector": "div.catalog a"
      },
      "title": {
        "selector": "a.overlay",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "^.+?\\] ",
              ""
            ]
          }
        ]
      },
      "details": {
        "selector": "a.overlay",
        "attribute": "href"
      },
      "download": {
        "selector": "a.overlay",
        "attribute": "href",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "-(\\p{Nd}+).html"
            ]
          },
          {
            "name": "prepend",
            "args": [
              "/dl.php?t="
            ]
          }
        ]
      },
      "poster": {
        "selector": "img",
        "attribute": "src"
      },
      "date": {
        "text": "now"
      },
      "size_get": {
        "selector": "a.overlay",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "^\\[(\\p{Nd}+(?:\\.\\p{Nd}+)?[\\t-\\r\\x{85}\\p{Z}]?[KMGT]B)\\]"
            ]
          }
        ]
      },
      "size": {
        "text": "{{ if .Result.size_get }}{{ .Result.size_get }}{{ else }}5GB{{ end }}"
      },
      "seeders": {
        "text": "1"
      },
      "leechers": {
        "text": "1"
      },
      "downloadvolumefactor": {
        "text": "0"
      },
      "uploadvolumefactor": {
        "text": "1"
      }
    }
  },
  "download": {
    "selectors": [
      {
        "selector": "a.download-button",
        "attribute": "href"
      }
    ]
  },
  "source": {
    "path": "definitions/v11/freejavtorrent.yml",
    "sha256": "cd29c15c8dec8af6ab74beec24754f71e46953a28c96c2b4df423284f9ac3796",
    "modified": "converted by streamline's internal/cardigann/convert: YAML to JSON; .NET regexes, substitutions, date layouts and template string literals rewritten for Go"
  }
}
