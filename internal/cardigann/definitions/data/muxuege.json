  "name": "Muxuege",
  "description": "Muxuege is a CHINESE Private Torrent Tracker for MOVIES / TV / GENERAL",
  "language": "zh-CN",
  "type": "private",
  "encoding": "UTF-8",
  "links": [
    "https://pt.muxuege.org/"
  ],
  "caps": {
