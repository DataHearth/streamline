    "modes": {
      "search": [
        "q"
      ],
      "tv-search": [
        "q",
        "season",
        "ep"
      ],
      "movie-search": [
        "q"
      ],
      "music-search": [
        "q"
      ],
      "book-search": [
        "q"
      ]
    }
  },
  "settings": [
    {
      "name": "info_flaresolverr",
      "type": "info_flaresolverr"
    }
  ],
  "search": {
    "paths": [
      {
        "path": "search",
        "inputs": {
          "page": "1"
        }
      },
      {
        "path": "search",
        "inputs": {
          "page": "2"
        }
      },
      {
        "path": "search",
        "inputs": {
          "page": "3"
        }
      }
    ],
    "inputs": {
      "q": "{{ if .Keywords }}{{ .Keywords }}{{ else }}{{ .Today.Year }}{{ end }}",
      "sort": "time"
    },
    "rows": {
      "selector": "ul.page-list > li:has(a[href$=\".html\"][title]):not(:contains(\"[  ]\"))",
      "filters": [
        {
          "name": "andmatch"
        }
      ]
    },
    "fields": {
      "category": {
        "selector": "div:nth-child(2)",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "\\[ (.+?) \\]"
            ]
          }
        ]
      },
      "title": {
        "selector": "a[href$=\".html\"][title]",
        "attribute": "title"
      },
      "details": {
        "selector": "a[href$=\".html\"][title]",
        "attribute": "href"
      },
      "download": {
        "selector": "a[href$=\".html\"][title]",
        "attribute": "href"
      },
      "date": {
        "selector": "div:nth-child(3)",
        "filters": [
          {
            "name": "dateparse",
            "args": [
              "06/01/02"
            ]
          }
        ]
      },
      "size": {
        "text": "512MB"
      },
      "seeders": {
        "text": "1"
      },
      "leechers": {
        "text": "1"
      },
      "downloadvolumefactor": {
        "text": "0"
      },
      "uploadvolumefactor": {
        "text": "1"
      }
    }
  },
  "download": {
    "infohash": {
      "hash": {
        "selector": "div.p-2:has(i.fa-magnet)",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "([A-F|a-f|0-9]{40})"
            ]
          }
        ]
      },
      "title": {
        "selector": "h1",
        "filters": [
          {
            "name": "trim"
          },
          {
            "name": "validfilename"
          }
        ]
      }
    }
  },
  "source": {
