{
  "id": "zmpt-api",
  "name": "ZmPT (织梦) (API)",
  "description": "ZmPT (织梦) is a CHINESE Private Torrent Tracker for MOVIES / TV / GENERAL",
  "language": "zh-CN",
  "type": "private",
  "encoding": "UTF-8",
  "links": [
    "https://zmpt.cc/"
  ],
  "caps": {
    "categorymappings": [
      {
        "id": "409",
        "cat": "Other",
        "desc": "其他 / Misc"
      },
      {
        "id": "422",
        "cat": "TV/Documentary",
        "desc": "纪录片 / documentary"
      },
      {
        "id": "417",
        "cat": "TV/Anime",
        "desc": "动漫 / Anime"
      },
      {
        "id": "427",
        "cat": "Audio/Video",
        "desc": "短剧 / Short Play"
      },
      {
        "id": "401",
        "cat": "Movies",
        "desc": "电影 / Movies"
      },
      {
        "id": "402",
        "cat": "TV",
        "desc": "电视剧 / TV Series"
      },
      {
        "id": "403",
        "cat": "TV",
        "desc": "综艺 / TV Shows"
      },
      {
        "id": "423",
        "cat": "Audio",
        "desc": "音乐 / Music"
      },
      {
        "id": "424",
        "cat": "Audio/Audiobook",
        "desc": "有声书 / Audiobook"
      },
      {
        "id": "425",
        "cat": "PC",
        "desc": "软件 / Software"
      },
      {
        "id": "426",
        "cat": "Console",
        "desc": "游戏 / Game"
      }
    ],
    "modes": {
      "search": [
        "q"
      ],
      "tv-search": [
        "q",
        "season",
        "ep"
      ],
      "movie-search": [
        "q"
      ],
      "music-search": [
        "q"
      ]
    }
  },
  "settings": [
    {
      "name": "apikey",
      "label": "API Token",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_apikey",
      "label": "About your API Token",
      "type": "info",
      "default": "Find/Generate an API token from your <a href=\"https://zmpt.cc/usercp.php\" target=\"_blank\">ZmPT</a> account control panel."
    },
    {
      "name": "passkey",
      "label": "Passkey",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_passkey",
      "label": "About your Passkey",
      "type": "info",
      "default": "Find the Passkey from your account control panel."
    },
    {
      "name": "freeleech",
      "label": "Filter freeleech only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "sort",
      "label": "Sort requested from site",
      "type": "select",
      "default": "-id",
      "options": {
        "-id": "created",
        "-seeders": "seeders",
        "-size": "size",
        "-times_completed": "grabs"
      }
    },
    {
      "name": "info_activity",
      "label": "Account Inactivity",
      "type": "info",
      "default": "Account retention rules:<ol><li>Dou Sheng users and above will be retained forever</li><li>Dou Huang and above will not have their account deleted after parking (in the control panel)</li><li>Users with a parked account will be deleted if they do not log in for 180 consecutive days</li><li>Users with a non-parked account will be banned if they do not log in for 45 consecutive days</li><li>Users with no traffic (ie, upload/download data are both 0) will be banned if they do not log in for 7 consecutive days.</li></ol>"
    }
  ],
  "login": {
    "method": "get",
    "path": "api/v1/torrents",
    "inputs": {
      "per_page": "1"
    },
    "error": [
      {
        "selector": ":root:contains(\"login.php?returnto\")",
        "message": {
          "text": "The API token was not accepted by {{ .Config.sitelink }}."
        }
      },
      {
        "selector": ":root:contains(\"Unauthenticated\")",
        "message": {
          "text": "The API token was not accepted by {{ .Config.sitelink }}."
        }
      }
    ]
  },
  "search": {
    "paths": [
      {
        "path": "api/v1/torrents",
        "response": {
          "type": "json"
        }
      }
    ],
    "inputs": {
      "$raw": "{{ range .Categories }}&filter[category][in][]={{.}}{{end}}",
      "filter[title]": "{{ .Keywords }}",
      "sorts": "{{ .Config.sort }}",
      "per_page": "100"
    },
    "headers": {
      "Authorization": [
        "Bearer {{ .Config.apikey }}"
      ]
    },
    "keywordsfilters": [
      {
        "name": "re_replace",
        "args": [
          "\\.",
          " "
        ]
      }
    ],
    "rows": {
      "selector": "data.data{{ if .Config.freeleech }}:not(promotion_info.down_multiplier:contains(1)):not(promotion_info.down_multiplier:contains(.)){{ else }}{{ end }}"
    },
    "fields": {
      "category": {
        "selector": "category"
      },
      "_id": {
        "selector": "id"
      },
      "title": {
        "selector": "name"
      },
      "details": {
        "text": "{{ .Config.sitelink }}details.php?id={{ .Result._id }}&hit=1"
      },
      "download": {
        "text": "{{ .Config.sitelink }}download.php?id={{ .Result._id }}&passkey={{ .Config.passkey }}"
      },
      "infohash": {
        "selector": "hash"
      },
      "poster": {
        "selector": "cover"
      },
      "description": {
        "selector": "small_descr"
      },
      "size": {
        "selector": "size"
      },
      "files": {
        "selector": "numfiles"
      },
      "seeders": {
        "selector": "seeders"
      },
      "leechers": {
        "selector": "leechers"
      },
      "grabs": {
        "selector": "times_completed"
      },
      "date": {
        "selector": "added",
        "filters": [
          {
            "name": "append",
            "args": [
              " +08:00"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "2006-01-02 15:04 -07:00",
              "2006-01-02 15:04 -0700"
            ]
          }
        ]
      },
      "downloadvolumefactor": {
        "selector": "promotion_info.down_multiplier"
      },
      "uploadvolumefactor": {
        "selector": "promotion_info.up_multiplier"
      },
      "minimumratio": {
        "selector": "hr",
        "case": {
          "1": "1.0",
          "0": "0.4"
        }
      },
      "minimumseedtime": {
        "selector": "hr",
        "case": {
          "1": "259200",
          "0": "86400"
        }
      }
    }
  },
  "source": {
    "path": "definitions/v11/zmpt-api.yml",
    "sha256": "77ad6a8ae72e18b42d9eaa86ec9a20746fec4d29382f5adcc52bb55131a18226",
    "modified": "converted by streamline's internal/cardigann/convert: YAML to JSON; .NET regexes, substitutions, date layouts and template string literals rewritten for Go"
  }
}
