  "settings": [],
  "search": {
    "paths": [
      {
        "path": "index.php"
      }
    ],
    "inputs": {
      "do": "search",
      "subaction": "search",
      "search_start": "0",
      "result_from": "1",
      "story": "{{ if .Keywords }}{{ .Keywords }}{{ else }}{{ .Today.Year }}{{ end }}"
    },
    "headers": {
      "Referer": [
        "{{ .Config.sitelink }}"
      ]
    },
    "rows": {
      "selector": "div.short_game_search"
    },
    "fields": {
      "category": {
        "selector": "div.icon_default",
        "optional": true,
        "default": "PS1"
      },
      "title": {
        "selector": "div.short_game_title"
      },
      "details": {
        "selector": "a[href$=\".html\"]",
        "attribute": "href"
      },
      "download": {
        "selector": "a[href$=\".html\"]",
        "attribute": "href"
      },
      "poster": {
        "selector": "img",
        "attribute": "src",
        "optional": true
      },
      "genre": {
        "selector": "div.short_game_genre",
        "optional": true
      },
      "description": {
        "optional": true,
        "text": "{{ .Result.genre }}"
      },
      "date": {
        "text": "now"
      },
      "seeders": {
        "text": "1"
      },
      "leechers": {
        "text": "1"
      },
      "size": {
        "text": "512 MB"
      },
      "downloadvolumefactor": {
        "text": "0"
      },
      "uploadvolumefactor": {
        "text": "1"
      }
    }
  },
  "download": {
    "selectors": [
      {
        "selector": "a[href*=\"/index.php?do=download&id=\"]",
        "attribute": "href"
      }
    ],
    "headers": {
      "Referer": [
        "{{ .Config.sitelink }}"
      ]
    }
  },
