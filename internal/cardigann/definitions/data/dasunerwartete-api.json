  "settings": [
    {
      "name": "apikey",
      "label": "APIKey",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_key",
      "label": "About your API key",
      "type": "info",
      "default": "Find your API Key by accessing your <a href=\"https://dasunerwartete.biz/\" target=\"_blank\">Das Unerwartete</a> profile page and look for the <b>API-Key:</b> tag."
    },
    {
      "name": "onlyupload",
      "label": "Search OnlyUpload",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "info_free",
      "label": "About OnlyUpload at D-U",
      "type": "info",
      "default": "OnlyUpload are torrents where download is not counted but upload is. Good for building your Ratio up. (On the Jackett dashboard search results these are tagged as Freeleech)."
    }
  ],
  "search": {
    "paths": [
      {
        "path": "api.php",
        "method": "get",
        "inputs": {
          "apikey": "{{ .Config.apikey }}",
          "$raw": "{{ range .Categories }}c{{.}}=1&{{end}}",
          "q": "{{ .Query.Keywords }}",
          "imdbid": "{{ .Query.IMDBID }}",
          "tmdbid": "{{ .Query.TMDBID }}",
          "free": "{{ if .Config.onlyupload }}yes{{ else }}{{ end }}",
          "page": "1"
        },
        "response": {
          "type": "xml"
        }
      }
    ],
    "rows": {
      "selector": "item"
    },
    "fields": {
      "category": {
        "selector": "category"
      },
      "title": {
        "selector": "title"
      },
      "_id": {
        "selector": "guid"
      },
      "details": {
        "text": "details.php?id={{ .Result._id }}"
      },
      "download": {
        "selector": "link",
        "filters": [
          {
            "name": "replace",
            "args": [
              "&amp;",
              "&"
            ]
          }
        ]
      },
      "size": {
        "selector": "size"
      },
      "date": {
        "selector": "pubDate",
        "filters": [
          {
            "name": "replace",
            "args": [
              "+0100",
              "+01:00"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "Mon, 02 Jan 2006 15:04:05 -07:00",
              "Mon, 02 Jan 2006 15:04:05 -0700"
            ]
          }
        ]
      },
      "seeders": {
        "selector": "seeders"
      },
      "leechers": {
        "selector": "leechers"
      },
      "imdbid": {
        "selector": "imdb",
        "optional": true
      },
      "tmdbid": {
        "selector": "tmdb",
        "optional": true
      },
      "_onlyup": {
        "selector": "free_button:contains(Only Upload)",
        "optional": true
      },
      "downloadvolumefactor": {
        "text": "{{ if .Result._onlyup }}0{{ else }}1{{ end }}"
      },
      "uploadvolumefactor": {
        "text": "1"
      },
      "minimumratio": {
        "text": "1.0"
      },
      "minimumseedtime": {
        "text": "129600"
      }
    }
  },
