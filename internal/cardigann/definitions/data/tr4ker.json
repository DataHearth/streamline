      ],
      "book-search": [
        "q"
      ]
    },
    "allowrawsearch": true,
    "allowtvsearchimdb": true
  },
  "settings": [
    {
      "name": "apikey",
      "label": "API Key",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_key",
      "label": "About your API key",
      "type": "info",
      "default": "You can find or generate a new API Key by accessing the <a href=\"https://tr4ker.net/mon-compte/parametres\" target=\"_blank\">TR4KER Paramètres</a> page and scrolling down to the <b>Clé API</b> section."
    },
    {
      "name": "multilang",
      "label": "Replace MULTi by another language in release name",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "multilanguage",
      "label": "Replace MULTi by this language",
      "type": "select",
      "default": "FRENCH",
      "options": {
        "FRENCH": "FRENCH",
        "MULTi.FRENCH": "MULTi.FRENCH",
        "ENGLISH": "ENGLISH",
        "MULTi.ENGLISH": "MULTi.ENGLISH",
        "VOSTFR": "VOSTFR",
        "MULTi.VOSTFR": "MULTi.VOSTFR"
      }
    },
    {
      "name": "vostfr",
      "label": "Replace VOSTFR and SUBFRENCH with ENGLISH",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "info_3x",
      "label": "Including 3X",
      "type": "info",
      "default": "IF you want to see 3x torrents access your <a href=\"https://tr4ker.net/mon-compte/parametres\" target=\"_blank\">TR4KER Paramètres</a> page and flick the <b>Contenu adulte (+18)</b> switch."
    }
  ],
  "login": {
    "method": "get",
    "path": "api/torznab",
    "inputs": {
      "apikey": "{{ .Config.apikey }}",
      "t": "search",
      "limit": "1"
    }
  },
  "search": {
    "paths": [
      {
        "path": "api/torznab/all",
        "response": {
          "type": "xml"
        }
      }
    ],
    "inputs": {
      "apikey": "{{ .Config.apikey }}",
      "t": "{{ if .Query.Type }}{{ .Query.Type }}{{ else }}search{{ end }}",
      "q": "{{ .Keywords }}",
      "cat": "{{ join .Categories \",\" }}",
      "imdbid": "{{ .Query.IMDBID }}",
      "tmdbid": "{{ .Query.TMDBID }}",
      "tvdbid": "{{ .Query.TVDBID }}",
      "limit": "100"
    },
    "rows": {
      "selector": "rss > channel > item"
    },
    "fields": {
      "category": {
        "selector": "[name=category]",
        "attribute": "value"
      },
      "title_phase1": {
        "selector": "title"
      },
      "title_vostfr": {
        "text": "{{ .Result.title_phase1 }}",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "(?i)\\b(vostfr|subfrench)\\b",
              "ENGLISH"
            ],
            "engine": "regexp2"
          }
        ]
      },
      "title_phase2": {
        "text": "{{ if .Config.vostfr }}{{ .Result.title_vostfr }}{{ else }}{{ .Result.title_phase1 }}{{ end }}"
      },
      "title_multilang": {
        "text": "{{ .Result.title_phase2 }}",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "(?i)\\b(MULTI(?!.*(?:FRENCH|ENGLISH|VOSTFR|VF2|VFF|VFQ|VOQ|VFI|VOF)))\\b",
              "{{ .Config.multilanguage }}"
            ],
            "engine": "regexp2"
          }
        ]
      },
      "title": {
        "text": "{{ if .Config.multilang }}{{ .Result.title_multilang }}{{ else }}{{ .Result.title_phase2 }}{{ end }}"
      },
      "details": {
        "selector": "comments",
        "filters": [
          {
            "name": "replace",
            "args": [
              "/torrents/",
              "/torrent/"
            ]
          }
        ]
      },
      "download": {
        "selector": "enclosure",
        "attribute": "url"
      },
      "imdbid": {
        "selector": "[name=imdbid]",
        "attribute": "value"
      },
      "tmdbid": {
        "selector": "[name=tmdbid]",
        "attribute": "value"
      },
      "tvdbid": {
        "selector": "[name=tvdbid]",
        "attribute": "value"
      },
      "date": {
        "selector": "pubDate",
        "filters": [
          {
            "name": "dateparse",
            "args": [
              "Mon, 02 Jan 2006 15:04:05 -07:00",
              "Mon, 02 Jan 2006 15:04:05 -0700"
            ]
          }
        ]
      },
      "size": {
        "selector": "[name=size]",
        "attribute": "value"
      },
      "seeders": {
        "selector": "[name=seeders]",
        "attribute": "value"
      },
      "leechers": {
        "selector": "[name=peers]",
        "attribute": "value"
      },
      "grabs": {
        "selector": "[name=grabs]",
        "attribute": "value"
      },
      "downloadvolumefactor": {
        "selector": "[name=downloadvolumefactor]",
        "attribute": "value"
      },
      "uploadvolumefactor": {
        "selector": "[name=uploadvolumefactor]",
        "attribute": "value"
      },
      "minimumratio": {
        "text": "0.51"
      }
    }
  },
  "source": {
