  "settings": [
    {
      "name": "username",
      "label": "Username",
      "type": "text"
    },
    {
      "name": "password",
      "label": "Password",
      "type": "password",
      "secret": true
    },
    {
      "name": "freeleech",
      "label": "Search freeleech only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "info_tpp",
      "label": "Results Per Page",
      "type": "info",
      "default": "For best results, change the <b>Torrents per page:</b> setting to <b>100</b> on your account profile."
    },
    {
      "name": "sort",
      "label": "Sort requested from site",
      "type": "select",
      "default": "s3",
      "options": {
        "s3": "created",
        "s6": "seeders",
        "s4": "size",
        "s1": "title"
      }
    },
    {
      "name": "type",
      "label": "Order requested from site",
      "type": "select",
      "default": "DESC",
      "options": {
        "DESC": "desc",
        "ASC": "asc"
      }
    },
    {
      "name": "info_activity",
      "label": "Account Inactivity",
      "type": "info",
      "default": "After 8 weeks of inactivity, the account will be automatically deleted."
    }
  ],
  "login": {
    "method": "post",
    "path": "login.php",
    "inputs": {
      "username": "{{ .Config.username }}",
      "password": "{{ .Config.password }}",
      "keeplogged": "1"
    },
    "error": [
      {
        "selector": "div#error-text"
      }
    ],
    "test": {
      "path": "index.php",
      "selector": "a[href^=\"logout.php?auth=\"]"
    }
  },
  "search": {
    "paths": [
      {
        "path": "torrents.php"
      }
    ],
    "inputs": {
      "$raw": "{{ range .Categories }}filter_cat[{{.}}]=1&{{end}}",
      "action": "{{ if .Config.freeleech }}uploadonly{{ else }}{{ end }}",
      "searchstr": "{{ .Keywords }}",
      "searchtags": "{{ .Query.Genre }}",
      "tags_type": "0",
      "order_by": "{{ .Config.sort }}",
      "order_way": "{{ .Config.type }}"
    },
    "rows": {
      "selector": "table#torrent_table > tbody > tr.torrent:has(a[href^=\"torrents.php?action=download&id=\"])"
    },
    "fields": {
      "category": {
        "selector": "a.c-sub",
        "attribute": "href",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "\\[(\\p{Nd}+)\\]"
            ]
          }
        ]
      },
      "title": {
        "selector": "a[href^=\"torrents.php?id=\"]"
      },
      "details": {
        "selector": "a[href^=\"torrents.php?id=\"]",
        "attribute": "href"
      },
      "download": {
        "selector": "a[href^=\"torrents.php?action=download&id=\"]",
        "attribute": "href"
      },
      "poster": {
        "selector": "a[href^=\"torrents.php?id=\"]",
        "attribute": "onmouseover",
        "optional": true,
        "filters": [
          {
            "name": "regexp",
            "args": [
              "src=(.+?) "
            ]
          }
        ]
      },
      "genre": {
        "selector": "div.tags",
        "optional": true
      },
      "description": {
        "optional": true,
        "text": "{{ .Result.genre }}"
      },
      "date": {
        "selector": "td:nth-last-child(5)",
        "filters": [
          {
            "name": "append",
            "args": [
              " +01:00"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "02 Jan 2006, 15:04 -07:00",
              "02 Jan 2006, 15:04 -0700"
            ]
          }
        ]
      },
      "size": {
        "selector": "td:nth-last-child(4)"
      },
      "grabs": {
        "selector": "td:nth-last-child(3)"
      },
      "seeders": {
        "selector": "td:nth-last-child(2)"
      },
      "leechers": {
        "selector": "td:nth-last-child(1)"
      },
      "downloadvolumefactor": {
        "case": {
          "strong:contains(\"UploadOnly!\")": "0",
          "*": "1"
        }
      },
      "uploadvolumefactor": {
        "text": "1"
      },
      "minimumratio": {
        "text": "0.8"
      },
      "minimumseedtime": {
        "text": "259200"
      }
    }
  },
