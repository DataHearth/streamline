  "settings": [
    {
      "name": "username",
      "label": "Username",
      "type": "text"
    },
    {
      "name": "password",
      "label": "Password",
      "type": "password",
      "secret": true
    },
    {
      "name": "multilang",
      "label": "Replace MULTi by another language in release name",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "multilanguage",
      "label": "Replace MULTi by this language",
      "type": "select",
      "default": "POLISH",
      "options": {
        "POLISH": "POLISH",
        "MULTi POLISH": "MULTi POLISH"
      }
    },
    {
      "name": "info_flaresolverr",
      "type": "info_flaresolverr"
    },
    {
      "name": "info_limit",
      "label": "Download Limit",
      "type": "info",
      "default": "If your downloads fail then access the site with your browser and check your messages, you've likely exceeded your limit."
    },
    {
      "name": "info_zero",
      "label": "Zero Results",
      "type": "info",
      "default": "If the indexer starts to return zero results then access the <a href=\"https://devil-torrents.pl/szukaj.php?today=1\" target=\"_blank\">Devil-Torrents search page</a>, you may have a notice you need to read first."
    }
  ],
  "login": {
    "method": "form",
    "path": "logowanie",
    "form": "form[action=\"takelogin.php\"]",
    "captcha": {
      "type": "image",
      "selector": "img[src^=\"img.php?size=3\"]",
      "input": "vImageCodP"
    },
    "inputs": {
      "username": "{{ .Config.username }}",
      "password": "{{ .Config.password }}",
      "returnto": ""
    },
    "error": [
      {
        "selector": "div#center-side:contains(\"Logowanie nie\")"
      }
    ],
    "test": {
      "path": "/",
      "selector": "a[href$=\"/logout.php\"]"
    }
  },
  "search": {
    "paths": [
      {
        "path": "szukaj.php"
      }
    ],
    "inputs": {
      "typ": "torrent",
      "search": "{{ .Keywords }}",
      "search_in_descr": "{{ if .Keywords }}{{ else }}1{{ end }}"
    },
    "rows": {
      "selector": "div.search-torrent-card"
    },
    "fields": {
      "category": {
        "selector": "span.search-cat-badge",
        "case": {
          "span.search-cat-badge:contains(\"Filmy XviD/DivX\")": "1",
          "span.search-cat-badge:contains(\"Filmy 4K\")": "748",
          "span.search-cat-badge:contains(\"Filmy Blu-Ray/HD\")": "4",
          "span.search-cat-badge:contains(\"Filmy x264/h264\")": "642",
          "span.search-cat-badge:contains(\"Filmy x265/h265\")": "596",
          "span.search-cat-badge:contains(\"Filmy DVD\")": "3",
          "span.search-cat-badge:contains(\"Filmy 3D\")": "5",
          "span.search-cat-badge:contains(\"TV/Seriale\")": "7",
          "span.search-cat-badge:contains(\"TS/CAM\")": "702",
          "span.search-cat-badge:contains(\"Erotyka\")": "8",
          "span.search-cat-badge:contains(\"Muzyka\")": "10",
          "span.search-cat-badge:contains(\"Programy\")": "11",
          "span.search-cat-badge:contains(\"GSM/PDA\")": "12",
          "span.search-cat-badge:contains(\"Konsole\")": "13",
          "span.search-cat-badge:contains(\"Gry PC\")": "14",
          "span.search-cat-badge:contains(\"Dla Dzieci\")": "15",
          "span.search-cat-badge:contains(\"Książki\")": "16",
          "span.search-cat-badge:contains(\"Mac\")": "525",
          "span.search-cat-badge:contains(\"Linux\")": "18",
          "span.search-cat-badge:contains(\"Sport\")": "19",
          "span.search-cat-badge:contains(\"Anime\")": "699",
          "span.search-cat-badge:contains(\"Inne\")": "21"
        }
      },
      "title_phase1": {
        "selector": "a[href^=\"/torrent/\"]",
        "attribute": "title"
      },
      "title_multilang": {
        "selector": "a[href^=\"/torrent/\"]",
        "attribute": "title",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "(?i)\\b(MULTI(?!.*(?:POLISH|ENGLISH|\\bPL\\b)))\\b",
              "{{ .Config.multilanguage }}"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\b(pl)\\b",
              "POLISH"
            ],
            "engine": "regexp2"
          }
        ]
      },
      "title": {
        "text": "{{ if .Config.multilang }}{{ .Result.title_multilang }}{{ else }}{{ .Result.title_phase1 }}{{ end }}"
      },
      "details": {
        "selector": "a[href^=\"/torrent/\"]",
        "attribute": "href"
      },
      "download": {
        "selector": "a[href^=\"download/\"]",
        "attribute": "href"
      },
      "poster": {
        "selector": "img.search-poster",
        "attribute": "data-src",
        "optional": true
      },
      "date": {
        "selector": "div.search-date-badge",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "(\\p{Nd}{4}-\\p{Nd}{2}-\\p{Nd}{2} \\p{Nd}{2}:\\p{Nd}{2}:\\p{Nd}{2})"
            ]
          },
          {
            "name": "append",
            "args": [
              " +01:00"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "2006-01-02 15:04:05 -07:00",
              "2006-01-02 15:04:05 -0700"
            ]
          }
        ]
      },
      "size": {
        "selector": "span.search-size-badge",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "(\\p{Nd}{1,4}\\.\\p{Nd}{2}[\\t-\\r\\x{85}\\p{Z}]+?[T|G|M|k]B)"
            ]
          }
        ]
      },
      "seeders": {
        "selector": "span[id^=\"seed_\"]"
      },
      "leechers": {
        "selector": "span[id^=\"peer_\"]"
      },
      "grabs": {
        "selector": "span:contains(\"Pobrano\")",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "Pobrano:(\\p{Nd}{1,4})"
            ]
          }
        ]
      },
      "downloadvolumefactor": {
        "text": "0"
      },
      "uploadvolumefactor": {
        "text": "1"
      }
    }
  },
  "source": {
    "path": "definitions/v11/devil-torrents.yml",
