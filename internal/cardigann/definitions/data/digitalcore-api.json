  "settings": [
    {
      "name": "apikey",
      "label": "APIKey",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_key",
      "label": "About your API key",
      "type": "info",
      "default": "Generate a new API Key by accessing your <a href=\"https://digitalcore.club/\" target=\"_blank\">DigitalCore</a> account <i>Settings</i> page and clicking on the <b>Security</b> tab."
    },
    {
      "name": "freeleech",
      "label": "Search freeleech only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "p2p_releases_only",
      "label": "Search P2P releases only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "unrar_releases_only",
      "label": "Search UNRAR releases only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "sort",
      "label": "Sort requested from site",
      "type": "select",
      "default": "d",
      "options": {
        "d": "created",
        "up": "seeders",
        "s": "size",
        "n": "title"
      }
    },
    {
      "name": "type",
      "label": "Order requested from site",
      "type": "select",
      "default": "desc",
      "options": {
        "desc": "desc",
        "asc": "asc"
      }
    },
    {
      "name": "info_activity",
      "label": "Account Inactivity",
      "type": "info",
      "default": "If your account is inactive (you do not sign in) for more than 90 days, your account is disabled. Park your account if you are going away for long periods."
    }
  ],
  "login": {
    "method": "get",
    "path": "/api/v1/torrents"
  },
  "search": {
    "paths": [
      {
        "path": "api/v1/torrents",
        "response": {
          "type": "json",
          "noResultsMessage": ""
        }
      }
    ],
    "inputs": {
      "$raw": "{{ range .Categories }}categories[]={{.}}&{{end}}",
      "dead": "true",
      "extendedDead": "true",
      "extendedSearch": "false",
      "freeleech": "{{ if .Config.freeleech }}true{{ else }}false{{ end }}",
      "index": "0",
      "limit": "100",
      "order": "{{ .Config.type }}",
      "p2p": "{{ if .Config.p2p_releases_only }}true{{ else }}{{ end }}",
      "page": "search",
      "searchText": "{{ if .Query.IMDBID }}{{ .Query.IMDBID }} {{ else }}{{ end }}{{ .Keywords }}",
      "section": "all",
      "sort": "{{ .Config.sort }}",
      "stereoscopic": "false",
      "unrar": "{{ if .Config.unrar_releases_only }}true{{ else }}{{ end }}",
      "watchview": "false"
    },
    "headers": {
      "X-API-KEY": [
        "{{ .Config.apikey }}"
      ]
    },
    "rows": {
      "selector": "$",
      "filters": [
        {
          "name": "andmatch"
        }
      ]
    },
    "fields": {
      "category": {
        "selector": "category"
      },
      "title": {
        "selector": "name"
      },
      "_id": {
        "selector": "id"
      },
      "details": {
        "text": "/torrent/{{ .Result._id }}/"
      },
      "download": {
        "text": "/api/v1/torrents/download/{{ .Result._id }}"
      },
      "imdbid": {
        "selector": "imdbid2"
      },
      "imdbid_full": {
        "selector": "imdbid2",
        "optional": true
      },
      "poster_normal": {
        "selector": "firstpic",
        "optional": true
      },
      "poster_imdb": {
        "optional": true,
        "text": "{{ if .Result.imdbid }}/img/imdb/{{ .Result.imdbid_full }}.jpg{{ else }}{{ end }}"
      },
      "poster": {
        "text": "{{ if .Result.poster_imdb }}{{ .Result.poster_imdb }}{{ else }}{{ .Result.poster_normal }}{{ end }}"
      },
      "date": {
        "selector": "added",
        "filters": [
          {
            "name": "append",
            "args": [
              " +02:00"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "2006-01-02 15:04:05 -07:00",
              "2006-01-02 15:04:05 -0700"
            ]
          }
        ]
      },
      "size": {
        "selector": "size"
      },
      "files": {
        "selector": "numfiles"
      },
      "grabs": {
        "selector": "times_completed"
      },
      "seeders": {
        "selector": "seeders"
      },
      "leechers": {
        "selector": "leechers"
      },
      "downloadvolumefactor": {
        "selector": "frileech",
        "case": {
          "0": "1",
          "1": "0"
        }
      },
      "uploadvolumefactor": {
        "text": "1"
      },
      "minimumratio": {
        "text": "1.0"
      },
      "minimumseedtime": {
        "text": "432000"
      },
      "title_desc": {
        "selector": "title",
        "optional": true
      },
      "year": {
        "selector": "year",
        "optional": true
      },
      "genre": {
        "selector": "genres"
      },
      "_tagline_desc": {
        "selector": "tagline",
        "optional": true
      },
      "_cast_desc": {
        "selector": "cast",
        "optional": true
      },
      "_rating_desc": {
        "selector": "rating",
        "optional": true,
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "^0$",
              ""
            ],
            "engine": "regexp2"
          }
        ]
      },
      "_section_desc": {
        "selector": "section",
        "optional": true
      },
      "_predate_desc": {
        "selector": "preDate",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "0000-00-00 00:00:00",
              ""
            ]
          }
        ]
      },
      "_p2ptag": {
        "selector": "p2p",
        "case": {
          "0": "",
          "1": "P2P"
        }
      },
      "_unrartag": {
        "selector": "unrar",
        "optional": true,
        "case": {
          "0": "",
          "1": "UNRAR"
        }
      },
      "_packtag": {
        "selector": "pack",
        "case": {
          "0": "",
          "1": "Pack"
        }
      },
      "_reqidtag": {
        "selector": "reqid",
        "case": {
          "0": "",
          "*": "Request"
        }
      },
      "_tag_desc": {
        "optional": true,
        "text": "{{ if .Result._p2ptag }}{{ .Result._p2ptag }}, {{ else }}{{ end }}{{ if .Result._unrartag }}{{ .Result._unrartag }}, {{ else }}{{ end }}{{ if .Result._packtag }}{{ .Result._packtag }}, {{ else }}{{ end }}{{ if .Result._reqidtag }}{{ .Result._reqidtag }}{{ else }}{{ end }}",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "(.+?), $"
            ],
            "engine": "regexp2"
          }
        ]
      },
      "description": {
        "text": "{{ if .Result.title_desc }}Title: {{ .Result.title_desc }}</br>{{ else }}{{ end }}{{ if .Result.year }}Year: {{ .Result.year }}</br>{{ else }}{{ end }}{{ if .Result.genre }}Genres: {{ .Result.genre }}</br>{{ else }}{{ end }}{{ if .Result._tagline_desc }}Tagline: {{ .Result._tagline_desc }}</br>{{ else }}{{ end }}{{ if .Result._cast_desc }}Cast: {{ .Result._cast_desc }}</br>{{ else }}{{ end }}{{ if .Result._rating_desc }}Rating: {{ .Result._rating_desc }}</br>{{ else }}{{ end }}{{ if .Result._tag_desc }}Tags: {{ .Result._tag_desc }}</br>{{ else }}{{ end }}{{ if .Result._predate_desc }}PRE: {{ .Result._predate_desc }}</br>{{ else }}{{ end }}{{ if .Result._section_desc }}Section: {{ .Result._section_desc }}{{ else }}{{ end }}"
      }
    }
  },
  "source": {
    "path": "definitions/v11/digitalcore-api.yml",
    "sha256": "d7c61689e912bea1b301d06ef5d38ddde1ac09c714327a8d374be3f2154a9ad1",
