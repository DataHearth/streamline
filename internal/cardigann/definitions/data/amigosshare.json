  "settings": [
    {
      "name": "cookie",
      "label": "Cookie",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_cookie",
      "type": "info_cookie"
    },
    {
      "name": "info_login",
      "label": "About the Cookie",
      "type": "info",
      "default": "Remeber to tick <b>Lembrar-me</b> when logging in so the cookie will lasts longer."
    },
    {
      "name": "freeleech",
      "label": "Search freeleech only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "sort",
      "label": "Sort requested from site",
      "type": "select",
      "default": "released_at",
      "options": {
        "released_at": "created",
        "seeders": "seeders",
        "times_completed": "grabs",
        "size": "size",
        "name": "title"
      }
    },
    {
      "name": "type",
      "label": "Order requested from site",
      "type": "select",
      "default": "desc",
      "options": {
        "desc": "desc",
        "asc": "asc"
      }
    },
    {
      "name": "info_activity",
      "label": "Account Inactivity",
      "type": "info",
      "default": "Inactive accounts, that is, without access for 90 days (3 months), will be automatically deleted by the system; with no possibility of reactivation."
    }
  ],
  "login": {
    "method": "cookie",
    "inputs": {
      "cookie": "{{ .Config.cookie }}"
    },
    "test": {
      "path": "dashboard",
      "selector": "script[data-page=\"app\"]:contains('\"user\":{\"id\":')"
    }
  },
  "search": {
    "paths": [
      {
        "path": "torrents"
      }
    ],
    "inputs": {
      "q": "{{ if .Query.IMDBID }}{{ .Query.IMDBID }}{{ else }}{{ .Keywords }}{{ end }}",
      "freeleech": "{{ if .Config.freeleech }}1{{ else }}{{ end }}",
      "sort": "{{ .Config.sort }}",
      "direction": "{{ .Config.type }}",
      "per_page": "96"
    },
    "keywordsfilters": [
      {
        "name": "re_replace",
        "args": [
          "([\\t-\\r\\x{85}\\p{Z}]+:[\\t-\\r\\x{85}\\p{Z}]+)",
          " "
        ]
      },
      {
        "name": "re_replace",
        "args": [
          "(\\s*\\b((19|20)\\d{2})\\b)",
          ""
        ],
        "engine": "regexp2"
      }
    ],
    "preprocessingfilters": [
      {
        "name": "regexp",
        "args": [
          "\"torrents\":\\{\"current_page\":\\p{Nd}+,\"data\":\\[(.*?)\\],\"first_page_url\""
        ]
      },
      {
        "name": "re_replace",
        "args": [
          "(\\{\"id\":\\d+,.*?\\})(?=,\\{\"id\":\\d+,|$)",
          "<div class=\"torrent\">$1</div>"
        ],
        "engine": "regexp2"
      }
    ],
    "rows": {
      "selector": "div.torrent"
    },
    "fields": {
      "_id": {
        "filters": [
          {
            "name": "regexp",
            "args": [
              "\"id\":(\\p{Nd}+)"
            ]
          }
        ]
      },
      "category": {
        "filters": [
          {
            "name": "regexp",
            "args": [
              "\"categoryId\":(\\p{Nd}+)"
            ]
          }
        ]
      },
      "_name": {
        "filters": [
          {
            "name": "regexp",
            "args": [
              "\"name\":(\"(?:[^\"\\\\]|\\\\.)*\")"
            ]
          },
          {
            "name": "prepend",
            "args": [
              "{\"v\":["
            ]
          },
          {
            "name": "append",
            "args": [
              "]}"
            ]
          },
          {
            "name": "jsonjoinarray",
            "args": [
              "$.v",
              ""
            ]
          }
        ]
      },
      "_year": {
        "optional": true,
        "filters": [
          {
            "name": "regexp",
            "args": [
              "\"year\":(\\p{Nd}{4})"
            ]
          }
        ]
      },
      "_badges": {
        "optional": true,
        "filters": [
          {
            "name": "regexp",
            "args": [
              "\"badges\":\\[(.*?)\\]"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "\\{\"label\":\"(?:[^\"\\\\]|\\\\.)*\",\"kind\":\"(?!(?:resolution|source|hdr|codec)\")[^\"]*\"\\},?",
              ""
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "\\{\"label\":\"((?:[^\"\\\\]|\\\\.)*)\",\"kind\":\"[^\"]*\"\\},?",
              "${1} "
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "\\b4K\\b",
              "2160p"
            ],
            "engine": "regexp2"
          },
          {
            "name": "trim"
          }
        ]
      },
      "_audio": {
        "optional": true,
        "filters": [
          {
            "name": "regexp",
            "args": [
              "\\{\"label\":\"((?:[^\"\\\\]|\\\\.)*)\",\"kind\":\"audio\"\\}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "^Dual.*$",
              "Dual-Audio Brazilian Original"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "^Dublado$",
              "Dublado Brazilian"
            ],
            "engine": "regexp2"
          }
        ]
      },
      "title": {
        "text": "{{ .Result._name }}",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "^(.*?)[\\(](.*?)[\\)](.*?)$",
              "$2$3"
            ],
            "engine": "regexp2"
          },
          {
            "name": "append",
            "args": [
              "{{ if .Result._year }} {{ .Result._year }}{{ else }}{{ end }}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "^(.*?)\\s+-\\s+(S\\d{1,2}(?:E\\d{1,4}(?:E\\d{1,4})*)?)\\s+((?:19|20)\\d{2})(.*)$",
              "$1 $3 $2$4"
            ],
            "engine": "regexp2"
          },
          {
            "name": "append",
            "args": [
              "{{ if .Result._badges }} {{ .Result._badges }}{{ else }}{{ end }}"
            ]
          },
          {
            "name": "append",
            "args": [
              "{{ if .Result._audio }} {{ .Result._audio }}{{ else }}{{ end }}"
            ]
          }
        ]
      },
      "details": {
        "text": "/torrents/{{ .Result._id }}"
      },
      "download": {
        "text": "/torrents/{{ .Result._id }}/download"
      },
      "poster": {
        "filters": [
          {
            "name": "regexp",
            "args": [
              "\"cover\":\"([^\"]+)\""
            ]
          },
          {
            "name": "replace",
            "args": [
              "\\/",
              "/"
            ]
          }
        ]
      },
      "date": {
        "filters": [
          {
            "name": "regexp",
            "args": [
              "\"releasedAt\":\"([^\"]+)\""
            ]
          },
          {
            "name": "append",
            "args": [
              " +00:01"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "2006-01-02 -07:00",
              "2006-01-02 -0700"
            ]
          }
        ]
      },
      "size": {
        "filters": [
          {
            "name": "regexp",
            "args": [
              "\"size\":(\\p{Nd}+)"
            ]
          }
        ]
      },
      "seeders": {
        "filters": [
          {
            "name": "regexp",
            "args": [
              "\"seeders\":(\\p{Nd}+)"
            ]
          }
        ]
      },
      "leechers": {
        "filters": [
          {
            "name": "regexp",
            "args": [
              "\"leechers\":(\\p{Nd}+)"
            ]
          }
        ]
      },
      "grabs": {
        "filters": [
          {
            "name": "regexp",
            "args": [
              "\"timesCompleted\":(\\p{Nd}+)"
            ]
          }
        ]
      },
      "genre": {
        "filters": [
          {
            "name": "jsonjoinarray",
            "args": [
              "$.genres",
              ", "
            ]
          }
        ]
      },
      "description": {
        "text": "{{ .Result.genre }}"
      },
      "downloadvolumefactor": {
        "filters": [
          {
            "name": "regexp",
            "args": [
              "\"freeleech\":(true|false)"
            ]
          },
          {
            "name": "replace",
            "args": [
              "true",
              "0"
            ]
          },
          {
            "name": "replace",
            "args": [
              "false",
              "1"
            ]
          }
        ]
      },
      "uploadvolumefactor": {
        "filters": [
          {
            "name": "regexp",
            "args": [
              "\"doubleUpload\":(true|false)"
            ]
          },
          {
            "name": "replace",
            "args": [
              "true",
              "2"
            ]
          },
          {
            "name": "replace",
            "args": [
              "false",
              "1"
            ]
          }
        ]
      },
      "minimumratio": {
        "text": "1.0"
      }
    }
  },
  "source": {
    "path": "definitions/v11/amigosshare.yml",
