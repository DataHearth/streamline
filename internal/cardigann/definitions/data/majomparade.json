    },
    {
      "name": "info_useragent",
      "type": "info_useragent"
    },
    {
      "name": "sort",
      "label": "Sort requested from site",
      "type": "select",
      "default": "0",
      "options": {
        "0": "created",
        "5": "seeders",
        "3": "size",
        "1": "title"
      }
    },
    {
      "name": "type",
      "label": "Order requested from site",
      "type": "select",
      "default": "0",
      "options": {
        "0": "desc",
        "1": "asc"
      }
    },
    {
      "name": "info_tpp",
      "label": "Results Per Page",
      "type": "info",
      "default": "For best results, change the <b>Torrentek oldalanként:</b> setting to <b>100</b> on your account profile."
    },
    {
      "name": "info_activity",
      "label": "Account Inactivity",
      "type": "info",
      "default": "Users who have been inactive for more than 25 weeks are automatically deleted."
    }
  ],
  "login": {
    "method": "cookie",
    "inputs": {
      "cookie": "{{ .Config.cookie }}"
    },
    "test": {
      "path": "index",
      "selector": "a[href^=\"/logout/\"]"
    }
  },
  "search": {
    "paths": [
      {
        "path": "torrents/",
        "categories": [
          "2",
