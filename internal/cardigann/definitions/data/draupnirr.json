    "modes": {
      "search": [
        "q"
      ],
      "tv-search": [
        "q",
        "season",
        "ep",
        "imdbid",
        "tmdbid"
      ],
      "movie-search": [
        "q",
        "imdbid",
        "tmdbid"
      ],
      "music-search": [
        "q"
      ],
      "book-search": [
        "q"
      ]
    },
    "allowrawsearch": true
  },
  "settings": [
    {
      "name": "apikey",
      "label": "API Key",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_key",
      "label": "About your API key",
      "type": "info",
      "default": "Your API key is your personal announce key. You can find it on your <b>Profil › Paramètres</b> page on the site."
    },
    {
      "name": "multilang",
      "label": "Replace MULTi by another language in release name",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "multilanguage",
      "label": "Replace MULTi by this language",
      "type": "select",
      "default": "FRENCH",
      "options": {
        "FRENCH": "FRENCH",
        "MULTi.FRENCH": "MULTi.FRENCH",
        "ENGLISH": "ENGLISH",
        "MULTi.ENGLISH": "MULTi.ENGLISH",
        "VOSTFR": "VOSTFR",
        "MULTi.VOSTFR": "MULTi.VOSTFR"
      }
    },
    {
      "name": "vostfr",
      "label": "Replace VOSTFR and SUBFRENCH with ENGLISH",
      "type": "checkbox",
      "default": "false"
    }
  ],
  "login": {
    "method": "get",
    "path": "torznab/api",
    "inputs": {
      "apikey": "{{ .Config.apikey }}",
      "t": "caps"
    },
    "error": [
      {
        "selector": "error[code]",
        "message": {
          "selector": "error[code]",
          "attribute": "description"
        }
      }
    ]
  },
  "search": {
    "paths": [
      {
        "path": "torznab/api",
        "response": {
          "type": "xml"
        }
      }
    ],
    "inputs": {
      "apikey": "{{ .Config.apikey }}",
      "t": "{{ if .Query.Type }}{{ .Query.Type }}{{ else }}search{{ end }}",
      "q": "{{ .Keywords }}",
      "cat": "{{ join .Categories \",\" }}",
      "imdbid": "{{ .Query.IMDBID }}",
      "tmdbid": "{{ .Query.TMDBID }}",
      "limit": "100"
    },
    "rows": {
      "selector": "rss > channel > item"
    },
    "fields": {
      "category": {
        "selector": "[name=category]",
        "attribute": "value"
      },
      "title_phase1": {
        "selector": "title"
      },
      "title_vostfr": {
        "text": "{{ .Result.title_phase1 }}",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "(?i)\\b(vostfr|subfrench)\\b",
              "ENGLISH"
            ],
            "engine": "regexp2"
          }
        ]
      },
      "title_phase2": {
        "text": "{{ if .Config.vostfr }}{{ .Result.title_vostfr }}{{ else }}{{ .Result.title_phase1 }}{{ end }}"
      },
      "title_multilang": {
        "text": "{{ .Result.title_phase2 }}",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "(?i)\\b(MULTI(?!.*(?:FRENCH|ENGLISH|VOSTFR|VF2|VFF|VFQ|VOQ|VFI|VOF)))\\b",
              "{{ .Config.multilanguage }}"
            ],
            "engine": "regexp2"
          }
        ]
      },
      "title": {
        "text": "{{ if .Config.multilang }}{{ .Result.title_multilang }}{{ else }}{{ .Result.title_phase2 }}{{ end }}"
      },
      "details": {
        "selector": "comments"
      },
      "download": {
        "selector": "enclosure",
        "attribute": "url"
      },
      "imdbid": {
        "selector": "[name=imdb]",
        "attribute": "value",
        "optional": true
      },
      "tmdbid": {
        "selector": "[name=tmdbid]",
        "attribute": "value",
        "optional": true
      },
      "date": {
        "selector": "pubDate",
        "filters": [
          {
            "name": "dateparse",
            "args": [
              "Mon, 02 Jan 2006 15:04:05 -07:00",
              "Mon, 02 Jan 2006 15:04:05 -0700"
            ]
          }
        ]
      },
      "size": {
        "selector": "size"
      },
      "files": {
        "selector": "files"
      },
      "grabs": {
        "selector": "grabs"
      },
      "seeders": {
        "selector": "[name=seeders]",
        "attribute": "value"
      },
      "leechers": {
        "selector": "[name=leechers]",
        "attribute": "value"
      },
      "downloadvolumefactor": {
        "selector": "[name=downloadvolumefactor]",
        "attribute": "value"
      },
      "uploadvolumefactor": {
        "selector": "[name=uploadvolumefactor]",
        "attribute": "value"
      },
      "minimumseedtime": {
        "selector": "[name=minimumseedtime]",
        "attribute": "value"
      },
      "minimumratio": {
        "selector": "[name=minimumratio]",
        "attribute": "value",
        "optional": true
      }
    }
  },
  "source": {
    "path": "definitions/v11/draupnirr.yml",
