  "name": "Draupnirr",
  "description": "Draupnirr (Yggrasil) is a FRENCH Semi-Private Torrent Tracker for MOVIES / TV / GENERAL",
  "language": "fr-FR",
  "type": "semi-private",
  "encoding": "UTF-8",
  "requestDelay": 0.5,
  "links": [
    "https://draupnirr.xyz/"
  ],
  "legacylinks": [
    "https://yggrasil.xyz/"
  ],
