{
  "id": "torrentccf",
  "name": "TorrentCCF",
  "description": "TorrentCCF (TCCF) is a CHINESE Private Torrent Tracker for HD MOVIES / TV",
  "language": "zh-CN",
  "type": "private",
  "encoding": "UTF-8",
  "links": [
    "https://et8.org/"
  ],
  "legacylinks": [
    "http://et8.org/"
  ],
  "caps": {
