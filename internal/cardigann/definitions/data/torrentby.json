{
  "id": "torrentby",
  "name": "torrent.by",
  "description": "torrent.by is a BELARUSIAN Public Torrent Tracker",
  "language": "ru-RU",
  "type": "public",
  "encoding": "UTF-8",
  "requestDelay": 5,
  "links": [
    "https://torrent.by/"
  ],
  "legacylinks": [
    "http://torrent.by/"
  ],
  "certificates": [
    "86d0328f79c36c9f716c8fe6df8a06351ab6e20c"
  ],
  "caps": {
    "categories": {
      "Other": "Other"
    },
    "modes": {
      "search": [
        "q"
      ],
      "tv-search": [
        "q",
        "season",
        "ep"
      ],
      "movie-search": [
        "q"
      ],
      "music-search": [
        "q"
      ],
      "book-search": [
        "q"
      ]
    }
  },
  "settings": [
    {
      "name": "stripcyrillic",
      "label": "Strip Cyrillic Letters",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "addrussiantotitle",
      "label": "Add RUS to end of all titles to improve language detection by Sonarr and Radarr. Will cause English-only results to be misidentified.",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "info_category_8000",
      "type": "info_category_8000"
    }
  ],
  "search": {
    "paths": [
      {
        "path": "{{ if .Keywords }}search/?search={{ .Keywords }}&category=0{{ else }}today/{{ end }}"
      }
    ],
    "keywordsfilters": [
      {
        "name": "re_replace",
        "args": [
          "(?i)\\b(?:[SE]\\d{1,4}){1,2}\\b\\s?",
          ""
        ]
      }
    ],
    "rows": {
      "selector": "tr[class^=\"ttable_col\"]"
    },
    "fields": {
      "category": {
        "text": "other"
      },
      "title": {
        "selector": "td:nth-child(3) a",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "(?i)(\\d+(?:-\\d+)?)[xх](\\d+(?:-\\d+)?)\\s*из\\s*(\\d+)",
              "S${1}E${2} of ${3}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)(\\d+(?:-\\d+)?)[xх](\\d+(?:-\\d+)?)",
              "S${1}E${2}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)(\\d+(?:-\\d+)?)\\s*из\\s*(\\d+)",
              "E${1} of ${2}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\bFiles-х\\b",
              "Files-x"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\sот\\s([\\w\\p{P}\\p{S}]+)$",
              "-${1}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "\\s\\|\\s(\\w{4,})$",
              "-${1}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(\\([\\p{Cyrillic}\\W]+\\))|(^[\\p{Cyrillic}\\W\\d]+\\/ )|([\\p{Cyrillic} \\-]+,+)|([\\p{Cyrillic}]+)",
              "{{ if .Config.stripcyrillic }}{{ else }}${1}${2}${3}${4}{{ end }}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\bHDTV[-\\s]?Rip\\b",
              "HDTV"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\bSAT[-\\s]?Rip\\b",
              "HDTV"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\bWEB[-\\s]?DL[-\\s]?Rip\\b",
              "WEB-DL"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\bWEB\\sRip\\b",
              "WEBRip"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\bWEB\\sDL\\b",
              "WEB-DL"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "[\\[\\(\\{<«][\\s\\W]*[\\]\\)\\}>»]",
              ""
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "^[\\s&,\\.!\\?\\+\\-_\\|\\/':]+",
              ""
            ]
          },
          {
            "name": "append",
            "args": [
              "{{ if .Config.addrussiantotitle }} RUS{{ else }}{{ end }}"
            ]
          }
        ]
      },
      "details": {
        "selector": "td:nth-child(3) a",
        "attribute": "href"
      },
      "download": {
        "selector": "a.dwnld",
        "attribute": "href"
      },
      "magnet": {
        "selector": "a[href^=\"magnet:?xt=\"]",
        "attribute": "href"
      },
      "size": {
        "selector": "td:nth-child(5)"
      },
      "seeders": {
        "selector": "font[color=\"green\"]"
      },
      "leechers": {
        "selector": "font[color=\"red\"]"
      },
      "date_day": {
        "selector": "td:nth-child(1):contains(\"Вчера\"), td:nth-child(1):contains(\"Сегодня\")",
        "optional": true,
        "filters": [
          {
            "name": "replace",
            "args": [
              "Вчера",
              "Yesterday"
            ]
          },
          {
            "name": "replace",
            "args": [
              "Сегодня",
              "Today"
            ]
          },
          {
            "name": "fuzzytime"
          }
        ]
      },
      "date_year": {
        "selector": "td:nth-child(1):contains(\"-\")",
        "optional": true,
        "filters": [
          {
            "name": "append",
            "args": [
              " +03:00"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "2006-01-02 -07:00"
            ]
          }
        ]
      },
      "date": {
        "text": "{{ if or .Result.date_year .Result.date_day }}{{ or .Result.date_year .Result.date_day }}{{ else }}now{{ end }}"
      },
      "downloadvolumefactor": {
        "text": "0"
      },
      "uploadvolumefactor": {
        "text": "1"
      },
      "description": {
        "selector": "td:nth-child(3) a"
      }
    }
  },
  "source": {
    "path": "definitions/v11/torrentby.yml",
    "sha256": "6f50a1debf750add40e63dd7e87094a0654755cea86e18f311902f45d2c7b7d4",
    "modified": "converted by streamline's internal/cardigann/convert: YAML to JSON; .NET regexes, substitutions, date layouts and template string literals rewritten for Go"
  }
}
