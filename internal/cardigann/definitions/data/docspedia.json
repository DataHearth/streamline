  "settings": [
    {
      "name": "cookie",
      "label": "Cookie",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_cookie",
      "type": "info_cookie"
    },
    {
      "name": "freeleech",
      "label": "Search freeleech only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "sort",
      "label": "Sort requested from site",
      "type": "select",
      "default": "4",
      "options": {
        "4": "created",
        "7": "seeders",
        "5": "size",
        "1": "title"
      }
    },
    {
      "name": "type",
      "label": "Order requested from site",
      "type": "select",
      "default": "desc",
      "options": {
        "desc": "desc",
        "asc": "asc"
      }
    },
    {
      "name": "info_tpp",
      "label": "Results Per Page",
      "type": "info",
      "default": "For best results, change the <b>Torrents per page:</b> setting to <b>100</b> on your account profile."
    },
    {
      "name": "info_activity",
      "label": "Account Inactivity",
      "type": "info",
      "default": "Accounts without activity in the first 28 days will be deleted automatically by the system."
    }
  ],
  "login": {
    "method": "cookie",
    "inputs": {
      "cookie": "{{ .Config.cookie }}"
    },
    "test": {
      "path": "my.php",
      "selector": "a[href$=\"logout.php\"]"
    }
  },
  "search": {
    "paths": [
      {
        "path": "browse.php"
      }
    ],
    "inputs": {
      "$raw": "{{ range .Categories }}c{{.}}=1&{{end}}",
      "search": "{{ .Keywords }}",
      "incldead": "0",
      "free": "{{ if .Config.freeleech }}1{{ else }}{{ end }}",
      "sort": "{{ .Config.sort }}",
      "type": "{{ .Config.type }}"
    },
    "rows": {
      "selector": "table.torrent-table > tbody > tr:has(a[href^=\"download.php?torrent=\"])",
      "filters": [
        {
          "name": "andmatch"
        }
      ]
    },
    "fields": {
      "category": {
        "selector": "a[href^=\"browse.php?cat=\"]",
        "attribute": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "cat"
            ]
          }
        ]
      },
      "title": {
        "selector": "a[href^=\"details.php?id=\"]"
      },
      "details": {
        "selector": "a[href^=\"details.php?id=\"]",
        "attribute": "href"
      },
      "download": {
        "selector": "a[href^=\"download.php?torrent=\"]",
        "attribute": "href"
      },
      "poster": {
        "selector": "a[href^=\"details.php?id=\"]",
        "attribute": "data-poster"
      },
      "date": {
        "text": "now"
      },
      "size": {
        "selector": "td.tt-size"
      },
      "grabs": {
        "selector": "a.val-grab",
        "optional": true,
        "default": "0"
      },
      "seeders": {
        "selector": "a.val-seed",
        "optional": true,
        "default": "0"
      },
      "leechers": {
        "selector": "a.val-leech",
        "optional": true,
        "default": "0"
      },
      "downloadvolumefactor": {
        "case": {
          "span.tag-free": "0",
          "*": "1"
        }
      },
      "uploadvolumefactor": {
        "text": "1"
      },
      "minimumratio": {
        "text": "1.0"
      },
      "minimumseedtime": {
        "text": "172800"
      }
    }
  },
