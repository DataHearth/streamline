  "settings": [
    {
      "name": "username",
      "label": "Username",
      "type": "text"
    },
    {
      "name": "password",
      "label": "Password",
      "type": "password",
      "secret": true
    },
    {
      "name": "ip_filtering",
      "label": "IP Filtering",
      "type": "info",
      "default": "HD-CLUB allows only certain IP addressess. The error <b>Redirected to https://hd-czech.eu/blocked.php?country=xx</b> means your IP was not accepted."
    },
    {
      "name": "freeleech",
      "label": "Search freeleech only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "sort",
      "label": "Sort requested from site",
      "type": "select",
      "default": "3",
      "options": {
        "3": "created",
        "5": "seeders",
        "4": "size",
        "2": "title"
      }
    },
    {
      "name": "type",
      "label": "Order requested from site",
      "type": "select",
      "default": "2",
      "options": {
        "2": "desc",
        "1": "asc"
      }
    },
    {
      "name": "info",
      "label": "Results Per Page",
      "type": "info",
      "default": "For best results, change the <b>Torrents per page:</b> setting to <b>100</b> on your account profile."
    }
  ],
  "login": {
    "method": "post",
    "path": "index.php?page=login",
    "inputs": {
      "uid": "{{ .Config.username }}",
      "pwd": "{{ .Config.password }}"
    },
    "error": [
      {
        "selector": "td.lista span[style=\"color:#FF0000;\"]"
      }
    ],
    "test": {
      "path": "index.php",
      "selector": "a[href=\"logout.php\"]"
    }
  },
  "search": {
    "paths": [
      {
        "path": "index.php"
      }
    ],
    "inputs": {
      "page": "torrents",
      "search": "{{ .Keywords }}",
      "category": "{{ if .Categories }}{{ range .Categories }}{{.}};{{end}}{{ else }}0{{ end }}",
      "active": "0",
      "order": "{{ .Config.sort }}",
      "by": "{{ .Config.type }}"
    },
    "rows": {
      "selector": "table.benylista > tbody > tr:has(a[href^=\"download.php\"]):not(:has(a[href$=\"category=0\"]))"
    },
    "fields": {
      "category": {
        "selector": "a[href*=\"category=\"]",
        "attribute": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "category"
            ]
          }
        ]
      },
      "title": {
        "selector": "a[href^=\"index.php?page=torrent-details\"]"
      },
      "details": {
        "selector": "a[href^=\"index.php?page=torrent-details\"]",
        "attribute": "href"
      },
      "download": {
        "selector": "a[href^=\"download.php\"]",
        "attribute": "href"
      },
      "poster": {
        "selector": "img.small-img",
        "attribute": "src"
      },
      "date": {
        "selector": "td:nth-last-child(7)",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "(\\d{2}\\.\\d{2}\\.\\d{4} \\d{2}:\\d{2}:\\d{2})"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "02.01.2006 15:04:05"
            ]
          }
        ]
      },
      "size": {
        "selector": "td:nth-last-child(6)"
      },
      "seeders": {
        "selector": "td:nth-last-child(5)"
      },
      "leechers": {
        "selector": "td:nth-last-child(4)"
      },
      "grabs": {
        "selector": "td:nth-last-child(3)"
      },
      "_exclusive": {
        "optional": true,
        "case": {
          "img[src=\"beny/exclusive.png\"]": "Exclusive"
        }
      },
      "_vip": {
        "optional": true,
        "case": {
          "img[src=\"gold/free.gif\"]": "VIP"
        }
      },
      "description": {
        "text": "{{ if .Result._exclusive }}{{ .Result._exclusive }} {{ else }}{{ end }}{{ if .Result._vip }}{{ .Result._vip }}{{ else }}{{ end }}"
      },
      "downloadvolumefactor": {
        "case": {
          "img[src=\"gold/gold.gif\"]": "0",
          "img[src=\"gold/gold75.gif\"]": "0.25",
          "img[src=\"gold/gold50.gif\"]": "0.5",
          "img[src=\"gold/gold25.gif\"]": "0.75",
          "*": "1"
        }
      },
      "uploadvolumefactor": {
        "text": "1"
      },
      "minimumratio": {
        "text": "0.6"
      }
    }
  },
  "source": {
    "path": "definitions/v11/hd-club.yml",
