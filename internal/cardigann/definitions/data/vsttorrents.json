{
  "id": "vsttorrents",
  "name": "VST Torrentz",
  "description": "VST Torrentz is a Public site for AUDIO apps, plugins and samples",
  "language": "en-US",
  "type": "public",
  "encoding": "UTF-8",
  "links": [
    "https://vsttorrentz.net/"
  ],
  "legacylinks": [
    "https://vsttorrents.net/",
    "https://looptorrent.net/"
  ],
  "caps": {
    "categories": {
      "PC": "PC"
    },
    "modes": {
      "search": [
        "q"
      ]
    }
  },
  "settings": [],
  "search": {
    "paths": [
      {
        "path": "/"
      }
    ],
    "inputs": {
      "s": "{{ .Keywords }}"
    },
    "rows": {
      "selector": "article:has(.entry-title)",
      "filters": [
        {
          "name": "andmatch"
        }
      ]
    },
    "fields": {
      "category": {
        "text": "PC"
      },
      "title": {
        "selector": ".entry-title"
      },
      "details": {
        "selector": ".entry-title > a",
        "attribute": "href"
      },
      "download": {
        "selector": ".entry-title > a",
        "attribute": "href"
      },
      "poster": {
        "selector": ".wp-post-image",
        "attribute": "data-src",
        "optional": true
      },
      "description": {
        "selector": ".entry-summary",
        "optional": true
      },
      "date_year": {
        "selector": ".post-date",
        "optional": true
      },
      "date_time": {
        "selector": "time",
        "attribute": "datetime",
        "optional": true
      },
      "date": {
        "text": "{{ if or .Result.date_year .Result.date_time }}{{ or .Result.date_year .Result.date_time }}{{ else }}now{{ end }}"
      },
      "size": {
        "text": "512 MB"
      },
      "seeders": {
        "text": "1"
      },
      "leechers": {
        "text": "1"
      },
      "downloadvolumefactor": {
        "text": "0"
      },
      "uploadvolumefactor": {
        "text": "1"
      }
    }
  },
  "download": {
    "selectors": [
      {
        "selector": "a.wp-block-button__link",
        "attribute": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "file"
            ]
          }
        ]
      }
    ]
  },
  "source": {
    "path": "definitions/v11/vsttorrents.yml",
    "sha256": "6b241e8cb5ce0e136367a503d68a1e59b6a9600162f3779cdaf799a5ef1bac26",
    "modified": "converted by streamline's internal/cardigann/convert: YAML to JSON; .NET regexes, substitutions, date layouts and template string literals rewritten for Go"
  }
}
