            "args": [
              "(?i)(Decima Temporada)",
              "S10"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)(Onceava Temporada)",
              "S11"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)(Decimosegunda Temporada)",
              "S12"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)Temporada (\\p{Nd}{1,3})[\\t-\\r\\x{85}\\p{Z}]*y[\\t-\\r\\x{85}\\p{Z}]*(\\p{Nd}{1,3})",
              "S${1}-${2}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)Temporada (\\p{Nd}{1,3})",
              "S${1}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "^(\\[ARG\\]) (.+?)$",
              "$2 $1"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "^(\\[.+?\\]) (.+?)$",
              "$2 $1"
            ],
            "engine": "regexp2"
          },
          {
            "name": "prepend",
            "args": [
              "{{ if .Result.download }}{{ else }}*NUKEADO* {{ end }}"
            ]
          }
        ]
      },
      "details": {
        "selector": "a[href^=\"details.php?id=\"]",
        "attribute": "href"
      },
      "date": {
        "selector": "td:nth-child(5)",
        "remove": "font",
        "filters": [
          {
            "name": "append",
            "args": [
              " +00:00"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "2006-01-02 -07:00",
              "2006-01-02 -0700"
            ]
          }
        ]
      },
      "size": {
        "selector": "td:nth-child(3)"
      },
      "seeders": {
        "selector": "td:nth-child(8)",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "^(\\p{Nd}+) /"
            ]
          }
        ]
      },
      "leechers": {
        "selector": "td:nth-child(8)",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "/ (\\d+)$"
            ],
            "engine": "regexp2"
          }
        ]
      },
      "grabs": {
        "selector": "td:nth-child(9)",
        "filters": [
          {
            "name": "regexp",
            "args": [
              " (\\p{Nd}+) "
            ]
          }
        ]
      },
      "downloadvolumefactor": {
        "case": {
          "font[color=\"red\"]:contains(\"FREE!\")": "0",
          "*": "1"
        }
      },
      "uploadvolumefactor": {
        "text": "1"
      },
      "minimumratio": {
        "text": "0.5"
      },
      "description_default": {
        "selector": "a[href^=\"details.php?id=\"]"
      },
      "description": {
        "selector": "a[title][href^=\"details.php?id=\"]",
        "attribute": "title",
        "optional": true,
        "default": "{{ .Result.description_default }}"
      }
    }
  },
