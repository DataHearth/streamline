{
  "id": "vc-lib",
  "name": "VC-Lib",
  "description": "VC-Lib is a CHINESE Private Torrent Tracker for MUSIC",
  "language": "zh-CN",
  "type": "private",
  "encoding": "UTF-8",
  "links": [
    "https://pt.vclib.online/"
  ],
  "caps": {
    "categorymappings": [
      {
        "id": "408",
        "cat": "Other",
        "desc": "其他 - Other"
      },
      {
        "id": "409",
        "cat": "PC/0day",
        "desc": "软件 - Software"
      },
      {
        "id": "407",
        "cat": "PC/Games",
        "desc": "游戏 - Games"
      },
      {
        "id": "406",
        "cat": "PC/0day",
        "desc": "编辑器 - Editors"
      },
      {
        "id": "403",
        "cat": "Other",
        "desc": "声库 - Voicebanks"
      },
      {
        "id": "402",
        "cat": "Audio/Video",
        "desc": "视频 - Videos"
      },
      {
        "id": "405",
        "cat": "Other",
        "desc": "图片 - Images"
      },
      {
        "id": "404",
        "cat": "Audio",
        "desc": "单曲 - Singles"
      },
      {
        "id": "401",
        "cat": "Audio",
        "desc": "专辑 - Albums"
      }
    ],
    "modes": {
      "search": [
        "q"
      ],
      "music-search": [
        "q"
      ]
    }
  },
  "settings": [
    {
      "name": "cookie",
      "label": "Cookie",
      "type": "text",
      "secret": true
    },
    {
      "name": "info_cookie",
      "type": "info_cookie"
    },
    {
      "name": "freeleech",
      "label": "Search freeleech only",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "sort",
      "label": "Sort requested from site",
      "type": "select",
      "default": "4",
      "options": {
        "4": "created",
        "7": "seeders",
        "5": "size",
        "1": "title"
      }
    },
    {
      "name": "type",
      "label": "Order requested from site",
      "type": "select",
      "default": "desc",
      "options": {
        "desc": "desc",
        "asc": "asc"
      }
    },
    {
      "name": "info_tpp",
      "label": "Results Per Page",
      "type": "info",
      "default": "For best results, change the <b>Torrents per page:</b> setting to <b>100</b> on your account profile."
    },
    {
      "name": "info_activity",
      "label": "Account Inactivity",
      "type": "info",
      "default": "If you don't log in to Vclib for 365 days, the system will automatically ban you (not just doing it, you have to actually log in)."
    }
  ],
  "login": {
    "method": "cookie",
    "inputs": {
      "cookie": "{{ .Config.cookie }}"
    },
    "test": {
      "path": "index.php",
      "selector": "a[href=\"logout.php\"]"
    }
  },
  "search": {
    "paths": [
      {
        "path": "torrents.php"
      }
    ],
    "inputs": {
      "$raw": "{{ range .Categories }}cat{{.}}=1&{{end}}",
      "search": "{{ .Keywords }}",
      "incldead": "0",
      "spstate": "{{ if .Config.freeleech }}2{{ else }}0{{ end }}",
      "search_area": "0",
      "search_mode": "0",
      "sort": "{{ .Config.sort }}",
      "type": "{{ .Config.type }}",
      "notnewword": "1"
    },
    "rows": {
      "selector": "table.torrents > tbody > tr:has(a[href*=\"download.php?id=\"])"
    },
    "fields": {
      "category": {
        "selector": "a[href*=\"?cat=\"]",
        "attribute": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "cat"
            ]
          }
        ]
      },
      "title_default": {
        "selector": "a[href*=\"details.php?id=\"]"
      },
      "title": {
        "selector": "a[title][href*=\"details.php?id=\"]",
        "attribute": "title",
        "optional": true,
        "default": "{{ .Result.title_default }}"
      },
      "details": {
        "selector": "a[href*=\"details.php?id=\"]",
        "attribute": "href"
      },
      "download": {
        "selector": "a[href*=\"download.php?id=\"]",
        "attribute": "href"
      },
      "poster": {
        "selector": "img[data-src]",
        "attribute": "data-src"
      },
      "date_elapsed": {
        "selector": "td.rowfollow:nth-child(4) > span[title]",
        "attribute": "title",
        "optional": true,
        "filters": [
          {
            "name": "append",
            "args": [
              " +08:00"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "2006-01-02 15:04:05 -07:00",
              "2006-01-02 15:04:05 -0700"
            ]
          }
        ]
      },
      "date_added": {
        "selector": "td.rowfollow:nth-child(4):not(:has(span))",
        "optional": true,
        "filters": [
          {
            "name": "append",
            "args": [
              " +08:00"
            ]
          },
          {
            "name": "dateparse",
            "args": [
              "2006-01-0215:04:05 -07:00",
              "2006-01-0215:04:05 -0700"
            ]
          }
        ]
      },
      "date": {
        "text": "{{ if or .Result.date_elapsed .Result.date_added }}{{ or .Result.date_elapsed .Result.date_added }}{{ else }}now{{ end }}"
      },
      "size": {
        "selector": "td.rowfollow:nth-child(5)"
      },
      "seeders": {
        "selector": "td.rowfollow:nth-child(6)"
      },
      "leechers": {
        "selector": "td.rowfollow:nth-child(7)"
      },
      "grabs": {
        "selector": "td.rowfollow:nth-child(8)"
      },
      "downloadvolumefactor": {
        "case": {
          "img.pro_free": "0",
          "img.pro_free2up": "0",
          "img.pro_50pctdown": "0.5",
          "img.pro_50pctdown2up": "0.5",
          "img.pro_30pctdown": "0.3",
          "*": "1"
        }
      },
      "uploadvolumefactor": {
        "case": {
          "img.pro_50pctdown2up": "2",
          "img.pro_free2up": "2",
          "img.pro_2up": "2",
          "*": "1"
        }
      },
      "minimumratio": {
        "text": "0.8"
      },
      "description": {
        "selector": "td.rowfollow:nth-child(2)",
        "remove": "a, b, font, img, span"
      }
    }
  },
  "source": {
    "path": "definitions/v11/vc-lib.yml",
    "sha256": "61fd26c30ee4bf170d32e26b9f37e02bb5414bd72efc2ebb3103e7d434dd104d",
    "modified": "converted by streamline's internal/cardigann/convert: YAML to JSON; .NET regexes, substitutions, date layouts and template string literals rewritten for Go"
  }
}
