{
  "id": "torrentdownloads",
  "name": "Torrent Downloads",
  "description": "Torrent Downloads (TD) is a Public torrent site for all kinds of content",
  "language": "en-US",
  "type": "public",
  "encoding": "UTF-8",
  "links": [
    "https://www.torrentdownloads.pro/",
    "https://torrentdownloads.ninjaproxy1.com/",
    "https://torrentdownloads.proxyninja.org/"
  ],
  "legacylinks": [
    "https://www.torrentdownloads.me/",
    "https://www.torrentdownloads.info/",
    "https://torrentdownloads.mrunblock.bond/",
    "https://torrentdownloads.nocensor.cloud/",
    "https://torrentdownloads.unblockit.download/",
    "https://torrentdownloads.unblockninja.com/",
    "https://torrentdownloads.proxyninja.net/"
  ],
  "caps": {
    "categorymappings": [
      {
        "id": "8",
        "cat": "TV",
        "desc": "TV Shows"
      },
      {
        "id": "4",
        "cat": "Movies",
        "desc": "Movies"
      },
      {
        "id": "5",
        "cat": "Audio",
        "desc": "Music"
      },
      {
        "id": "3",
        "cat": "PC/Games",
        "desc": "Games"
      },
      {
        "id": "7",
        "cat": "PC",
        "desc": "Software"
      },
      {
        "id": "1",
        "cat": "TV/Anime",
        "desc": "Anime"
      },
      {
        "id": "2",
        "cat": "Books",
        "desc": "Books"
      },
      {
        "id": "9",
        "cat": "Other",
        "desc": "Other"
      },
      {
        "id": "0",
        "cat": "Other",
        "desc": "Other"
      },
      {
        "id": "6",
        "cat": "Other",
        "desc": "Pics"
      }
    ],
    "modes": {
      "search": [
        "q"
      ],
      "tv-search": [
        "q",
        "season",
        "ep"
      ],
      "movie-search": [
        "q"
      ],
      "music-search": [
        "q"
      ],
      "book-search": [
        "q"
      ]
    },
    "allowrawsearch": true
  },
  "settings": [
    {
      "name": "primarydownloadlink",
      "label": "Primary Download link",
      "type": "select",
      "default": "magnet:",
      "options": {
        "//itorrents.": "iTorrents",
        "magnet:": "magnet"
      }
    },
    {
      "name": "fallbackdownloadlink",
      "label": "Fallback Download link",
      "type": "select",
      "default": "//itorrents.",
      "options": {
        "//itorrents.": "iTorrents",
        "magnet:": "magnet"
      }
    },
    {
      "name": "info_download",
      "label": "About the Download links",
      "type": "info",
      "default": "As the .torrent download links on this site are known to fail from time to time, you can optionally set as a fallback an automatic alternate link."
    }
  ],
  "search": {
    "paths": [
      {
        "path": "search/",
        "followredirect": true
      }
    ],
    "inputs": {
      "$raw": "{{ range .Categories }}s_cat={{.}}&{{end}}",
      "search": "{{ if .Keywords }}{{ .Keywords }}{{ else }}{{ .Today.Year }}{{ end }}"
    },
    "keywordsfilters": [
      {
        "name": "re_replace",
        "args": [
          "[^\\p{L}\\p{Mn}\\p{Nd}\\p{Pc}]+",
          " "
        ]
      },
      {
        "name": "trim"
      }
    ],
    "rows": {
      "selector": "div.inner_container > div:has(p:has(a[href^=\"/torrent/\"])):not(:has(span.__cf_email__))"
    },
    "fields": {
      "category": {
        "selector": "img[src^=\"/templates/new/images/icons/menu_icon\"]",
        "attribute": "src",
        "filters": [
          {
            "name": "regexp",
            "args": [
              "(\\p{Nd}+)"
            ]
          }
        ]
      },
      "title": {
        "selector": "p:nth-child(1) > a",
        "attribute": "title",
        "filters": [
          {
            "name": "replace",
            "args": [
              "View torrent info : ",
              ""
            ]
          }
        ]
      },
      "details": {
        "selector": "p:nth-child(1) > a[href^=\"/torrent/\"]",
        "attribute": "href"
      },
      "download": {
        "selector": "p:nth-child(1) > a[href^=\"/torrent/\"]",
        "attribute": "href"
      },
      "date": {
        "text": "now"
      },
      "size": {
        "selector": "span:nth-child(5)"
      },
      "seeders": {
        "selector": "span:nth-child(4)"
      },
      "leechers": {
        "selector": "span:nth-child(3)"
      },
      "downloadvolumefactor": {
        "text": "0"
      },
      "uploadvolumefactor": {
        "text": "1"
      }
    }
  },
  "download": {
    "selectors": [
      {
        "selector": "a[href*=\"{{ .Config.primarydownloadlink }}\"]",
        "attribute": "href"
      },
      {
        "selector": "a[href*=\"{{ .Config.fallbackdownloadlink }}\"]",
        "attribute": "href"
      }
    ]
  },
  "source": {
    "path": "definitions/v11/torrentdownloads.yml",
    "sha256": "8cbb78b5fe8493ac2bab433050c88e514a412e0c953a64663d195eff262aa933",
    "modified": "converted by streamline's internal/cardigann/convert: YAML to JSON; .NET regexes, substitutions, date layouts and template string literals rewritten for Go"
  }
}
