  "settings": [
    {
      "name": "username",
      "label": "Username",
      "type": "text"
    },
    {
      "name": "password",
      "label": "Password",
      "type": "password",
      "secret": true
    },
    {
      "name": "pin",
      "label": "Pin",
      "type": "text",
      "secret": true
    },
    {
      "name": "freeleech",
      "label": "Search FreeLeech",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "onlyupload",
      "label": "Search OnlyUpload",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "info_free",
      "label": "About Freeleech and OnlyUpload at World-of-Tomorrow",
      "type": "info",
      "default": "<ul><li>FreeLeech are torrents where neither the download or upload is counted.</li><li>OnlyUpload are torrents where download is not counted but upload is. Good for building your Ratio up.</li></ul>"
    },
    {
      "name": "sortby",
      "label": "Sort requested from site",
      "type": "select",
      "default": "added",
      "options": {
        "added": "created",
        "seeders": "seeders",
        "size": "size",
        "name": "title"
      }
    },
    {
      "name": "typeby",
      "label": "Order requested from site",
      "type": "select",
      "default": "DESC",
      "options": {
        "DESC": "desc",
        "ASC": "asc"
      }
    },
    {
      "name": "info_activity",
      "label": "Account Inactivity",
      "type": "info",
      "default": "All accounts up to platinum users that are inactive for more than 8 weeks will be deleted!"
    }
  ],
  "login": {
    "method": "post",
    "path": "takelogin.php",
    "inputs": {
      "username": "{{ .Config.username }}",
      "password": "{{ .Config.password }}",
      "pin": "{{ .Config.pin }}",
      "remember": "1"
    },
    "error": [
      {
        "selector": "div#loginStatus"
      }
    ],
    "test": {
      "path": "index.php",
      "selector": "a[href=\"logout.php\"], title:contains(\"APRILSCHERZ\")"
    }
  },
  "search": {
    "paths": [
      {
        "path": "search_query.php",
        "method": "post"
      }
    ],
    "inputs": {
      "name": "{{ if .Query.IMDBID }}{{ .Query.IMDBID }}{{ else }}{{ .Keywords }}{{ end }}",
      "$raw": "{{ range .Categories }}&categories[]={{.}}{{end}}",
      "searchMethod": "wildcard",
      "maxAge": "added",
      "sortBy": "{{ .Config.sortby }}",
      "sortByType": "{{ .Config.typeby }}",
      "myTorrents": "no",
      "highlight": "no",
      "onlyupload": "{{ if .Config.onlyupload }}yes{{ else }}no{{ end }}",
      "freeleech": "{{ if .Config.freeleech }}yes{{ else }}no{{ end }}",
      "offset": "0",
      "limit": "100"
    },
    "rows": {
      "selector": "div.sr-card, div.sr-dup-item",
      "filters": [
        {
          "name": "andmatch"
        }
      ]
    },
    "fields": {
      "categorydesc": {
        "selector": "div.sr-badge-cat, div.sr-dup-meta span:nth-child(5)",
        "remove": "span.sr-badge-lang",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "(?i)^(Filme|Serien|Musik|Audio|Spiele|Games|Apps|Software|Sonstiges)[\\t-\\r\\x{85}\\p{Z}]+",
              ""
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "\\s*\\[[^\\]]+\\]\\s*$",
              ""
            ],
            "engine": "regexp2"
          },
          {
            "name": "trim"
          }
        ]
      },
      "title": {
        "selector": "div.sr-title-row a[href^=\"torrent.php?id=\"], a.sr-dup-title"
      },
      "details": {
        "selector": "div.sr-title-row a[href^=\"torrent.php?id=\"], a.sr-dup-title",
        "attribute": "href"
      },
      "download": {
        "selector": "input[data-url^=\"download.php?torrent=\"]",
        "attribute": "data-url"
      },
      "poster": {
        "selector": "div.sr-cover img",
        "attribute": "src"
      },
      "imdbid": {
        "selector": "a.sr-link-badge[href*=\"imdb.com\"]",
        "attribute": "href"
      },
      "size": {
        "selector": "span.sr-detail-size, div.sr-dup-meta span:nth-child(1)"
      },
      "grabs": {
        "selector": "span.sr-detail-dl",
        "optional": true
      },
      "seeders": {
        "selector": "span.sr-detail-seed, div.sr-dup-meta span:nth-child(2)"
      },
      "leechers": {
        "selector": "span.sr-detail-leech, div.sr-dup-meta span:nth-child(3)"
      },
      "date": {
        "selector": "span.sr-detail-time, div.sr-dup-meta span:nth-child(4)",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "(?i)^\\s*vor\\s+(.+)$",
              "$1 ago"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\bund\\b",
              ""
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\bSekunde(n)?\\b",
              "seconds"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\bMinute(n)?\\b",
              "minutes"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\bStunde(n)?\\b",
              "hours"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\bTag(e|en)?\\b",
              "days"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\bWoche(n)?\\b",
              "weeks"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\bMonat(e|en)?\\b",
              "months"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "(?i)\\bJahr(e|en)?\\b",
              "years"
            ],
            "engine": "regexp2"
          },
          {
            "name": "trim"
          },
          {
            "name": "timeago"
          }
        ]
      },
      "downloadvolumefactor": {
        "case": {
          "span.sr-status-onlyupload": "0",
          "*": "1"
        }
      },
      "uploadvolumefactor": {
        "case": {
          "span.sr-status-freeleech": "0",
          "*": "1"
        }
      },
      "minimumratio": {
        "text": "0.7"
      },
      "minimumseedtime": {
        "text": "259200"
      }
    }
  },
