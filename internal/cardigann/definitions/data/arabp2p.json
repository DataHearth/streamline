  "settings": [
    {
      "name": "username",
      "label": "Username",
      "type": "text"
    },
    {
      "name": "password",
      "label": "Password",
      "type": "password",
      "secret": true
    },
    {
      "name": "sort",
      "label": "Sort requested from site",
      "type": "select",
      "default": "3",
      "options": {
        "3": "created",
        "5": "seeders",
        "4": "size",
        "2": "title"
      }
    },
    {
      "name": "type",
      "label": "Order requested from site",
      "type": "select",
      "default": "2",
      "options": {
        "2": "desc",
        "1": "asc"
      }
    },
    {
      "name": "info_activity",
      "label": "Account Inactivity",
      "type": "info",
      "default": "You must log in periodically. If the member is absent from the website for a period of 3 months, the account will be deleted without prior warning."
    }
  ],
  "login": {
    "method": "form",
    "path": "index.php",
    "form": "form[action^=\"index.php?page=login\"]",
    "inputs": {
      "uid": "{{ .Config.username }}",
      "pwd": "{{ .Config.password }}"
    },
    "error": [
      {
        "selector": "tr td span[style=\"color:#FF0000;\"]"
      }
    ],
    "test": {
      "path": "index.php",
      "selector": "a[href^=\"logout.php?t=\"]"
    }
  },
  "search": {
    "paths": [
      {
        "path": "index.php"
      }
    ],
    "inputs": {
      "page": "torrents",
      "search": "{{ .Keywords }}",
      "category": "0",
      "active": "0",
      "internel": "0",
      "order": "{{ .Config.sort }}",
      "by": "{{ .Config.type }}"
    },
    "keywordsfilters": [
      {
        "name": "re_replace",
        "args": [
          "(?i)\\b(\\d{1,2})x(\\d{1,3})\\b",
          "S$1E$2"
        ],
        "engine": "regexp2"
      },
      {
        "name": "re_replace",
        "args": [
          "(?i)\\bS(\\d{1,2})\\s+E(\\d{1,3})\\b",
          "S$1E$2"
        ],
        "engine": "regexp2"
      },
      {
        "name": "re_replace",
        "args": [
          "(?i)\\bS(\\d)(?=E)",
          "S0$1"
        ],
        "engine": "regexp2"
      },
      {
        "name": "re_replace",
        "args": [
          "(?i)E(\\d)\\b",
          "E0$1"
        ],
        "engine": "regexp2"
      },
      {
        "name": "re_replace",
        "args": [
          "[\\t-\\r\\x{85}\\p{Z}]{2,}",
          " "
        ]
      },
      {
        "name": "trim"
      }
    ],
    "rows": {
      "selector": "table#torrents_list_p > tbody > tr:has(a[href^=\"download.php?id=\"]), table#torrents_list_p > tbody > tr:has(a[href^=\"magnet:?xt=\"])",
      "filters": [
        {
          "name": "andmatch"
        }
      ]
    },
    "fields": {
      "category": {
        "selector": "a[href^=\"index.php?page=torrents&category=\"]:last-child",
        "attribute": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "category"
            ]
          }
        ]
      },
      "title": {
        "selector": "a[href^=\"index.php?page=torrent-details\"]",
        "filters": [
          {
            "name": "re_replace",
            "args": [
              "(?<=\\d)\\s+(?=\\d)",
              " "
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "\\[(\\p{Nd}+(?:[\\t-\\r\\x{85}\\p{Z}-]+\\p{Nd}+)*)\\][\\t-\\r\\x{85}\\p{Z}]*\\[(\\p{Nd}{4})\\][\\t-\\r\\x{85}\\p{Z}]*\\[م(\\p{Nd}+)\\]",
              "S${3}E${1} [${2}]"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "\\[(\\p{Nd}+(?:[\\t-\\r\\x{85}\\p{Z}-]+\\p{Nd}+)*)\\][\\t-\\r\\x{85}\\p{Z}]*\\[م(\\p{Nd}+)\\]",
              "S${2}E${1}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "\\[(E\\p{Nd}+(?:[\\t-\\r\\x{85}\\p{Z}-]+E\\p{Nd}+)?)\\][\\t-\\r\\x{85}\\p{Z}]*\\[(S\\p{Nd}+)\\]",
              "${2}${1}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "\\[(S\\p{Nd}+)\\][\\t-\\r\\x{85}\\p{Z}]*\\[(E\\p{Nd}+(?:[\\t-\\r\\x{85}\\p{Z}-]+E\\p{Nd}+)?)\\]",
              "${1}${2}"
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "^\\[(\\d+(?:[\\s-]+\\d+)*)\\](?!\\s*\\[م)",
              "S01E$1"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "E(\\d+)[\\s-]+(\\d+)\\b",
              "E$1-E$2"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "\\[[\\t-\\r\\x{85}\\p{Z}]*\\]",
              ""
            ]
          },
          {
            "name": "re_replace",
            "args": [
              "(?<=\\S)(\\[)",
              " $1"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "S(\\d)(?=E)",
              "S0$1"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "E(\\d)(?=\\D)",
              "E0$1"
            ],
            "engine": "regexp2"
          },
          {
            "name": "re_replace",
            "args": [
              "[\\t-\\r\\x{85}\\p{Z}]{2,}",
              " "
            ]
          },
          {
            "name": "trim"
          }
        ]
      },
      "details": {
        "selector": "a[href^=\"index.php?page=torrent-details\"]",
        "attribute": "href"
      },
      "download": {
        "selector": "a[href^=\"download.php?id=\"]",
        "attribute": "href",
        "optional": true
      },
      "magnet": {
        "selector": "a[href^=\"magnet:?xt=\"]",
        "attribute": "href",
        "optional": true
      },
      "poster": {
        "selector": "a.screenshot",
        "attribute": "rel",
        "optional": true
      },
      "date": {
        "selector": "span.upload-date > span",
        "attribute": "title",
        "filters": [
          {
            "name": "dateparse",
            "args": [
              "06-01-02 03:04:05 PM",
              "06-01-02 03:04:05 pm"
            ]
          }
        ]
      },
      "size": {
        "selector": "span.size"
      },
      "seeders": {
        "selector": "span[title=\"Seeders\"]"
      },
      "leechers": {
        "selector": "span[title=\"Leechers\"]"
      },
      "downloadvolumefactor": {
        "case": {
          "span.free": "0",
          "*": "1"
        }
      },
      "uploadvolumefactor": {
        "text": "1"
      },
      "minimumratio": {
        "text": "0.8"
      },
      "minimumseedtime": {
        "text": "259200"
      }
    }
  },
