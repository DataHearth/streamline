      "prev_dc": "0",
      "prev_df": "1",
      "prev_ds": "0",
      "prev_tor_type": "0",
      "o": "{{ .Config.sort }}",
      "s": "{{ .Config.type }}",
      "dc": "0",
      "df": "1",
      "da": "1",
      "ds": "0",
      "tm": "-1",
      "sns": "-1",
      "srg": "-1",
      "nm": "{{ .Keywords }}",
      "allw": "1"
